<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KML Resort | Nature Needs Space</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/jpeg" sizes="32x32" href="img/logo.jpg">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/dashboard.css">
</head>
<body>

    <!-- HEADER -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link" href="/booking">BOOKING</a></li>
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input invisible" placeholder="Search">
                        <a href="/booking" class="btn book-btn">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- HERO SECTION -->
    <main>
        <section class="hero">
            <div class="container-fluid py-4 py-lg-5">
                <div class="row align-items-center g-4 g-lg-5 max-width-container">
                    
                    <!-- LEFT: Hero Text Content -->
                    <div class="col-lg-6 hero-text">
                        <h1 class="display-2 fw-bold mb-3 mb-lg-4">
                            BREATHE. <br>
                            <span class="text-gradient">RELAX. UNWIND.</span>
                        </h1>

                        <p class="lead text-muted mb-3 mb-lg-4">
                            KML Mountain Resort is an exclusive sanctuary designed for those who seek precise navigation to tranquility.
                            Experience the seamless blend of digital convenience and secluded luxury.
                        </p>

                        <!-- RESORT INFO BANNER -->
                        <div class="resort-info-banner mb-3 mb-lg-4">
                            <div class="info-card">
                                <!-- Hours -->
                                <div class="info-item">
                                    <div class="info-icon info-icon-blue">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                                        </svg>
                                    </div>
                                    <div class="info-text">
                                        <small class="info-label">Open Hours</small>
                                        <span class="info-value">Wed–Fri: 9AM–5PM</span>
                                        <span class="info-divider-dot">•</span>
                                        <span class="info-value">Sat–Sun: 8AM–6PM</span>
                                    </div>
                                </div>

                                <!-- Fee -->
                                <div class="info-item">
                                    <div class="info-icon info-icon-green">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1H0V4zm0 3v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7H0zm7 4a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm2-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm2 1a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                                        </svg>
                                    </div>
                                    <div class="info-text">
                                        <small class="info-label">Entrance Fee</small>
                                        <span class="info-value fw-bold">₱30.00</span>
                                        <small class="info-suffix">/ person</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-3 hero-btns"> 
                            <a href="/location" class="btn btn-primary btn-lg btn-primary-custom">Navigate to Resort</a>
                            <a href="/accomodation" class="btn btn-outline-primary btn-lg btn-secondary-custom">View Accommodation</a>
                        </div>
                    </div>
                    <!-- End Hero Text -->

                    <!-- RIGHT: Entrance Image -->
                    <div class="col-lg-6 hero-image-col">
                        <div class="hero-entrance-wrapper">
                            <img src="/img/dassshboard.jpg" alt="KML Mountain Resort Entrance" class="hero-entrance-img">
                        </div>
                    </div>
                    <!-- End Entrance Image -->

                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>