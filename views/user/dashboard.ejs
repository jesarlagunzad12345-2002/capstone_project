<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KML Resort | Nature Needs Space</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/jpeg" sizes="32x32" href="img/logo.jpg">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/dashboard.css">
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="/dashboard">HOME</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/location">LOCATION</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/accomodation">ACCOMMODATION</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/experience">EXPERIENCE</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/gallery">GALLERY</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/amenities">AMENITIES</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/booking">BOOKING</a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input invisible" placeholder="Search">
                        <a href="/booking" class="btn book-btn">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <main class="container-fluid py-5">
        <div class="row align-items-center g-5 max-width-container">
            <section class="col-lg-6 hero-text">
                <h1 class="display-2 fw-bold mb-4">
                    NATURE <br>
                    <span class="text-gradient">NEEDS SPACE</span>
                </h1>

                <p class="lead text-muted mb-4">
                    KML Mountain Resort is an exclusive sanctuary designed for those who seek precise navigation to tranquility.
                    Experience the seamless blend of digital convenience and secluded luxury.
                </p>

                <div class="d-flex flex-wrap gap-3 hero-btns"> 
                    <a href="/location" class="btn btn-primary btn-lg btn-primary-custom">Navigate to Resort</a>
                    <a href="/accomodation" class="btn btn-outline-primary btn-lg btn-secondary-custom">View Accommodation</a>
                </div>
            </section>

            <section class="col-lg-6 hero-image">
                <img src="images/mountain-stars.jpg" alt="Mountain under starry sky" class="img-fluid rounded-4 shadow-lg">
            </section>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>