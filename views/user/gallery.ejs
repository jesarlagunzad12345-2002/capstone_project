<!-- gallery.ejs - Connected to Food Popularity from food.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery | KML Mountain Resort</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/gallery.css">
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link" href="/booking">BOOKING</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input" placeholder="Search images..." id="gallerySearch" onkeyup="searchGallery()">
                        <a href="/booking" class="btn book-btn">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid py-5">
        <h1 class="text-center display-3 fw-bold mb-5">GALLERY</h1>
        
        <section class="d-flex justify-content-center flex-wrap gap-3 mb-5" id="galleryFilters">
            <button class="btn filter-btn active" onclick="filterGallery('all')">All</button>
            <button class="btn filter-btn" onclick="filterGallery('rooms')">Rooms & Cottages</button>
            <button class="btn filter-btn" onclick="filterGallery('mountain')">Mountain Views</button>
            <button class="btn filter-btn" onclick="filterGallery('dining')">Dining</button>
        </section>

        <section class="container">
            <div class="row g-4" id="galleryContainer">
            </div>
        </section>
    </main>

    <div class="modal fade" id="roomDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 modal-gallery">
                <div class="row g-0">
                    <div class="col-md-6 position-relative">
                        <img id="modalRoomImage" src="" class="img-fluid h-100" style="object-fit: cover; min-height: 300px;">
                        <span id="modalRoomStatus" class="room-status-badge modal-status">Available</span>
                    </div>
                    <div class="col-md-6 p-4 d-flex flex-column justify-content-center">
                        <h3 class="fw-bold mb-2" id="modalRoomName">Room Name</h3>
                        <span class="badge bg-primary mb-3 align-self-start" id="modalRoomCategory">Category</span>
                        <div class="mb-3">
                            <h5 class="text-primary fw-bold mb-1">₱<span id="modalRoomPrice">0</span><small class="text-muted">/night</small></h5>
                            <p class="text-muted mb-0"><i class="bi bi-people-fill me-1"></i> Up to <span id="modalRoomOccupancy">2</span> guests</p>
                        </div>
                        <p class="text-muted mb-4">Experience luxury and comfort in this beautifully appointed room with stunning views and premium amenities.</p>
                        <div class="d-flex gap-2">
                            <a id="modalBookBtn" href="#" class="btn btn-primary flex-grow-1 fw-bold">Book Now</a>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="foodDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 modal-gallery">
                <div class="row g-0">
                    <div class="col-md-6 position-relative">
                        <img id="modalFoodImage" src="" class="img-fluid h-100" style="object-fit: cover; min-height: 300px;">
                        <span id="modalFoodPopularity" class="popularity-badge modal-popularity">POPULAR</span>
                    </div>
                    <div class="col-md-6 p-4 d-flex flex-column justify-content-center">
                        <h3 class="fw-bold mb-2" id="modalFoodName">Food Name</h3>
                        <span class="badge bg-warning mb-3 align-self-start" id="modalFoodCategory">Category</span>
                        <div class="mb-3">
                            <h5 class="text-primary fw-bold mb-1">₱<span id="modalFoodPrice">0</span></h5>
                            <p class="text-muted mb-0" id="modalFoodStockDetail"><i class="bi bi-box-seam me-1"></i> Available</p>
                        </div>
                        <p class="text-muted mb-4" id="modalFoodDescription">Description goes here.</p>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center py-4 mt-5">
        <p class="mb-0">&copy; 2026 KML Mountain Resort. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/gallery.js"></script>
</body>
</html>