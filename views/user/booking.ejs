        // Send verification code to email
        async function sendVerificationCode() {
            const emailInput = document.getElementById('email');
            const email = emailInput.value.trim();
            const btn = document.getElementById('sendCodeBtn');
            const status = document.getElementById('emailStatus');

            // Check if email looks valid
            if (!email || !email.includes('@') || !email.includes('.')) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Please enter a valid email address.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...';

            try {
                // Ask server to generate a code
                const res = await fetch('/api/request-verification-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const data = await res.json();

                if (!data.success) {
                    status.innerHTML = `<span class="text-danger">${data.message}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
                    return;
                }

                console.log("✅ Server generated code:", data.code);

                // Send the code via EmailJS
                await emailjs.send('service_p0pcn2h', 'template_i8uz2wj', {
                    email: email,
                    verification_code: data.code,
                    user_name: document.getElementById('name').value || 'Guest'
                });

                // Show the code input field
                document.getElementById('codeSection').style.display = 'block';
                status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Code sent! Check your inbox (and spam folder).</span>';

                // Start 60-second countdown for resend
                let seconds = 60;
                btn.innerHTML = `Resend (${seconds}s)`;
                const timer = setInterval(() => {
                    seconds--;
                    if (seconds > 0) {
                        btn.innerHTML = `Resend (${seconds}s)`;
                    } else {
                        clearInterval(timer);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-send me-1"></i> Resend Code';
                    }
                }, 1000);

            } catch (err) {
                console.error('EmailJS Error:', err);
                status.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Failed to send email. Please try again.</span>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
            }
        }

        // Check if the code user entered is correct
        async function verifyCode() {
            const email = document.getElementById('email').value.trim();
            const code = document.getElementById('verificationCodeInput').value.trim();
            const btn = document.getElementById('verifyBtn');
            const status = document.getElementById('codeStatus');

            // Code must be 6 digits
            if (!code || code.length !== 6 || isNaN(code)) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Please enter the 6-digit code.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking...';

            try {
                // Send code to server to verify
                const res = await fetch('/api/verify-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, code: code })
                });
                const data = await res.json();

                if (data.success) {
                    // VERIFIED! Update everything
                    document.getElementById('emailVerified').value = 'true';
                    document.getElementById('email').readOnly = true;
                    document.getElementById('codeSection').style.display = 'none';
                    document.getElementById('sendCodeBtn').style.display = 'none';

                    // Show the green verified banner
                    document.getElementById('verifiedBanner').style.display = 'block';

                    status.innerHTML = '<span class="text-success"><i class="bi bi-shield-check me-1"></i>Email verified! You can now complete your booking.</span>';
                    document.getElementById('email').classList.add('is-valid');

                    // Unlock the submit button so user can book
                    unlockSubmitButton();

                } else {
                    // Wrong code
                    status.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>${data.message}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Verify';
                }
            } catch (err) {
                console.error('❌ Verify error:', err);
                status.innerHTML = '<span class="text-danger">Server error. Please refresh and try again.</span>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Verify';
            }
        }

        // ============================================
        // BOOKING LOGIC
        // ============================================

        function timeToMinutes(timeStr) {
            if (!timeStr) return 0;
            const [h, m] = timeStr.split(':').map(Number);
            return (h * 60) + m;
        }

        function isMondayOrTuesday(dateString) {
            if (!dateString) return false;
            const [year, month, day] = dateString.split('-').map(Number);
            const date = new Date(year, month - 1, day);
            const dayOfWeek = date.getDay();
            return dayOfWeek === 1 || dayOfWeek === 2;
        }

        function getNextValidDate(fromDateStr) {
            const [year, month, day] = fromDateStr.split('-').map(Number);
            const date = new Date(year, month - 1, day);
            while (true) {
                const dayOfWeek = date.getDay();
                if (dayOfWeek !== 1 && dayOfWeek !== 2) break;
                date.setDate(date.getDate() + 1);
            }
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function getAutoCheckout(checkinStr) {
            const [year, month, day] = checkinStr.split('-').map(Number);
            const date = new Date(year, month - 1, day);
            date.setDate(date.getDate() + 1);
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        const today = new Date().toISOString().split('T')[0];
        const validToday = getNextValidDate(today);

        document.getElementById('checkin').min = validToday;
        document.getElementById('bookingDate').min = validToday;
        document.getElementById('bookingDate').value = validToday;

        document.getElementById('checkin').addEventListener('change', function() {
            if (isMondayOrTuesday(this.value)) {
                this.value = '';
                showBlockedAlert('Check-in cannot be on Monday or Tuesday. We are closed those days.');
                return;
            }
        });

        document.getElementById('bookingDate').addEventListener('change', function() {
            if (isMondayOrTuesday(this.value)) {
                this.value = '';
                showBlockedAlert('Booking cannot be on Monday or Tuesday. We are closed those days.');
            }
        });

        function showBlockedAlert(msg) {
            const alert = document.getElementById('blockedDayAlert');
            const message = document.getElementById('blockedDayMessage');
            message.textContent = msg;
            alert.style.display = 'block';
            setTimeout(() => { alert.style.display = 'none'; }, 4000);
        }

        function validateAndCalculate() {
            document.getElementById('blockedDayAlert').style.display = 'none';
            calculateTotal();
        }

        function onRoomTypeChange() {
            const roomSelect = document.getElementById('roomType');
            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const category = selectedOption.getAttribute('data-category') || 'Room';
            const isCottage = (category === 'Cottage');
            const peopleInput = document.getElementById('people');
            const maxOccupancy = parseInt(selectedOption.getAttribute('data-occupancy'), 10) || 1;

            document.getElementById('roomDateFields').style.display = isCottage ? 'none' : 'flex';
            document.getElementById('cottageFields').style.display = isCottage ? 'flex' : 'none';
            peopleInput.max = isCottage ? maxOccupancy : 20;
            document.getElementById('guestPricingHint').textContent = isCottage
                ? `Cottages are day-use and have a limit of ${maxOccupancy} guests.`
                : `The first ${maxOccupancy} guests are included in the overnight room rate. Each additional guest is ₱${extraOvernightGuestPrice} per night (up to 20 guests total).`;
            if (isCottage && Number(peopleInput.value) > maxOccupancy) {
                peopleInput.value = maxOccupancy;
            }

            document.getElementById('checkin').required = !isCottage;
            document.getElementById('bookingDate').required = isCottage;
            [document.getElementById('checkinTime'), document.getElementById('checkoutTime')].forEach(function(timeInput) {
                timeInput.disabled = !isCottage;
                timeInput.required = isCottage;
            });

            refreshKtvSchedule();
            calculateTotal();
        }

        ['checkin', 'bookingDate'].forEach(id => {
            document.getElementById(id).addEventListener('change', refreshKtvSchedule);
        });

        function calculateTotal() {
            updateEntranceFee();
            const roomSelect = document.getElementById('roomType');
            if (!roomSelect.value) {
                poolAddonOption.style.display = 'none';
                document.getElementById('priceDisplay').style.display = 'none';
                return;
            }

            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const price = parseFloat(selectedOption.getAttribute('data-price')) || 0;
            const category = selectedOption.getAttribute('data-category') || 'Room';
            const isCottage = (category === 'Cottage');
            const people = parseInt(document.getElementById('people').value) || 1;
            const maxOccupancy = parseInt(selectedOption.getAttribute('data-occupancy')) || 1;
            const extraGuestCount = isCottage ? 0 : Math.max(0, people - maxOccupancy);
            const maxPoolUsers = isCottage ? people : extraGuestCount;
            updateKtvGuestLimit(people);
            poolAddonOption.style.display = isCottage || extraGuestCount > 0 ? '' : 'none';
            poolAddonHint.textContent = isCottage
                ? `Pool use is limited to the ${people} guest${people === 1 ? '' : 's'} on this booking. ₱150 per adult; ₱100 per child under 4 ft.`
                : `Paid pool access is available for up to ${extraGuestCount} additional guest${extraGuestCount === 1 ? '' : 's'}. ₱150 per adult; ₱100 per child under 4 ft.`;
            updatePoolGuestLimits(maxPoolUsers);
            if (!isCottage && extraGuestCount === 0) {
                poolAddon.checked = false;
                poolAdultCount.value = '0';
                poolChildCount.value = '0';
                poolGuestCounts.style.display = 'none';
            }

            if (isCottage && people > maxOccupancy) {
                alert('⚠️ ' + category + ' "' + selectedOption.text.split('—')[0].trim() + '" can only accommodate ' + maxOccupancy + ' guests. Please adjust.');
                document.getElementById('people').value = maxOccupancy;
                return calculateTotal();
            }

            let basePrice = 0;
            let baseDescription = '';
            if (isCottage) {
                if (price > 0) {
                    basePrice = price;
                    baseDescription = `₱${price.toLocaleString()} — Flat Rate (Day Use)`;
                }
            } else {
                const checkin = document.getElementById('checkin').value;
                if (checkin && price > 0) {
                    const start = new Date(checkin);
                    const end = new Date(getAutoCheckout(checkin));
                    const nights = Math.max(1, Math.ceil((end - start) / (1000 * 60 * 60 * 24)));
                    const extraGuestFee = extraGuestCount * extraOvernightGuestPrice * nights;
                    basePrice = price * nights + extraGuestFee;
                    baseDescription = `₱${price.toLocaleString()} × ${nights} night(s) — ${category}`;
                    if (extraGuestFee > 0) {
                        baseDescription += ` + ${extraGuestCount} extra guest(s) × ₱${extraOvernightGuestPrice} × ${nights} night(s)`;
                    }
                }
            }
            const entranceFee = isCottage ? people * entranceFeePerPerson : 0;
            const entranceDescription = isCottage
                ? `Entrance fee (${people} guest${people === 1 ? '' : 's'}): ₱${entranceFee.toLocaleString()}`
                : '';
            const addonEstimate = getAddonEstimate();
            document.getElementById('totalPrice').textContent = (basePrice + entranceFee + addonEstimate.total).toLocaleString();
            document.getElementById('priceBreakdown').textContent = [baseDescription, entranceDescription, ...addonEstimate.lines].filter(Boolean).join(' + ');
            document.getElementById('priceDisplay').style.display = basePrice > 0 ? 'block' : 'none';
            checkDoubleBooking();
        }

        function toggleSchedule() {
            const content = document.getElementById('scheduleContent');
            const icon = document.getElementById('scheduleToggleIcon');
            if (content.style.display === 'none') {
                content.style.display = 'block';
                icon.classList.remove('bi-chevron-down');
                icon.classList.add('bi-chevron-up');
                loadBookingSchedule();
            } else {
                content.style.display = 'none';
                icon.classList.remove('bi-chevron-up');
                icon.classList.add('bi-chevron-down');
            }
        }

        function escapeScheduleText(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[character]);
        }

        function renderBookingSchedule() {
            const selectedRoom = scheduleRoomFilter.value;
            const selectedDate = scheduleDateFilter.value;
            const selectedSource = scheduleSourceFilter.value;
            const targetStart = selectedDate ? new Date(`${selectedDate}T00:00:00`) : null;
            const targetEnd = targetStart ? new Date(targetStart.getTime() + 86400000) : null;
            const filteredSchedule = {};

            for (const [roomName, bookings] of Object.entries(scheduleData)) {
                if (selectedRoom && roomName !== selectedRoom) continue;
                const matchingBookings = bookings.filter(booking => {
                    if (selectedSource && booking.bookingSource !== selectedSource) return false;
                    if (!targetStart) return true;
                    const checkin = new Date(String(booking.checkin).replace(' ', 'T'));
                    const checkout = new Date(String(booking.checkout).replace(' ', 'T'));
                    if (booking.category !== 'Cottage') {
                        return getScheduleDateKey(booking.checkin) <= selectedDate &&
                            getScheduleDateKey(booking.checkout) >= selectedDate;
                    }
                    return checkin < targetEnd && checkout > targetStart;
                });
                if (matchingBookings.length > 0) filteredSchedule[roomName] = matchingBookings;
            }

            const container = document.getElementById('scheduleData');
            const empty = document.getElementById('scheduleEmpty');
            if (Object.keys(filteredSchedule).length === 0) {
                container.innerHTML = '';
                container.style.display = 'none';
                empty.style.display = 'block';
                return;
            }

            empty.style.display = 'none';
            let html = '';
            for (const [roomName, bookings] of Object.entries(filteredSchedule)) {
                html += `<div class="schedule-room-group"><div class="schedule-room-name"><i class="bi bi-house-door-fill"></i> ${escapeScheduleText(roomName)}<span class="ms-auto badge bg-secondary rounded-pill" style="font-size: 0.7rem;">${bookings.length} booking${bookings.length > 1 ? 's' : ''}</span></div><div class="schedule-dates">`;
                bookings.forEach(booking => {
                    const cinDate = new Date(String(booking.checkin).replace(' ', 'T'));
                    const coutDate = new Date(String(booking.checkout).replace(' ', 'T'));
                    const sameDay = booking.category === 'Cottage' || cinDate.toDateString() === coutDate.toDateString();
                    const guestCount = Number(booking.guests) || 0;
                    const sourceBadge = `<span class="badge bg-light text-secondary border">${booking.bookingSource === 'WALK_IN' ? 'Walk-in' : 'Online'}</span>`;

                    if (sameDay) {
                        const cinTime = cinDate.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true});
                        const coutTime = coutDate.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true});
                        const dateStr = cinDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                        html += `<div class="schedule-date-item"><div class="schedule-date-range"><i class="bi bi-calendar-x-fill text-danger"></i> ${dateStr} | ${cinTime} - ${coutTime}</div><div class="d-flex align-items-center gap-2"><span class="schedule-guests"><i class="bi bi-people-fill me-1"></i>${guestCount} guest${guestCount === 1 ? '' : 's'}</span>${sourceBadge}<span class="schedule-badge-booked">Booked</span></div></div>`;
                    } else {
                        const checkin = cinDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                        const checkout = coutDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                        html += `<div class="schedule-date-item"><div class="schedule-date-range"><i class="bi bi-calendar-x-fill text-danger"></i> ${checkin} <i class="bi bi-arrow-right mx-1 text-muted"></i> ${checkout}</div><div class="d-flex align-items-center gap-2"><span class="schedule-guests"><i class="bi bi-people-fill me-1"></i>${guestCount} guest${guestCount === 1 ? '' : 's'}</span>${sourceBadge}<span class="schedule-badge-booked">Booked</span></div></div>`;
                    }
                });
                html += `</div></div>`;
            }
            container.innerHTML = html;
            container.style.display = 'block';
        }

        function getScheduleDateKey(value) {
            const date = new Date(String(value).replace(' ', 'T'));
            if (Number.isNaN(date.getTime())) return '';
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        async function loadBookingSchedule() {
            const loading = document.getElementById('scheduleLoading');
            const container = document.getElementById('scheduleData');
            const empty = document.getElementById('scheduleEmpty');
            const error = document.getElementById('scheduleError');
            loading.style.display = 'block';
            container.style.display = 'none';
            empty.style.display = 'none';
            error.style.display = 'none';

            try {
                const res = await fetch('/api/booking-schedule');
                if (!res.ok) throw new Error(`Schedule request failed with status ${res.status}.`);
                const data = await res.json();
                if (!data.success || !data.schedule) {
                    throw new Error(data.error || 'The schedule response was invalid.');
                }

                scheduleData = data.schedule;
                const selectedRoom = scheduleRoomFilter.value;
                const roomNames = Object.keys(scheduleData);
                scheduleRoomFilter.replaceChildren(new Option('All accommodations', ''));
                roomNames.forEach(roomName => scheduleRoomFilter.add(new Option(roomName, roomName)));
                if (roomNames.includes(selectedRoom)) scheduleRoomFilter.value = selectedRoom;
                renderBookingSchedule();
            } catch (err) {
                console.error('Failed to load schedule:', err);
                error.style.display = 'block';
            } finally {
                loading.style.display = 'none';
            }
        }

        scheduleRoomFilter.addEventListener('change', renderBookingSchedule);
        scheduleDateFilter.addEventListener('input', renderBookingSchedule);
        scheduleSourceFilter.addEventListener('change', renderBookingSchedule);

        function getScheduleConflictMessage(booking, isCottage, dateValue) {
            const accommodation = isCottage ? 'cottage' : 'room';
            const date = new Date(`${dateValue}T00:00:00`).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });

            if (booking.bookingSource === 'WALK_IN') {
                return `This ${accommodation} is already approved and recorded as a walk-in booking for ${date}. Please choose another ${accommodation} or change the date.`;
            }
            if (booking.status === 'approved') {
                return `This ${accommodation} already has an approved online booking for ${date}. Please choose another ${accommodation} or change the date.`;
            }
            return `An online booking request for this ${accommodation} is already on file for ${date} and is awaiting approval. Please choose another ${accommodation} or change the date.`;
        }

        function checkDoubleBooking() {
            const roomSelect = document.getElementById('roomType');
            const conflictAlert = document.getElementById('conflictAlert');
            const conflictMessage = document.getElementById('conflictMessage');
            const submitBtn = document.getElementById('submitBtn');

            conflictAlert.style.display = 'none';

            // Keep button disabled if email is NOT verified
            const isVerified = document.getElementById('emailVerified').value === 'true';
            if (!isVerified) {
                submitBtn.disabled = true;
            }

            if (!roomSelect.value) return true;

            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const category = selectedOption.getAttribute('data-category') || 'Room';
            const selectedRoom = roomSelect.value;
            const isCottage = (category === 'Cottage');
            const roomBookings = scheduleData[selectedRoom] || [];

            if (isCottage) {
                const bookingDate = document.getElementById('bookingDate').value;
                if (bookingDate && isMondayOrTuesday(bookingDate)) {
                    conflictMessage.innerHTML = '<strong>We are closed on Mondays and Tuesdays.</strong><br>Please choose a different date.';
                    conflictAlert.style.display = 'block';
                    submitBtn.disabled = true;
                    return false;
                }
            } else {
                const checkinVal = document.getElementById('checkin').value;
                if (checkinVal && isMondayOrTuesday(checkinVal)) {
                    conflictMessage.innerHTML = '<strong>Check-in cannot be on Monday or Tuesday.</strong><br>We are closed those days.';
                    conflictAlert.style.display = 'block';
                    submitBtn.disabled = true;
                    return false;
                }
            }

            if (isCottage) {
                const bookingDate = document.getElementById('bookingDate').value;
                if (!bookingDate) return true;
                for (const booking of roomBookings) {
                    const existingDate = new Date(booking.checkin).toISOString().split('T')[0];
                    if (existingDate === bookingDate) {
                        conflictMessage.textContent = getScheduleConflictMessage(booking, true, bookingDate);
                        conflictAlert.style.display = 'block';
                        submitBtn.disabled = true;
                        return false;
                    }
                }
            } else {
                const checkinVal = document.getElementById('checkin').value;
                if (!checkinVal) return true;
                const newStart = new Date(checkinVal);
                const newEnd = new Date(getAutoCheckout(checkinVal));
                for (const booking of roomBookings) {
                    const existingStart = new Date(booking.checkin);
                    const existingEnd = new Date(booking.checkout);
                    if (newStart < existingEnd && newEnd > existingStart) {
                        conflictMessage.textContent = getScheduleConflictMessage(booking, false, checkinVal);
                        conflictAlert.style.display = 'block';
                        submitBtn.disabled = true;
                        return false;
                    }
                }
            }

            // If we get here, no conflicts — but only unlock if verified
            if (isVerified) {
                submitBtn.disabled = false;
            }
            return true;
        }

        // ============================================
        // FORM SUBMIT HANDLER
        // ============================================

        function showBookingError(message) {
            const conflictAlert = document.getElementById('conflictAlert');
            document.getElementById('conflictMessage').textContent = message;
            conflictAlert.style.display = 'block';
            conflictAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        async function submitBooking(payload) {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting booking...';

            try {
                const res = await fetch('/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const contentType = res.headers.get('content-type') || '';
                const data = contentType.includes('application/json')
                    ? await res.json()
                    : { success: false, message: 'The booking server returned an unexpected response. Please refresh and try again.' };
                if (!res.ok || !data.success) {
                    showBookingError(data.message || 'Could not submit your booking. Please try again.');
                    unlockSubmitButton();
                    return;
                }

                new bootstrap.Modal(document.getElementById('successModal')).show();
                setTimeout(() => window.location.href = '/booking', 3000);
            } catch (err) {
                console.error('Booking submission error:', err);
                showBookingError(err.message || 'Could not submit your booking. Please try again.');
                unlockSubmitButton();
            }
        }

        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const phoneDigits = phoneInput.value.trim();
            if (!/^(?:9\d{9}|09\d{9})$/.test(phoneDigits)) {
                const requiredLength = phoneDigits.startsWith('09') ? 11 : 10;
                phoneInput.setCustomValidity(phoneDigits.startsWith('9') || phoneDigits.startsWith('09')
                    ? `Phone number must contain exactly ${requiredLength} digits.`
                    : 'Phone number must start with 9 or 09.');
                phoneInput.reportValidity();
                phoneInput.focus();
                return;
            }
            phoneInput.setCustomValidity('');
            const phone = `+63${phoneDigits.startsWith('0') ? phoneDigits.slice(1) : phoneDigits}`;

            // FIRST CHECK: Is email verified?
            const isVerified = document.getElementById('emailVerified').value === 'true';
            if (!isVerified) {
                alert('⚠️ Please verify your email address before submitting your booking.');
                return;
            }

            // SECOND CHECK: Any double booking conflicts?
            if (!checkDoubleBooking()) {
                document.getElementById('conflictAlert').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            const roomSelect = document.getElementById('roomType');
            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const category = selectedOption.getAttribute('data-category') || 'Room';

            if (category === 'Cottage') {
                const bookingDate = document.getElementById('bookingDate').value;
                const checkinTime = document.getElementById('checkinTime').value;
                const checkoutTime = document.getElementById('checkoutTime').value;

                if (!bookingDate || !checkinTime || !checkoutTime) {
                    alert('⚠️ Please fill in the booking date, check-in time, and check-out time for the cottage.');
                    return;
                }
                if (timeToMinutes(checkinTime) >= timeToMinutes(checkoutTime)) {
                    alert('⚠️ Check-out time must be later than check-in time.');
                    return;
                }
                if (isMondayOrTuesday(bookingDate)) {
                    alert('⚠️ We are closed on Mondays and Tuesdays. Please choose a different date.');
                    return;
                }
                const cottageMax = parseInt(selectedOption.getAttribute('data-occupancy'), 10) || 1;
                if ((parseInt(document.getElementById('people').value, 10) || 1) > cottageMax) {
                    alert(`⚠️ This cottage can accommodate up to ${cottageMax} guests.`);
                    return;
                }
            } else {
                const checkin = document.getElementById('checkin').value;
                if (!checkin) {
                    alert('⚠️ Please select a check-in date.');
                    return;
                }
                if (isMondayOrTuesday(checkin)) {
                    alert('⚠️ Check-in cannot be on Monday or Tuesday. We are closed those days.');
                    return;
                }
            }

            const guestCount = parseInt(document.getElementById('people').value, 10) || 0;
            const poolUsers = (parseInt(poolAdultCount.value, 10) || 0) + (parseInt(poolChildCount.value, 10) || 0);
            if (poolAddon.checked && poolUsers < 1) {
                alert('Please enter how many adults and children will use the pool.');
                poolAdultCount.focus();
                return;
            }
            const isCottage = selectedOption.getAttribute('data-category') === 'Cottage';
            const includedOccupancy = parseInt(selectedOption.getAttribute('data-occupancy'), 10) || 1;
            const maxPaidPoolUsers = isCottage ? guestCount : Math.max(0, guestCount - includedOccupancy);
            if (poolAddon.checked && poolUsers > maxPaidPoolUsers) {
                alert(`Pool users cannot exceed the ${maxPaidPoolUsers} guests eligible for paid pool access.`);
                poolAdultCount.focus();
                return;
            }
            if (ktvAddon.checked && (!Number.isInteger(Number(ktvGuestCount.value)) || Number(ktvGuestCount.value) < 1 || Number(ktvGuestCount.value) > Math.min(15, guestCount))) {
                alert(`KTV guest count must be between 1 and ${Math.min(15, guestCount)}.`);
                ktvGuestCount.focus();
                return;
            }
            if (ktvAddon.checked) {
                const stayDate = getSelectedStayDate();
                if (!ktvStartTime.value || ktvAvailabilityForDate !== stayDate) {
                    showBookingError('Choose an available KTV time slot for your stay date.');
                    refreshKtvSchedule();
                    ktvStartTime.focus();
                    return;
                }
            }

            submitBooking({
                name: document.getElementById('name').value.trim(),
                phone,
                email: document.getElementById('email').value.trim(),
                people: document.getElementById('people').value,
                roomType: roomSelect.value,
                requests: document.querySelector('textarea[name="requests"]').value.trim(),
                addons: [...document.querySelectorAll('input[name="addons"]:checked')].map(input => input.value),
                poolAdultCount: poolAdultCount.value,
                poolChildCount: poolChildCount.value,
                ktvGuestCount: ktvGuestCount.value,
                ktvStartTime: ktvStartTime.value,
                checkin: document.getElementById('checkin').value,
                bookingDate: document.getElementById('bookingDate').value,
                checkinTime: document.getElementById('checkinTime').value,
                checkoutTime: document.getElementById('checkoutTime').value
            });
        });

        // Load schedule on page load
        loadBookingSchedule().then(() => {
            document.getElementById('scheduleContent').dataset.loaded = 'true';
        });
    </script>
</body>
</html>
