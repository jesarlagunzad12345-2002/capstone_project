<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Your Stay | KML Mountain Resort</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="css/booking.css">
    <link rel="icon" type="image/jpeg" sizes="32x32" href="img/logo.jpg">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
    <script type="text/javascript">
        (function() { 
            emailjs.init({ publicKey: "nerxCEIOup7atDE6q" }); 
        })();
    </script>
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/booking">BOOKING</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input invisible" placeholder="Search rooms...">
                        <a href="/booking" class="btn book-btn invisible">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="booking-page">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <section class="booking-container">
                        <div class="booking-header text-center">
                            <h1 class="display-5 fw-bold mb-3">BOOK YOUR STAY</h1>
                            <p class="mb-0">Choose from our rooms and cottages. Your booking will be sent to our team for approval.</p>
                            <p class="text-danger small mt-2"><i class="bi bi-info-circle me-1"></i>We are closed every Monday & Tuesday.</p>
                        </div>

                        <% if (typeof message !== 'undefined' && message) { %>
                            <div class="alert alert-success alert-dismissible fade show m-4 booking-flash-alert" role="alert">
                                <strong>Success!</strong> <%= message %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show m-4 booking-flash-alert" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Booking Conflict!</strong> <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <form class="main-booking-form" id="bookingForm">
                            <div class="form-section">
                                <h3>1. Personal Information</h3>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Full Name</label>
                                    <input type="text" name="name" id="name" class="form-control custom-input" placeholder="Enter your full name" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Phone Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text">+63</span>
                                        <input type="tel" name="phone" id="phone" class="form-control custom-input" placeholder="09XXXXXXXXX" inputmode="numeric" autocomplete="tel-national" pattern="(?:9[0-9]{9}|09[0-9]{9})" required>
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Email Address</label>
                                    <div class="input-group">
                                        <input type="email" name="email" id="email" class="form-control custom-input" placeholder="Enter your email" required onchange="resetVerification()">
                                        <button type="button" class="btn btn-primary" id="sendCodeBtn" onclick="sendVerificationCode()">
                                            <i class="bi bi-send me-1"></i> Send Code
                                        </button>
                                    </div>
                                    <div id="emailStatus" class="form-text mt-1"></div>
                                </div>

                                <!-- VERIFICATION CODE INPUT -->
                                <div class="mb-3" id="codeSection" style="display: none;">
                                    <label class="form-label fw-semibold">Verification Code</label>
                                    <div class="input-group">
                                        <input type="text" id="verificationCodeInput" class="form-control custom-input" placeholder="Enter 6-digit code" maxlength="6">
                                        <button type="button" class="btn btn-success" id="verifyBtn" onclick="verifyCode()">
                                            <i class="bi bi-check-circle me-1"></i> Verify
                                        </button>
                                    </div>
                                    <div id="codeStatus" class="form-text mt-1"></div>
                                </div>

                                <!-- VERIFICATION BANNER: Shows only when email is verified -->
                                <div class="mb-3" id="verifiedBanner" style="display: none;">
                                    <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                                        <i class="bi bi-shield-check fs-4 me-3"></i>
                                        <div>
                                            <strong>Email Verified!</strong><br>
                                            <span class="small">You can now proceed with your booking.</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Hidden field to track verification state -->
                                <input type="hidden" id="emailVerified" value="false">
                            </div>

                            <div class="form-section" id="bookingDetailsSection">
                                <h3>2. Stay Details</h3>
                                <div class="alert alert-light border mb-3" id="entranceFeeDisplay" role="status" aria-live="polite">
                                    <strong>Entrance Fee:</strong>
                                    <span id="entranceFeeCalculation">₱30 × <span id="entranceFeeGuestCount">1</span>
                                    <span id="entranceFeeGuestLabel">person</span> =
                                    <strong>₱<span id="entranceFeeTotal">30</span></strong></span>
                                    <strong id="roomEntranceFeeMessage" style="display: none;">Free for overnight room guests.</strong>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Number of People</label>
                                    <input type="number" name="people" id="people" class="form-control custom-input" min="1" max="20" value="1" required>
                                    <div class="form-text" id="guestPricingHint">For overnight rooms, the listed occupancy is included in the room rate. Each additional guest is ₱200 per night (up to 20 guests total).</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Select Accommodation</label>
                                    <select name="roomType" id="roomType" class="form-select custom-select" required onchange="onRoomTypeChange()">
                                        <option value="">Choose your room or cottage...</option>
                                        <% if (rooms && rooms.length > 0) { %>
                                            <% 
                                                const categories = {};
                                                rooms.forEach(room => {
                                                    if (!categories[room.category]) categories[room.category] = [];
                                                    categories[room.category].push(room);
                                                });
                                            %>
                                            <% for (const [category, items] of Object.entries(categories)) { %>
                                                <optgroup label="<%= category === 'Cottage' ? '🏡 Cottages' : '🏨 ' + category + ' Rooms' %>">
                                                    <% items.forEach(room => { %>
                                                        <option value="<%= room.name %>" data-price="<%= room.price %>" data-category="<%= room.category %>" data-occupancy="<%= room.occupancy %>">
                                                            <%= room.name %> — ₱<%= room.price %><%= room.category === 'Cottage' ? ' (Flat Rate, max ' + room.occupancy + ' guests)' : '/night (' + room.occupancy + ' guests included)' %>
                                                        </option>
                                                    <% }) %>
                                                </optgroup>
                                            <% } %>
                                        <% } else { %>
                                            <option value="" disabled>No accommodations available</option>
                                        <% } %>
                                    </select>
                                </div>

                                <div class="row g-3 mb-3" id="roomDateFields">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Check-in Date</label>
                                        <input type="date" name="checkin" id="checkin" class="form-control custom-input" onchange="validateAndCalculate()">
                                    </div>
                                </div>
                                <input type="hidden" name="checkout" id="checkoutHidden">

                                <div class="row g-3 mb-3" id="cottageFields" style="display: none;">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Booking Date</label>
                                        <input type="date" name="bookingDate" id="bookingDate" class="form-control custom-input" onchange="validateAndCalculate()">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Check-in Time</label>
                                        <input type="time" name="checkinTime" id="checkinTime" class="form-control custom-input" value="08:00" onchange="checkDoubleBooking()">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Check-out Time</label>
                                        <input type="time" name="checkoutTime" id="checkoutTime" class="form-control custom-input" value="17:00" onchange="checkDoubleBooking()">
                                    </div>
                                </div>

                                <div class="alert alert-info" id="priceDisplay" style="display: none;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Estimated Total:</strong>
                                            <div class="small text-muted" id="priceBreakdown"></div>
                                        </div>
                                        <h4 class="mb-0 text-primary">₱<span id="totalPrice">0</span></h4>
                                    </div>
                                </div>

                                <div class="alert alert-danger" id="conflictAlert" style="display: none;">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <span id="conflictMessage"></span>
                                </div>

                                <div class="alert alert-warning" id="blockedDayAlert" style="display: none;">
                                    <i class="bi bi-calendar-x-fill me-2"></i>
                                    <span id="blockedDayMessage"></span>
                                </div>
                            </div>

                            <div class="form-section">
                                <h3><i class="bi bi-stars me-2 text-primary"></i>Optional Add-ons</h3>
                                <p class="text-muted small mb-3">Choose pool access or KTV for your stay. Overnight room guests within included occupancy receive free pool access; paid pool access is available for additional guests.</p>
                                <div class="booking-schedule-section">
                                    <button class="schedule-header w-100 text-start border-0" type="button" id="addonsToggle" aria-expanded="false" aria-controls="addonsContent">
                                        <h6 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-primary"></i>Choose optional add-ons</h6>
                                        <i class="bi bi-chevron-down" id="addonsToggleIcon" aria-hidden="true"></i>
                                    </button>
                                    <div class="schedule-content p-3" id="addonsContent" style="display: none;">
                                        <div class="form-check mb-3" id="poolAddonOption" style="display: none;">
                                            <input class="form-check-input" type="checkbox" name="addons" value="pool" id="poolAddon">
                                            <label class="form-check-label fw-semibold" for="poolAddon">Swimming pool</label>
                                            <div class="form-text" id="poolAddonHint">₱150 per adult; ₱100 per child under 4 ft.</div>
                                        </div>
                                        <div class="row g-3 mb-3" id="poolGuestCounts" style="display: none;">
                                            <div class="col-sm-6">
                                                <label class="form-label fw-semibold" for="poolAdultCount">Adults swimming</label>
                                                <input class="form-control custom-input" type="number" id="poolAdultCount" min="0" value="0" inputmode="numeric">
                                            </div>
                                            <div class="col-sm-6">
                                                <label class="form-label fw-semibold" for="poolChildCount">Children under 4 ft swimming</label>
                                                <input class="form-control custom-input" type="number" id="poolChildCount" min="0" value="0" inputmode="numeric">
                                            </div>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="addons" value="ktv" id="ktvAddon">
                                            <label class="form-check-label fw-semibold" for="ktvAddon">KTV room</label>
                                            <div class="form-text">₱1,000 for 3 hours, up to 15 guests. KTV hours are 8:00 AM–6:00 PM; the resort is closed Monday and Tuesday.</div>
                                        </div>
                                        <div class="row g-3 mt-1 mb-3" id="ktvGuestCountFields" style="display: none;">
                                            <div class="col-sm-6">
                                                <label class="form-label fw-semibold" for="ktvGuestCount">KTV guests (max 15)</label>
                                                <input class="form-control custom-input" type="number" id="ktvGuestCount" name="ktvGuestCount" min="1" max="15" step="1" value="1" inputmode="numeric" disabled>
                                            </div>
                                        </div>
                                        <div id="ktvScheduleFields" class="mt-3" style="display:none;">
                                            <div class="row g-3">
                                                <div class="col-sm-6">
                                                    <label class="form-label fw-semibold" for="ktvBookingDate">KTV schedule date</label>
                                                    <input class="form-control custom-input" type="date" id="ktvBookingDate" readonly>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label fw-semibold" for="ktvStartTime">Available KTV time (3 hours)</label>
                                                    <select class="form-select custom-input" id="ktvStartTime" name="ktvStartTime" disabled>
                                                        <option value="">Choose an available time</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div id="ktvAvailabilityMessage" class="form-text mt-2" aria-live="polite">Select a stay date to see KTV availability.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-section">
                                <h3><i class="bi bi-calendar-week me-2 text-primary"></i>Booking Schedule</h3>
                                <p class="text-muted small mb-3">Check which rooms are already reserved before booking your stay.</p>
                                <div class="booking-schedule-section">
                                    <div class="schedule-header" onclick="toggleSchedule()">
                                        <h6 class="mb-0 fw-bold"><i class="bi bi-calendar3 me-2 text-primary"></i>View Booking Schedule</h6>
                                        <i class="bi bi-chevron-down" id="scheduleToggleIcon"></i>
                                    </div>
                                    <div class="schedule-content" id="scheduleContent" style="display: none;">
                                        <div class="row g-2 p-3 border-bottom">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold mb-1" for="scheduleRoomFilter">Filter by accommodation</label>
                                                <select id="scheduleRoomFilter" class="form-select form-select-sm">
                                                    <option value="">All accommodations</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold mb-1" for="scheduleDateFilter">Filter by stay date</label>
                                                <input type="date" id="scheduleDateFilter" class="form-control form-control-sm">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold mb-1" for="scheduleSourceFilter">Filter by booking source</label>
                                                <select id="scheduleSourceFilter" class="form-select form-select-sm">
                                                    <option value="">All booking sources</option>
                                                    <option value="ONLINE">Online</option>
                                                    <option value="WALK_IN">Walk-in</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div id="scheduleLoading" class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                            <span class="ms-2 text-muted">Loading schedule...</span>
                                        </div>
                                        <div id="scheduleData" style="display: none;"></div>
                                        <div id="scheduleEmpty" class="text-center py-4 text-muted" style="display: none;">
                                            <i class="bi bi-calendar-check fs-1 text-success"></i>
                                            <p class="mb-0 mt-2 fw-semibold">No upcoming bookings match these filters.</p>
                                        </div>
                                        <div id="scheduleError" class="text-center py-4 text-danger" style="display:none;">Unable to load the booking schedule. Please try again.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-section border-0">
                                <h3>3. Special Requests</h3>
                                <textarea name="requests" class="form-control custom-textarea" rows="5" placeholder="Tell us about any special requests..."></textarea>
                            </div>

                            <!-- Submit button is DISABLED by default until email is verified -->
                            <button type="submit" class="btn submit-booking-btn w-100 mt-4" id="submitBtn" disabled>
                                <i class="bi bi-lock-fill me-2" id="submitLockIcon"></i>
                                <span id="submitBtnText">Verify Email to Book</span>
                            </button>
                        </form>

                        <!-- SUCCESS MODAL -->
                        <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content text-center p-4" style="border-radius: 20px;">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                                    <h4 class="fw-bold mt-3">Booking Submitted!</h4>
                                    <p class="text-muted">Your booking request has been sent to our admin team for approval.</p>
                                </div>
                            </div>
                        </div>

                    </section>
                </div>
            </div>
        </div>
    </main>

    <footer class="text-center py-4">
        <p class="mb-0">&copy; 2026 KML Mountain Resort. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.booking-flash-alert').forEach(alert => {
            window.setTimeout(() => bootstrap.Alert.getOrCreateInstance(alert).close(), 4000);
        });

        let scheduleData = {};
        const scheduleRoomFilter = document.getElementById('scheduleRoomFilter');
        const scheduleDateFilter = document.getElementById('scheduleDateFilter');
        const scheduleSourceFilter = document.getElementById('scheduleSourceFilter');
        const phoneInput = document.getElementById('phone');
        phoneInput.addEventListener('input', function() {
            const inputDigits = this.value.replace(/\D/g, '');
            const maxDigits = inputDigits.startsWith('09') ? 11 : 10;
            const digits = inputDigits.slice(0, maxDigits);
            this.value = digits;
            const validPrefix = digits === '' || digits === '0' || digits.startsWith('09') || digits.startsWith('9');
            const expectedLength = digits.startsWith('09') ? 11 : 10;
            this.setCustomValidity(!validPrefix
                ? 'Phone number must start with 9 or 09.'
                : digits.length > 0 && digits.length < expectedLength
                    ? `Phone number must contain ${expectedLength} digits for this prefix.`
                    : '');
            if (digits.length === maxDigits && this.dataset.limitNotified !== 'true') {
                this.dataset.limitNotified = 'true';
                Swal.fire({
                    icon: 'info',
                    title: 'Phone number limit reached',
                    text: `You can enter up to ${maxDigits} digits for this phone number format.`,
                    confirmButtonColor: '#0d6efd'
                });
            } else if (digits.length < maxDigits) {
                this.dataset.limitNotified = 'false';
            }
        });

        const addonPrices = { poolAdult: 150, poolChild: 100, ktv: 1000 };
        const entranceFeePerPerson = 30;
        const extraOvernightGuestPrice = 200;
        const addonsToggle = document.getElementById('addonsToggle');
        const addonsContent = document.getElementById('addonsContent');
        const poolAddon = document.getElementById('poolAddon');
        const ktvAddon = document.getElementById('ktvAddon');
        const poolGuestCounts = document.getElementById('poolGuestCounts');
        const poolAddonOption = document.getElementById('poolAddonOption');
        const poolAddonHint = document.getElementById('poolAddonHint');
        const poolAdultCount = document.getElementById('poolAdultCount');
        const poolChildCount = document.getElementById('poolChildCount');
        const ktvGuestCount = document.getElementById('ktvGuestCount');
        const ktvGuestCountFields = document.getElementById('ktvGuestCountFields');
        const ktvScheduleFields = document.getElementById('ktvScheduleFields');
        const ktvBookingDateInput = document.getElementById('ktvBookingDate');
        const ktvStartTime = document.getElementById('ktvStartTime');
        const ktvAvailabilityMessage = document.getElementById('ktvAvailabilityMessage');
        const peopleInput = document.getElementById('people');
        let ktvAvailabilityRequest = 0;
        let ktvAvailabilityForDate = '';

        function getSelectedStayDate() {
            const roomSelect = document.getElementById('roomType');
            const option = roomSelect.options[roomSelect.selectedIndex];
            return option?.getAttribute('data-category') === 'Cottage'
                ? document.getElementById('bookingDate').value
                : document.getElementById('checkin').value;
        }

        async function refreshKtvSchedule() {
            ktvScheduleFields.style.display = ktvAddon.checked ? '' : 'none';
            if (!ktvAddon.checked) {
                ktvStartTime.value = '';
                ktvStartTime.disabled = true;
                ktvAvailabilityForDate = '';
                return;
            }

            const bookingDate = getSelectedStayDate();
            ktvBookingDateInput.value = bookingDate;
            const previousSelection = ktvStartTime.value;
            ktvStartTime.replaceChildren(new Option('Loading available times...', ''));
            ktvStartTime.disabled = true;
            ktvAvailabilityForDate = '';
            const requestId = ++ktvAvailabilityRequest;

            if (!bookingDate) {
                ktvStartTime.replaceChildren(new Option('Choose a stay date first', ''));
                ktvAvailabilityMessage.textContent = 'Select an accommodation and stay date to view available KTV times.';
                return;
            }
            if (isMondayOrTuesday(bookingDate)) {
                ktvStartTime.replaceChildren(new Option('KTV is closed on this date', ''));
                ktvAvailabilityMessage.textContent = 'The resort and KTV are closed every Monday and Tuesday.';
                return;
            }

            try {
                const response = await fetch(`/api/ktv-schedule?date=${encodeURIComponent(bookingDate)}`, { cache: 'no-store' });
                if (!response.ok) throw new Error(`KTV availability request failed with status ${response.status}.`);
                const data = await response.json();
                if (!data.success || !Array.isArray(data.slots) || !Array.isArray(data.bookings)) {
                    throw new Error(data.error || 'The KTV availability response was invalid.');
                }
                if (requestId !== ktvAvailabilityRequest) return;

                const dayBookings = data.bookings.filter(booking => getScheduleDateKey(booking.date) === bookingDate);
                const hasUnscheduledBooking = dayBookings.some(booking => booking.schedulePending);
                const reservedTimes = new Set(dayBookings.map(booking => String(booking.startTime || '').slice(0, 8)).filter(Boolean));
                ktvStartTime.replaceChildren(new Option('Choose an available time', ''));
                data.slots.forEach(slot => {
                    const option = new Option(slot.label, slot.start);
                    if (hasUnscheduledBooking || reservedTimes.has(slot.start)) {
                        option.disabled = true;
                        option.textContent = `${slot.label} — Booked`;
                    } else {
                        option.textContent = `${slot.label} — Available`;
                    }
                    ktvStartTime.add(option);
                });
                const normalizedSelection = String(previousSelection || '').slice(0, 8);
                if (normalizedSelection && data.slots.some(slot => slot.start === normalizedSelection) &&
                    !hasUnscheduledBooking && !reservedTimes.has(normalizedSelection)) {
                    ktvStartTime.value = normalizedSelection;
                }
                const availableCount = data.slots.filter(slot => !hasUnscheduledBooking && !reservedTimes.has(slot.start)).length;
                ktvStartTime.disabled = availableCount === 0;
                ktvAvailabilityForDate = bookingDate;
                const bookedLabels = data.slots
                    .filter(slot => reservedTimes.has(slot.start))
                    .map(slot => slot.label);
                ktvAvailabilityMessage.textContent = hasUnscheduledBooking
                    ? 'KTV already has a reservation on this date with no time assigned. Please choose another date.'
                    : availableCount
                        ? `Available: ${data.slots.filter(slot => !reservedTimes.has(slot.start)).map(slot => slot.label).join(', ')}.${bookedLabels.length ? ` Booked: ${bookedLabels.join(', ')}.` : ''}`
                        : 'All KTV time slots are booked for this date. Choose another stay date.';
            } catch (error) {
                if (requestId !== ktvAvailabilityRequest) return;
                console.error('Failed to load KTV availability:', error);
                ktvStartTime.replaceChildren(new Option('Availability unavailable', ''));
                ktvAvailabilityMessage.textContent = 'Could not load KTV availability. Please try again before submitting.';
            }
        }

        function updateKtvGuestLimit(guestCount, initialize = false) {
            const maxKtvGuests = Math.min(15, guestCount);
            ktvGuestCount.max = String(maxKtvGuests);
            ktvGuestCountFields.style.display = ktvAddon.checked ? 'flex' : 'none';
            ktvGuestCount.disabled = !ktvAddon.checked;
            if (ktvAddon.checked) {
                if (initialize && (!ktvGuestCount.value || Number(ktvGuestCount.value) < 1)) {
                    ktvGuestCount.value = String(maxKtvGuests);
                } else if (ktvGuestCount.value && Number(ktvGuestCount.value) > maxKtvGuests) {
                    ktvGuestCount.value = String(maxKtvGuests);
                }
            } else {
                ktvGuestCount.value = '0';
            }
        }

        function updatePoolGuestLimits(maxUsers, changedInput) {
            const limit = Math.max(0, Number(maxUsers) || 0);
            let adults = Math.max(0, Number(poolAdultCount.value) || 0);
            let children = Math.max(0, Number(poolChildCount.value) || 0);

            if (adults + children > limit) {
                if (changedInput === poolAdultCount) {
                    children = Math.min(children, limit);
                    adults = Math.min(adults, limit - children);
                } else if (changedInput === poolChildCount) {
                    adults = Math.min(adults, limit);
                    children = Math.min(children, limit - adults);
                } else {
                    adults = Math.min(adults, limit);
                    children = Math.min(children, limit - adults);
                }
            }

            if (poolAdultCount.value !== '' || adults !== 0) {
                poolAdultCount.value = String(adults);
            }
            if (poolChildCount.value !== '' || children !== 0) {
                poolChildCount.value = String(children);
            }
            poolAdultCount.max = String(Math.max(0, limit - children));
            poolChildCount.max = String(Math.max(0, limit - adults));
        }

        function updateEntranceFee() {
            const guestCount = Math.max(1, parseInt(peopleInput.value, 10) || 1);
            const roomSelect = document.getElementById('roomType');
            const selectedOption = roomSelect.selectedOptions[0];
            const isCottage = roomSelect.value && selectedOption.getAttribute('data-category') === 'Cottage';
            document.getElementById('entranceFeeCalculation').style.display = isCottage ? '' : 'none';
            document.getElementById('roomEntranceFeeMessage').style.display = isCottage ? 'none' : '';
            document.getElementById('roomEntranceFeeMessage').textContent = roomSelect.value
                ? 'Free for overnight room guests.'
                : 'Overnight room entrance is free; cottage entrance is ₱30 per person.';
            document.getElementById('entranceFeeGuestCount').textContent = guestCount.toLocaleString();
            document.getElementById('entranceFeeGuestLabel').textContent = guestCount === 1 ? 'person' : 'people';
            document.getElementById('entranceFeeTotal').textContent =
                (guestCount * entranceFeePerPerson).toLocaleString();
        }

        peopleInput.addEventListener('input', calculateTotal);
        updateEntranceFee();

        addonsToggle.addEventListener('click', function() {
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
            this.setAttribute('aria-expanded', String(!isExpanded));
            addonsContent.style.display = isExpanded ? 'none' : 'block';
            document.getElementById('addonsToggleIcon').classList.toggle('bi-chevron-down', isExpanded);
            document.getElementById('addonsToggleIcon').classList.toggle('bi-chevron-up', !isExpanded);
        });

        function getAddonEstimate() {
            const adults = Number(poolAdultCount.value) || 0;
            const children = Number(poolChildCount.value) || 0;
            const lines = [];
            let total = 0;

            if (poolAddon.checked) {
                const poolTotal = adults * addonPrices.poolAdult + children * addonPrices.poolChild;
                total += poolTotal;
                lines.push(`Pool: ₱${poolTotal.toLocaleString()}`);
            }
            if (ktvAddon.checked) {
                total += addonPrices.ktv;
                lines.push(`KTV (3 hours): ₱${addonPrices.ktv.toLocaleString()}`);
            }
            return { total, lines };
        }

        function updateAddonFields() {
            poolGuestCounts.style.display = poolAddon.checked ? 'flex' : 'none';
            updateKtvGuestLimit(Math.max(1, Number(peopleInput.value) || 1), true);
            refreshKtvSchedule();
            calculateTotal();
        }

        [poolAddon, ktvAddon].forEach(input => input.addEventListener('change', updateAddonFields));
        ktvGuestCount.addEventListener('input', calculateTotal);
        [poolAdultCount, poolChildCount].forEach(input => input.addEventListener('input', function() {
            const roomSelect = document.getElementById('roomType');
            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const guestCount = Math.max(1, Number(peopleInput.value) || 1);
            const occupancy = Number(selectedOption?.getAttribute('data-occupancy')) || 1;
            const maxPoolUsers = selectedOption?.getAttribute('data-category') === 'Cottage'
                ? guestCount
                : Math.max(0, guestCount - occupancy);
            updatePoolGuestLimits(maxPoolUsers, this);
            calculateTotal();
        }));

