<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Your Stay | KML Mountain Resort</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="css/booking.css">
    <link rel="icon" type="image/jpeg" sizes="32x32" href="img/logo.jpg">

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
    <script type="text/javascript">
        (function() { 
            emailjs.init({ publicKey: "nerxCEIOup7atDE6q" }); 
        })();
    </script>
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/booking">BOOKING</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input invisible" placeholder="Search rooms...">
                        <a href="/booking" class="btn book-btn invisible">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="booking-page">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <section class="booking-container">
                        <div class="booking-header text-center">
                            <h1 class="display-5 fw-bold mb-3">BOOK YOUR STAY</h1>
                            <p class="mb-0">Choose from our rooms and cottages. Prices are calculated automatically.</p>
                            <p class="text-danger small mt-2"><i class="bi bi-info-circle me-1"></i>We are closed every Monday & Tuesday.</p>
                        </div>

                        <% if (typeof message !== 'undefined' && message) { %>
                            <div class="alert alert-success alert-dismissible fade show m-4" role="alert">
                                <strong>Success!</strong> <%= message %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show m-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Booking Conflict!</strong> <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <form class="main-booking-form" id="bookingForm">
                            <div class="form-section">
                                <h3>1. Personal Information</h3>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Full Name</label>
                                    <input type="text" name="name" id="name" class="form-control custom-input" placeholder="Enter your full name" required>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Email Address</label>
                                    <div class="input-group">
                                        <input type="email" name="email" id="email" class="form-control custom-input" placeholder="Enter your email" required onchange="resetVerification()">
                                        <button type="button" class="btn btn-primary" id="sendCodeBtn" onclick="sendVerificationCode()">
                                            <i class="bi bi-send me-1"></i> Send Code
                                        </button>
                                    </div>
                                    <div id="emailStatus" class="form-text mt-1"></div>
                                </div>

                                <!-- VERIFICATION CODE INPUT -->
                                <div class="mb-3" id="codeSection" style="display: none;">
                                    <label class="form-label fw-semibold">Verification Code</label>
                                    <div class="input-group">
                                        <input type="text" id="verificationCodeInput" class="form-control custom-input" placeholder="Enter 6-digit code" maxlength="6">
                                        <button type="button" class="btn btn-success" id="verifyBtn" onclick="verifyCode()">
                                            <i class="bi bi-check-circle me-1"></i> Verify
                                        </button>
                                    </div>
                                    <div id="codeStatus" class="form-text mt-1"></div>
                                </div>

                                <!-- VERIFICATION BANNER: Shows only when email is verified -->
                                <div class="mb-3" id="verifiedBanner" style="display: none;">
                                    <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                                        <i class="bi bi-shield-check fs-4 me-3"></i>
                                        <div>
                                            <strong>Email Verified!</strong><br>
                                            <span class="small">You can now proceed with your booking.</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Hidden field to track verification state -->
                                <input type="hidden" id="emailVerified" value="false">
                            </div>

                            <div class="form-section" id="bookingDetailsSection">
                                <h3>2. Stay Details</h3>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Number of People</label>
                                    <input type="number" name="people" id="people" class="form-control custom-input" min="1" max="20" value="1" required onchange="calculateTotal()">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Select Accommodation</label>
                                    <select name="roomType" id="roomType" class="form-select custom-select" required onchange="onRoomTypeChange()">
                                        <option value="">Choose your room or cottage...</option>
                                        <% if (rooms && rooms.length > 0) { %>
                                            <% 
                                                const categories = {};
                                                rooms.forEach(room => {
                                                    if (!categories[room.category]) categories[room.category] = [];
                                                    categories[room.category].push(room);
                                                });
                                            %>
                                            <% for (const [category, items] of Object.entries(categories)) { %>
                                                <optgroup label="<%= category === 'Cottage' ? '🏡 Cottages' : '🏨 ' + category + ' Rooms' %>">
                                                    <% items.forEach(room => { %>
                                                        <option value="<%= room.name %>" data-price="<%= room.price %>" data-category="<%= room.category %>" data-occupancy="<%= room.occupancy %>">
                                                            <%= room.name %> — ₱<%= room.price %><%= room.category === 'Cottage' ? ' (Flat Rate)' : '/night' %> (Max <%= room.occupancy %> guests)
                                                        </option>
                                                    <% }) %>
                                                </optgroup>
                                            <% } %>
                                        <% } else { %>
                                            <option value="" disabled>No accommodations available</option>
                                        <% } %>
                                    </select>
                                </div>

                                <div class="row g-3 mb-3" id="roomDateFields">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Check-in Date</label>
                                        <input type="date" name="checkin" id="checkin" class="form-control custom-input" onchange="validateAndCalculate()">
                                    </div>
                                </div>
                                <input type="hidden" name="checkout" id="checkoutHidden">

                                <div class="row g-3 mb-3" id="cottageFields" style="display: none;">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Booking Date</label>
                                        <input type="date" name="bookingDate" id="bookingDate" class="form-control custom-input" onchange="validateAndCalculate()">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Check-in Time</label>
                                        <input type="time" name="checkinTime" id="checkinTime" class="form-control custom-input" value="08:00" onchange="checkDoubleBooking()">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Check-out Time</label>
                                        <input type="time" name="checkoutTime" id="checkoutTime" class="form-control custom-input" value="17:00" onchange="checkDoubleBooking()">
                                    </div>
                                </div>

                                <div class="alert alert-info" id="priceDisplay" style="display: none;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Estimated Total:</strong>
                                            <div class="small text-muted" id="priceBreakdown"></div>
                                        </div>
                                        <h4 class="mb-0 text-primary">₱<span id="totalPrice">0</span></h4>
                                    </div>
                                    <hr class="my-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small">Downpayment required now (30%):</span>
                                        <strong class="text-success">₱<span id="downpaymentEstimate">0</span></strong>
                                    </div>
                                </div>

                                <div class="alert alert-danger" id="conflictAlert" style="display: none;">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <span id="conflictMessage"></span>
                                </div>

                                <div class="alert alert-warning" id="blockedDayAlert" style="display: none;">
                                    <i class="bi bi-calendar-x-fill me-2"></i>
                                    <span id="blockedDayMessage"></span>
                                </div>
                            </div>

                            <div class="form-section">
                                <h3><i class="bi bi-calendar-week me-2 text-primary"></i>Booking Schedule</h3>
                                <p class="text-muted small mb-3">Check which rooms are already reserved before booking your stay.</p>
                                <div class="booking-schedule-section">
                                    <div class="schedule-header" onclick="toggleSchedule()">
                                        <h6 class="mb-0 fw-bold"><i class="bi bi-calendar3 me-2 text-primary"></i>View Booking Schedule</h6>
                                        <i class="bi bi-chevron-down" id="scheduleToggleIcon"></i>
                                    </div>
                                    <div class="schedule-content" id="scheduleContent" style="display: none;">
                                        <div id="scheduleLoading" class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                            <span class="ms-2 text-muted">Loading schedule...</span>
                                        </div>
                                        <div id="scheduleData" style="display: none;"></div>
                                        <div id="scheduleEmpty" class="text-center py-4 text-muted" style="display: none;">
                                            <i class="bi bi-calendar-check fs-1 text-success"></i>
                                            <p class="mb-0 mt-2 fw-semibold">No bookings yet. All rooms are available!</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-section border-0">
                                <h3>3. Special Requests</h3>
                                <textarea name="requests" class="form-control custom-textarea" rows="5" placeholder="Tell us about any special requests..."></textarea>
                            </div>

                            <!-- Submit button is DISABLED by default until email is verified -->
                            <button type="submit" class="btn submit-booking-btn w-100 mt-4" id="submitBtn" disabled>
                                <i class="bi bi-lock-fill me-2" id="submitLockIcon"></i>
                                <span id="submitBtnText">Verify Email to Book</span>
                            </button>
                        </form>

                        <!-- ============================================ -->
                        <!-- PAYMENT MODAL — Downpayment via GCash / Maya -->
                        <!-- ============================================ -->
                        <div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content" style="border-radius: 20px;">
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold"><i class="bi bi-wallet2 me-2 text-primary"></i>Complete Your Downpayment</h5>
                                    </div>
                                    <div class="modal-body">
                                        <div class="alert alert-warning d-flex justify-content-between align-items-center payment-hold-banner">
                                            <span><i class="bi bi-clock-history me-2"></i>Your slot is reserved for:</span>
                                            <strong id="holdCountdown">30:00</strong>
                                        </div>

                                        <!-- Total / Downpayment summary -->
                                        <div class="payment-total-box text-center mb-3">
                                            <div class="total-label">Total Stay Cost</div>
                                            <div class="total-amount">₱<span id="payTotal">0</span></div>
                                            <div class="downpayment-label mt-2">Required Downpayment (30%)</div>
                                            <div class="downpayment-amount">₱<span id="payAmount">0</span></div>
                                        </div>

                                        <!-- Payment method tabs: GCash = blue when active, Maya = green when active -->
                                        <ul class="nav nav-pills nav-justified mb-3 payment-method-tabs" role="tablist">
                                            <li class="nav-item">
                                                <button type="button" id="gcashTab" class="nav-link active w-100" onclick="selectPaymentMethod('gcash')">
                                                    <i class="bi bi-phone me-1"></i> GCash
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button type="button" id="mayaTab" class="nav-link w-100" onclick="selectPaymentMethod('maya')">
                                                    <i class="bi bi-credit-card me-1"></i> Maya
                                                </button>
                                            </li>
                                        </ul>

                                        <div id="gcashPane" class="qr-pane text-center mb-3">
                                            <img src="/img/gcash-qr.png" alt="GCash QR" style="max-width: 220px;" class="img-fluid">
                                            <p class="mt-2 mb-0 qr-account-name">GCash — [Your Registered Name]</p>
                                            <p class="qr-account-number mb-0">09XX-XXX-XXXX</p>
                                        </div>

                                        <div id="mayaPane" class="qr-pane text-center mb-3" style="display:none;">
                                            <img src="/img/maya-qr.png" alt="Maya QR" style="max-width: 220px;" class="img-fluid">
                                            <p class="mt-2 mb-0 qr-account-name">Maya — [Your Registered Name]</p>
                                            <p class="qr-account-number mb-0">09XX-XXX-XXXX</p>
                                        </div>

                                        <p class="text-muted small text-center">
                                            Scan the QR code or send manually to the number above, then fill in the details below.
                                        </p>

                                        <input type="hidden" id="paymentMethodInput" value="gcash">

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Reference / Transaction Number</label>
                                            <input type="text" id="referenceNumber" class="form-control" placeholder="e.g. 1234567890123">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Upload Receipt Screenshot <span class="text-muted small">(optional but recommended)</span></label>
                                            <input type="file" id="receiptUpload" class="form-control" accept="image/png, image/jpeg, image/webp">
                                        </div>

                                        <div id="paymentStatus" class="mb-2"></div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-light" onclick="cancelActiveHold()" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-success" id="submitPaymentBtn" onclick="submitPaymentProof()">
                                            <i class="bi bi-check-circle me-1"></i> I've Paid — Submit Proof
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SUCCESS MODAL -->
                        <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content text-center p-4" style="border-radius: 20px;">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                                    <h4 class="fw-bold mt-3">Payment Submitted!</h4>
                                    <p class="text-muted">Your booking has been sent to our admin team for approval. We'll confirm once your payment is verified.</p>
                                </div>
                            </div>
                        </div>

                    </section>
                </div>
            </div>
        </div>
    </main>

    <footer class="text-center py-4">
        <p class="mb-0">&copy; 2026 KML Mountain Resort. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let scheduleData = {};

        // ============================================
        // EMAIL VERIFICATION FUNCTIONS
        // ============================================

        // Reset everything when email changes
        function resetVerification() {
            document.getElementById('emailVerified').value = 'false';
            document.getElementById('codeSection').style.display = 'none';
            document.getElementById('verifiedBanner').style.display = 'none';
            document.getElementById('emailStatus').innerHTML = '';
            document.getElementById('codeStatus').innerHTML = '';
            document.getElementById('verificationCodeInput').value = '';
            document.getElementById('sendCodeBtn').style.display = 'block';
            document.getElementById('sendCodeBtn').disabled = false;
            document.getElementById('sendCodeBtn').innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
            document.getElementById('email').readOnly = false;

            // Lock the submit button again
            lockSubmitButton();
        }

        // FIX: createHoldAndOpenPayment() replaces submitBtn's innerHTML with
        // a spinner while the request is in flight ("Reserving your
        // slot..."). That destroys the <span id="submitBtnText"> and
        // <i id="submitLockIcon"> elements that used to live inside the
        // button. lockSubmitButton()/unlockSubmitButton() previously
        // assumed those elements still existed and tried to update them
        // directly — once they'd been wiped out by the spinner HTML,
        // getElementById returned null and calling .textContent on it
        // threw "Cannot set properties of null". Both functions now
        // rebuild the button's full contents every time instead of
        // relying on child elements that may no longer be there.

        // Lock submit button (not verified)
        function lockSubmitButton() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-lock-fill me-2" id="submitLockIcon"></i><span id="submitBtnText">Verify Email to Book</span>';
        }

        // Unlock submit button (verified)
        function unlockSubmitButton() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-wallet2 me-2" id="submitLockIcon"></i><span id="submitBtnText">Proceed to Downpayment</span>';
        }

        // Send verification code to email
        async function sendVerificationCode() {
            const emailInput = document.getElementById('email');
            const email = emailInput.value.trim();
            const btn = document.getElementById('sendCodeBtn');
            const status = document.getElementById('emailStatus');

            // Check if email looks valid
            if (!email || !email.includes('@') || !email.includes('.')) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Please enter a valid email address.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...';

            try {
                // Ask server to generate a code
                const res = await fetch('/api/request-verification-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const data = await res.json();

                if (!data.success) {
                    status.innerHTML = `<span class="text-danger">${data.message}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
                    return;
                }

                console.log("✅ Server generated code:", data.code);

                // Send the code via EmailJS
                await emailjs.send('service_p0pcn2h', 'template_i8uz2wj', {
                    email: email,
                    verification_code: data.code,
                    user_name: document.getElementById('name').value || 'Guest'
                });

                // Show the code input field
                document.getElementById('codeSection').style.display = 'block';
                status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Code sent! Check your inbox (and spam folder).</span>';

                // Start 60-second countdown for resend
                let seconds = 60;
                btn.innerHTML = `Resend (${seconds}s)`;
                const timer = setInterval(() => {
                    seconds--;
                    if (seconds > 0) {
                        btn.innerHTML = `Resend (${seconds}s)`;
                    } else {
                        clearInterval(timer);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-send me-1"></i> Resend Code';
                    }
                }, 1000);

            } catch (err) {
                console.error('EmailJS Error:', err);
                status.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Failed to send email. Please try again.</span>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
            }
        }

        // Check if the code user entered is correct
        async function verifyCode() {
            const email = document.getElementById('email').value.trim();
            const code = document.getElementById('verificationCodeInput').value.trim();
            const btn = document.getElementById('verifyBtn');
            const status = document.getElementById('codeStatus');

            // Code must be 6 digits
            if (!code || code.length !== 6 || isNaN(code)) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Please enter the 6-digit code.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking...';

            try {
                // Send code to server to verify
                const res = await fetch('/api/verify-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, code: code })
                });
                const data = await res.json();

                if (data.success) {
                    // VERIFIED! Update everything
                    document.getElementById('emailVerified').value = 'true';
                    document.getElementById('email').readOnly = true;
                    document.getElementById('codeSection').style.display = 'none';
                    document.getElementById('sendCodeBtn').style.display = 'none';

                    // Show the green verified banner
                    document.getElementById('verifiedBanner').style.display = 'block';

                    status.innerHTML = '<span class="text-success"><i class="bi bi-shield-check me-1"></i>Email verified! You can now complete your booking.</span>';
                    document.getElementById('email').classList.add('is-valid');

                    // Unlock the submit button so user can book
                    unlockSubmitButton();

                } else {
                    // Wrong code
                    status.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>${data.message}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Verify';
                }
            } catch (err) {
                console.error('❌ Verify error:', err);
                status.innerHTML = '<span class="text-danger">Server error. Please refresh and try again.</span>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Verify';
            }
        }

        // ============================================
        // BOOKING LOGIC
        // ============================================

        function timeToMinutes(timeStr) {
            if (!timeStr) return 0;
            const [h, m] = timeStr.split(':').map(Number);
            return (h * 60) + m;
        }

        function isMondayOrTuesday(dateString) {
            if (!dateString) return false;
            const [year, month, day] = dateString.split('-').map(Number);
            const date = new Date(year, month - 1, day);
            const dayOfWeek = date.getDay();
            return dayOfWeek === 1 || dayOfWeek === 2;
        }

        function getNextValidDate(fromDateStr) {
            const [year, month, day] = fromDateStr.split('-').map(Number);
            const date = new Date(year, month - 1, day);
            while (true) {
                const dayOfWeek = date.getDay();
                if (dayOfWeek !== 1 && dayOfWeek !== 2) break;
                date.setDate(date.getDate() + 1);
            }
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function getAutoCheckout(checkinStr) {
            const [year, month, day] = checkinStr.split('-').map(Number);
            const date = new Date(year, month - 1, day);
            date.setDate(date.getDate() + 1);
            while (date.getDay() === 1 || date.getDay() === 2) {
                date.setDate(date.getDate() + 1);
            }
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        const today = new Date().toISOString().split('T')[0];
        const validToday = getNextValidDate(today);

        document.getElementById('checkin').min = validToday;
        document.getElementById('bookingDate').min = validToday;
        document.getElementById('bookingDate').value = validToday;

        document.getElementById('checkin').addEventListener('change', function() {
            if (isMondayOrTuesday(this.value)) {
                this.value = '';
                showBlockedAlert('Check-in cannot be on Monday or Tuesday. We are closed those days.');
                return;
            }
        });

        document.getElementById('bookingDate').addEventListener('change', function() {
            if (isMondayOrTuesday(this.value)) {
                this.value = '';
                showBlockedAlert('Booking cannot be on Monday or Tuesday. We are closed those days.');
            }
        });

        function showBlockedAlert(msg) {
            const alert = document.getElementById('blockedDayAlert');
            const message = document.getElementById('blockedDayMessage');
            message.textContent = msg;
            alert.style.display = 'block';
            setTimeout(() => { alert.style.display = 'none'; }, 4000);
        }

        function validateAndCalculate() {
            document.getElementById('blockedDayAlert').style.display = 'none';
            calculateTotal();
        }

        function onRoomTypeChange() {
            const roomSelect = document.getElementById('roomType');
            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const category = selectedOption.getAttribute('data-category') || 'Room';
            const isCottage = (category === 'Cottage');

            document.getElementById('roomDateFields').style.display = isCottage ? 'none' : 'flex';
            document.getElementById('cottageFields').style.display = isCottage ? 'flex' : 'none';

            document.getElementById('checkin').required = !isCottage;
            document.getElementById('bookingDate').required = isCottage;
            document.getElementById('checkinTime').required = isCottage;
            document.getElementById('checkoutTime').required = isCottage;

            calculateTotal();
        }

        function calculateTotal() {
            const roomSelect = document.getElementById('roomType');
            if (!roomSelect.value) {
                document.getElementById('priceDisplay').style.display = 'none';
                return;
            }

            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const price = parseFloat(selectedOption.getAttribute('data-price')) || 0;
            const category = selectedOption.getAttribute('data-category') || 'Room';
            const isCottage = (category === 'Cottage');
            const people = parseInt(document.getElementById('people').value) || 1;
            const maxOccupancy = parseInt(selectedOption.getAttribute('data-occupancy')) || 1;

            if (people > maxOccupancy && maxOccupancy > 0) {
                alert('⚠️ ' + category + ' "' + selectedOption.text.split('—')[0].trim() + '" can only accommodate ' + maxOccupancy + ' guests. Please adjust.');
                document.getElementById('people').value = maxOccupancy;
                return calculateTotal();
            }

            if (isCottage) {
                if (price > 0) {
                    document.getElementById('totalPrice').textContent = price.toLocaleString();
                    document.getElementById('priceBreakdown').textContent = '₱' + price.toLocaleString() + ' — Flat Rate (Day Use)';
                    document.getElementById('downpaymentEstimate').textContent = Math.ceil(price * 0.30).toLocaleString();
                    document.getElementById('priceDisplay').style.display = 'block';
                } else {
                    document.getElementById('priceDisplay').style.display = 'none';
                }
            } else {
                const checkin = document.getElementById('checkin').value;
                if (checkin && price > 0) {
                    const start = new Date(checkin);
                    const end = new Date(getAutoCheckout(checkin));
                    const nights = Math.max(1, Math.ceil((end - start) / (1000 * 60 * 60 * 24)));
                    const total = price * nights;
                    document.getElementById('totalPrice').textContent = total.toLocaleString();
                    document.getElementById('priceBreakdown').textContent = '₱' + price.toLocaleString() + ' × ' + nights + ' night(s) — ' + category;
                    document.getElementById('downpaymentEstimate').textContent = Math.ceil(total * 0.30).toLocaleString();
                    document.getElementById('priceDisplay').style.display = 'block';
                } else {
                    document.getElementById('priceDisplay').style.display = 'none';
                }
            }
            checkDoubleBooking();
        }

        function toggleSchedule() {
            const content = document.getElementById('scheduleContent');
            const icon = document.getElementById('scheduleToggleIcon');
            if (content.style.display === 'none') {
                content.style.display = 'block';
                icon.classList.remove('bi-chevron-down');
                icon.classList.add('bi-chevron-up');
                if (!content.dataset.loaded) {
                    loadBookingSchedule();
                    content.dataset.loaded = 'true';
                }
            } else {
                content.style.display = 'none';
                icon.classList.remove('bi-chevron-up');
                icon.classList.add('bi-chevron-down');
            }
        }

        // ============================================
        // Auto-filter expired bookings
        // ============================================
        async function loadBookingSchedule() {
            try {
                const res = await fetch('/api/booking-schedule');
                const data = await res.json();
                
                // AUTO-FILTER: Remove expired bookings based on time rules
                const now = new Date();
                
                if (data.schedule) {
                    for (const [roomName, bookings] of Object.entries(data.schedule)) {
                        data.schedule[roomName] = bookings.filter(booking => {
                            const cinDate = new Date(booking.checkin);
                            const coutDate = new Date(booking.checkout);
                            
                            // COTTAGE = same-day booking (day-use)
                            // ROOM = overnight (different days)
                            const isCottage = cinDate.toDateString() === coutDate.toDateString();
                            
                            if (isCottage) {
                                // Cottage: remove after checkout time ends
                                return now < coutDate;
                            } else {
                                // Room: remove 22 hours after check-in
                                const hoursSinceCheckin = (now - cinDate) / (1000 * 60 * 60);
                                return hoursSinceCheckin < 22;
                            }
                        });
                        
                        // Clean up empty rooms from schedule
                        if (data.schedule[roomName].length === 0) {
                            delete data.schedule[roomName];
                        }
                    }
                }
                
                if (data.schedule) scheduleData = data.schedule;
                document.getElementById('scheduleLoading').style.display = 'none';

                if (!data.schedule || Object.keys(data.schedule).length === 0) {
                    document.getElementById('scheduleEmpty').style.display = 'block';
                    return;
                }

                const container = document.getElementById('scheduleData');
                let html = '';
                for (const [roomName, bookings] of Object.entries(data.schedule)) {
                    html += `<div class="schedule-room-group"><div class="schedule-room-name"><i class="bi bi-house-door-fill"></i> ${roomName}<span class="ms-auto badge bg-secondary rounded-pill" style="font-size: 0.7rem;">${bookings.length} booking${bookings.length > 1 ? 's' : ''}</span></div><div class="schedule-dates">`;
                    bookings.forEach(booking => {
                        const cinDate = new Date(booking.checkin);
                        const coutDate = new Date(booking.checkout);
                        const sameDay = cinDate.toDateString() === coutDate.toDateString();
                        
                        if (sameDay) {
                            const cinTime = cinDate.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true});
                            const coutTime = coutDate.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true});
                            const dateStr = cinDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                            html += `<div class="schedule-date-item"><div class="schedule-date-range"><i class="bi bi-calendar-x-fill text-danger"></i> ${dateStr} | ${cinTime} - ${coutTime}</div><div class="d-flex align-items-center gap-2"><span class="schedule-guests"><i class="bi bi-people-fill me-1"></i>${booking.guests} guest${booking.guests > 1 ? 's' : ''}</span><span class="schedule-badge-booked">Booked</span></div></div>`;
                        } else {
                            const checkin = cinDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                            const checkout = coutDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                            html += `<div class="schedule-date-item"><div class="schedule-date-range"><i class="bi bi-calendar-x-fill text-danger"></i> ${checkin} <i class="bi bi-arrow-right mx-1 text-muted"></i> ${checkout}</div><div class="d-flex align-items-center gap-2"><span class="schedule-guests"><i class="bi bi-people-fill me-1"></i>${booking.guests} guest${booking.guests > 1 ? 's' : ''}</span><span class="schedule-badge-booked">Booked</span></div></div>`;
                        }
                    });
                    html += `</div></div>`;
                }
                container.innerHTML = html;
                container.style.display = 'block';
            } catch (err) {
                console.error('Failed to load schedule:', err);
            }
        }

        function checkDoubleBooking() {
            const roomSelect = document.getElementById('roomType');
            const conflictAlert = document.getElementById('conflictAlert');
            const conflictMessage = document.getElementById('conflictMessage');
            const submitBtn = document.getElementById('submitBtn');

            conflictAlert.style.display = 'none';

            // Keep button disabled if email is NOT verified
            const isVerified = document.getElementById('emailVerified').value === 'true';
            if (!isVerified) {
                submitBtn.disabled = true;
            }

            if (!roomSelect.value) return true;

            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const category = selectedOption.getAttribute('data-category') || 'Room';
            const selectedRoom = roomSelect.value;
            const isCottage = (category === 'Cottage');
            const roomBookings = scheduleData[selectedRoom] || [];

            if (isCottage) {
                const bookingDate = document.getElementById('bookingDate').value;
                if (bookingDate && isMondayOrTuesday(bookingDate)) {
                    conflictMessage.innerHTML = '<strong>We are closed on Mondays and Tuesdays.</strong><br>Please choose a different date.';
                    conflictAlert.style.display = 'block';
                    submitBtn.disabled = true;
                    return false;
                }
            } else {
                const checkinVal = document.getElementById('checkin').value;
                if (checkinVal && isMondayOrTuesday(checkinVal)) {
                    conflictMessage.innerHTML = '<strong>Check-in cannot be on Monday or Tuesday.</strong><br>We are closed those days.';
                    conflictAlert.style.display = 'block';
                    submitBtn.disabled = true;
                    return false;
                }
            }

            if (isCottage) {
                const bookingDate = document.getElementById('bookingDate').value;
                if (!bookingDate) return true;
                for (const booking of roomBookings) {
                    const existingDate = new Date(booking.checkin).toISOString().split('T')[0];
                    if (existingDate === bookingDate) {
                        const dateStr = new Date(bookingDate).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                        conflictMessage.innerHTML = '<strong>"' + selectedRoom + '" is already booked on ' + dateStr + '.</strong><br>Please choose another cottage or a different date.';
                        conflictAlert.style.display = 'block';
                        submitBtn.disabled = true;
                        return false;
                    }
                }
            } else {
                const checkinVal = document.getElementById('checkin').value;
                if (!checkinVal) return true;
                const newStart = new Date(checkinVal);
                const newEnd = new Date(getAutoCheckout(checkinVal));
                for (const booking of roomBookings) {
                    const existingStart = new Date(booking.checkin);
                    const existingEnd = new Date(booking.checkout);
                    if (newStart < existingEnd && newEnd > existingStart) {
                        const inStr = existingStart.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                        const outStr = existingEnd.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
                        conflictMessage.innerHTML = '<strong>"' + selectedRoom + '" is already booked from ' + inStr + ' to ' + outStr + '.</strong><br>Please choose another room or different dates.';
                        conflictAlert.style.display = 'block';
                        submitBtn.disabled = true;
                        return false;
                    }
                }
            }

            // If we get here, no conflicts — but only unlock if verified
            if (isVerified) {
                submitBtn.disabled = false;
            }
            return true;
        }

        // ============================================
        // PAYMENT FLOW (Downpayment via GCash / Maya)
        // ============================================
        let activeHold = null; // { bookingId, holdExpiresAt }
        let holdCountdownTimer = null;

        function buildBookingPayload() {
            const roomSelect = document.getElementById('roomType');
            return {
                name: document.getElementById('name').value,
                email: document.getElementById('email').value,
                people: document.getElementById('people').value,
                roomType: roomSelect.value,
                requests: document.querySelector('textarea[name="requests"]').value,
                checkin: document.getElementById('checkin').value,
                bookingDate: document.getElementById('bookingDate').value,
                checkinTime: document.getElementById('checkinTime').value,
                checkoutTime: document.getElementById('checkoutTime').value
            };
        }

        // ============================================
        // FIX: previously any hiccup here (a network blip, or the
        // server returning a non-JSON error page) landed in the catch
        // block and always showed the same generic "Could not reserve
        // your slot" message, hiding the real reason. Now:
        //   1) res.json() is parsed defensively — if the response
        //      isn't valid JSON, we say so explicitly with the HTTP
        //      status instead of silently falling into a vague alert.
        //   2) a non-2xx response with a real server message shows
        //      that message instead of a generic one.
        // ============================================
        async function createHoldAndOpenPayment() {
            const payload = buildBookingPayload();
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            // FIX: this used to do
            //   submitBtn.innerHTML = '<span class="spinner-border ...">Reserving your slot...';
            // which wipes out the button's existing children —
            // #submitLockIcon and #submitBtnText. unlockSubmitButton()
            // (called right after the hold succeeds, to re-enable the
            // button for the downpayment step) looks those up by id and
            // sets their textContent/className, which threw "Cannot set
            // properties of null" once they no longer existed — breaking
            // the handoff into the payment modal. Updating the same two
            // elements in place instead keeps them alive.
            const submitLockIcon = document.getElementById('submitLockIcon');
            const submitBtnText = document.getElementById('submitBtnText');
            if (submitLockIcon) submitLockIcon.className = 'spinner-border spinner-border-sm me-2';
            if (submitBtnText) submitBtnText.textContent = 'Reserving your slot...';

            try {
                const res = await fetch('/api/create-hold', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                let data;
                try {
                    data = await res.json();
                } catch (parseErr) {
                    console.error('create-hold: non-JSON response', parseErr);
                    throw new Error(`Server returned an unexpected response (status ${res.status}). Please try again in a moment.`);
                }

                if (!res.ok || !data.success) {
                    alert('⚠️ ' + (data.message || `Could not reserve your slot (status ${res.status}). Please try again.`));
                    unlockSubmitButton();
                    return;
                }

                activeHold = { bookingId: data.bookingId, holdExpiresAt: data.holdExpiresAt };
                openPaymentModal(data);
                unlockSubmitButton();
            } catch (err) {
                console.error('create-hold error:', err);
                alert('⚠️ ' + (err.message || 'Could not reserve your slot. Please try again.'));
                unlockSubmitButton();
            }
        }

        function openPaymentModal(data) {
            document.getElementById('payAmount').textContent = Number(data.downpayment).toLocaleString();
            document.getElementById('payTotal').textContent = Number(data.totalPrice).toLocaleString();
            document.getElementById('referenceNumber').value = '';
            document.getElementById('receiptUpload').value = '';
            document.getElementById('paymentStatus').innerHTML = '';
            const payBtn = document.getElementById('submitPaymentBtn');
            payBtn.disabled = false;
            payBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> I\'ve Paid — Submit Proof';
            selectPaymentMethod('gcash');
            startHoldCountdown(new Date(data.holdExpiresAt));

            const modal = new bootstrap.Modal(document.getElementById('paymentModal'));
            modal.show();
        }

        // Toggles the "active" class on the tab buttons; the modal-scoped
        // CSS (#paymentModal .payment-method-tabs #gcashTab.active /
        // #mayaTab.active) is what colors them blue vs. green.
        function selectPaymentMethod(method) {
            document.getElementById('paymentMethodInput').value = method;
            document.getElementById('gcashPane').style.display = (method === 'gcash') ? 'block' : 'none';
            document.getElementById('mayaPane').style.display = (method === 'maya') ? 'block' : 'none';
            document.getElementById('gcashTab').classList.toggle('active', method === 'gcash');
            document.getElementById('mayaTab').classList.toggle('active', method === 'maya');
        }

        function startHoldCountdown(expiresAt) {
            clearInterval(holdCountdownTimer);
            const el = document.getElementById('holdCountdown');
            holdCountdownTimer = setInterval(() => {
                const diff = expiresAt - new Date();
                if (diff <= 0) {
                    clearInterval(holdCountdownTimer);
                    el.textContent = 'Expired';
                    document.getElementById('submitPaymentBtn').disabled = true;
                    document.getElementById('paymentStatus').innerHTML = '<span class="text-danger">Your reserved slot expired. Please close this window and book again.</span>';
                    return;
                }
                const m = Math.floor(diff / 60000);
                const s = Math.floor((diff % 60000) / 1000);
                el.textContent = `${m}:${String(s).padStart(2, '0')}`;
            }, 1000);
        }

        // ============================================
        // FIX: same defensive JSON parsing as createHoldAndOpenPayment,
        // so a server-side upload error or crash shows its real message
        // (or at least the HTTP status) instead of a generic one.
        // ============================================
        async function submitPaymentProof() {
            if (!activeHold) return;
            const method = document.getElementById('paymentMethodInput').value;
            const reference = document.getElementById('referenceNumber').value.trim();
            const receiptFile = document.getElementById('receiptUpload').files[0];
            const status = document.getElementById('paymentStatus');
            const btn = document.getElementById('submitPaymentBtn');

            if (!reference) {
                status.innerHTML = '<span class="text-danger">Please enter your GCash/Maya reference number.</span>';
                return;
            }

            const formData = new FormData();
            formData.append('bookingId', activeHold.bookingId);
            formData.append('paymentMethod', method);
            formData.append('referenceNumber', reference);
            if (receiptFile) formData.append('receipt', receiptFile);

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';

            try {
                const res = await fetch('/api/submit-payment', { method: 'POST', body: formData });

                let data;
                try {
                    data = await res.json();
                } catch (parseErr) {
                    console.error('submit-payment: non-JSON response', parseErr);
                    throw new Error(`Server returned an unexpected response (status ${res.status}). Please try again.`);
                }

                if (!res.ok || !data.success) {
                    status.innerHTML = `<span class="text-danger">${data.message || `Submission failed (status ${res.status}).`}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> I\'ve Paid — Submit Proof';
                    return;
                }

                clearInterval(holdCountdownTimer);
                activeHold = null;
                bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide();

                const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();

                setTimeout(() => window.location.href = '/booking', 3500);
            } catch (err) {
                console.error('submit-payment error:', err);
                status.innerHTML = `<span class="text-danger">${err.message || 'Server error. Please try again.'}</span>`;
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> I\'ve Paid — Submit Proof';
            }
        }

        async function cancelActiveHold() {
            if (!activeHold) return;
            try {
                await fetch('/api/cancel-hold/' + activeHold.bookingId, { method: 'DELETE' });
            } catch (err) {
                console.error('cancel-hold error:', err);
            }
            clearInterval(holdCountdownTimer);
            activeHold = null;
        }

        // ============================================
        // FORM SUBMIT HANDLER
        // ============================================

        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();

            // FIRST CHECK: Is email verified?
            const isVerified = document.getElementById('emailVerified').value === 'true';
            if (!isVerified) {
                alert('⚠️ Please verify your email address before submitting your booking.');
                return;
            }

            // SECOND CHECK: Any double booking conflicts?
            if (!checkDoubleBooking()) {
                alert('⚠️ This accommodation is already booked or the selected date is not available.');
                return;
            }

            const roomSelect = document.getElementById('roomType');
            const selectedOption = roomSelect.options[roomSelect.selectedIndex];
            const category = selectedOption.getAttribute('data-category') || 'Room';

            if (category === 'Cottage') {
                const bookingDate = document.getElementById('bookingDate').value;
                const checkinTime = document.getElementById('checkinTime').value;
                const checkoutTime = document.getElementById('checkoutTime').value;

                if (!bookingDate || !checkinTime || !checkoutTime) {
                    alert('⚠️ Please fill in the booking date, check-in time, and check-out time for the cottage.');
                    return;
                }
                if (timeToMinutes(checkinTime) >= timeToMinutes(checkoutTime)) {
                    alert('⚠️ Check-out time must be later than check-in time.');
                    return;
                }
                if (isMondayOrTuesday(bookingDate)) {
                    alert('⚠️ We are closed on Mondays and Tuesdays. Please choose a different date.');
                    return;
                }
            } else {
                const checkin = document.getElementById('checkin').value;
                if (!checkin) {
                    alert('⚠️ Please select a check-in date.');
                    return;
                }
                if (isMondayOrTuesday(checkin)) {
                    alert('⚠️ Check-in cannot be on Monday or Tuesday. We are closed those days.');
                    return;
                }
            }

            // All good — reserve the slot for 30 minutes and open the payment step
            createHoldAndOpenPayment();
        });

        // Load schedule on page load
        loadBookingSchedule().then(() => {
            document.getElementById('scheduleContent').dataset.loaded = 'true';
        });
    </script>
</body>
</html>
