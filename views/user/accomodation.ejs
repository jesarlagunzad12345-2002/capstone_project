<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accommodations - KML Mountain Resort</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/accomodation.css">
    <link rel="icon" type="image/png" sizes="32x32" href="img/logo.jpg">
</head>
<body>

    <header class="fixed-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link" href="/booking">BOOKING</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input" placeholder="Search rooms...">
                        <a href="/booking" class="btn book-btn">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- SPACER DIV - Pushes all content below the fixed navbar -->
    <div class="navbar-spacer"></div>

    <main class="container py-5">
        <section class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 fw-bold mb-4">OUR ACCOMMODATIONS</h1>
                <p class="lead text-muted">
                    Discover a seamless blend of digital convenience and secluded luxury. 
                    Each sanctuary is designed for precise tranquility.
                </p>
            </div>
        </section>

        <section class="accommodations-wrapper">
            <div id="loadingState" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted mt-2">Loading accommodations...</p>
            </div>
        </section>
    </main>

    <footer class="text-center py-4">
        <p class="mb-0">&copy; 2026 KML Mountain Resort. All rights reserved.</p>
    </footer>

    <div class="modal fade" id="roomModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 overflow-hidden">
                <div class="modal-header border-0 p-0 position-relative">
                    <img id="modalImage" src="" alt="Room Image" class="w-100" style="height: 300px; object-fit: cover;">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(0,0,0,0.5); padding: 0.75rem; border-radius: 50%;"></button>
                </div>
                <div class="modal-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-primary mb-2" id="modalBadge">Premium</span>
                            <h3 class="modal-title fw-bold mb-0" id="modalTitle">Room Title</h3>
                        </div>
                        <div class="text-end">
                            <p class="h4 fw-bold text-primary mb-0" id="modalPrice">₱0</p>
                            <small class="text-muted">per night</small>
                        </div>
                    </div>
                    
                    <p class="text-muted mb-4" id="modalDescription">Description goes here...</p>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <h6 class="fw-bold mb-3">Room Features</h6>
                            <ul class="list-unstyled feature-list" id="modalFeatures">
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold mb-3">Amenities</h6>
                            <ul class="list-unstyled feature-list" id="modalAmenities">
                            </ul>
                        </div>
                    </div>

                    <div class="d-flex gap-3 pt-3 border-top">
                        <a href="/booking" id="modalBookBtn" class="btn btn-primary btn-custom-primary flex-fill">Reserve Now</a>
                        <button type="button" class="btn btn-outline-secondary btn-custom-outline" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/accomodation.js"></script>
</body>
</html>