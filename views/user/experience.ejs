<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guest Experience | KML Mountain Resort</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="css/experience.css">
    <link rel="icon" type="image/png" sizes="32x32" href="img/logo.jpg">
    
    <!-- EmailJS SDK -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link" href="/booking">BOOKING</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input invisible" placeholder="Search activities...">
                        <a href="/booking" class="btn book-btn">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-5">
        <!-- Hero Section -->
        <section class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 fw-bold mb-4">YOUR JOURNEY TO TRANQUILITY</h1>
                <p class="lead text-muted">At KML, we've mastered the art of the 'Digital Detox'—providing a secluded sanctuary without sacrificing the modern conveniences you rely on.</p>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="text-center mb-5 section-title">A Day at KML</h2>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>08:00 AM — Morning Refresh</h3>
                        <p>Morning RefreshGentle morning stretch on the terrace or a quiet stroll through nature. Begin your day with crisp mountain air, fresh coffee, and uninterrupted quiet before your day unfolds</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>12:00 PM — Seamless Connectivity</h3>
                        <p>Whether you're checking in or catching up on work, our digital infrastructure ensures you stay connected while surrounded by nature. Enjoy high-speed Wi-Fi even in our most secluded cabins.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>06:00 PM — Al Fresco Dining</h3>
                        <p>Savor a meal under the open sky. Our outdoor dining experiences are designed to let you breathe in the mountain air while enjoying local delicacies.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>09:00 PM — Stargazing Experience</h3>
                        <p>End your night on our observation deck. With zero light pollution, the Western Visayas sky reveals the cosmos in stunning detail.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="testimonial-section mb-5">
            <h2 class="text-center mb-4 section-title">What Our Guests Say</h2>
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <blockquote class="testimonial-quote">
                        <p>"I felt like I was entering a different world, yet I could still join my Zoom calls without a hitch!"</p>
                        <cite>— Happy Traveler</cite>
                    </blockquote>
                </div>
            </div>
        </section>

        <section class="cta-section text-center">
            <h2 class="mb-3">Ready to experience KML?</h2>
            <p class="mb-4">Your sanctuary is just a click away.</p>
            <a href="/booking" class="btn btn-lg cta-btn">Reserve Your Stay</a>
        </section>

        <!-- ==================== CANCELLATION SECTION ==================== -->
        <section class="cancellation-section" id="cancelBooking">
            <div class="text-center mb-4">
                <h2 class="section-title">Cancel Your Booking</h2>
                <p class="text-muted">Need to change your plans? Handle it here.</p>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <form id="cancelForm" class="cancel-form">
                        
                        <!-- Status selector -->
                        <div class="mb-3">
                            <label class="form-label">Booking Status</label>
                            <select id="bookingStatus" class="form-select">
                                <option value="pending">⏳ Not Yet Approved (Pending)</option>
                                <option value="approved">✅ Already Approved</option>
                            </select>
                        </div>

                        <!-- Dynamic note based on status -->
                        <div id="statusNote" class="status-note pending-note">
                            <strong>Instant Cancel:</strong> Your booking will be cancelled immediately and removed from our system.
                        </div>

                        <!-- Mismatch warning message -->
                        <div id="statusMismatchMsg" class="alert alert-warning d-none mt-2"></div>

                        <!-- Check-in Date -->
                        <div class="mb-3">
                            <label class="form-label">Check-in Date</label>
                            <input type="date" id="cancelCheckin" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" id="cancelName" class="form-control" placeholder="Juan Dela Cruz" required>
                        </div>

                        <!-- Email + Verification -->
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <div class="input-group">
                                <input type="email" id="cancelEmail" class="form-control" placeholder="juan@email.com" required onchange="resetVerification()">
                                <button type="button" class="btn btn-primary" id="sendCodeBtn" onclick="sendVerificationCode()">
                                    <i class="bi bi-send me-1"></i> Send Code
                                </button>
                            </div>
                            <div id="emailStatus" class="form-text mt-1"></div>
                        </div>

                        <!-- Verification Code Input -->
                        <div class="mb-3" id="codeSection" style="display: none;">
                            <label class="form-label fw-semibold">Verification Code</label>
                            <div class="input-group">
                                <input type="text" id="verificationCodeInput" class="form-control" placeholder="Enter 6-digit code" maxlength="6">
                                <button type="button" class="btn btn-success" id="verifyBtn" onclick="verifyCode()">
                                    <i class="bi bi-check-circle me-1"></i> Verify
                                </button>
                            </div>
                            <div id="codeStatus" class="form-text mt-1"></div>
                        </div>

                        <!-- Verified Banner -->
                        <div class="mb-3" id="verifiedBanner" style="display: none;">
                            <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                                <i class="bi bi-shield-check fs-4 me-3"></i>
                                <div>
                                    <strong>Email Verified!</strong><br>
                                    <span class="small">You can now proceed with cancellation.</span>
                                </div>
                            </div>
                        </div>

                        <!-- Hidden tracker -->
                        <input type="hidden" id="emailVerified" value="false">

                        <div class="mb-4">
                            <label class="form-label">Reason (Optional)</label>
                            <textarea id="cancelReason" class="form-control" rows="3" placeholder="Change of plans, emergency, etc."></textarea>
                        </div>

                        <!-- Submit button: LOCKED until verified -->
                        <!-- Base classes stay, only color/text changes via JS -->
                        <button type="submit" class="btn cancel-btn w-100" id="cancelSubmitBtn" disabled>
                            <i class="bi bi-lock-fill me-2" id="submitIcon"></i>
                            <span id="submitText">Verify Email to Cancel</span>
                        </button>
                    </form>
                </div>
            </div>
        </section>
        <!-- ==================== END CANCELLATION SECTION ==================== -->

    </main>

    <footer class="text-center py-4">
        <p class="mb-0">&copy; 2026 KML Mountain Resort. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ==================== CANCELLATION LOGIC ==================== -->
    <script>
        // ============================================
        // 1. INITIALIZE CANCELLATION EMAILJS ACCOUNT
        // ============================================
        (function() { 
            emailjs.init({ publicKey: "EfvIkV0UtUXjEGOgu" }); 
        })();

        const TEMPLATE_ID = 'template_kule5md';
        const ADMIN_EMAIL = 'kmlresort@gmail.com';

        // DOM refs
        const cancelForm   = document.getElementById('cancelForm');
        const statusSelect = document.getElementById('bookingStatus');
        const statusNote   = document.getElementById('statusNote');
        const submitBtn    = document.getElementById('cancelSubmitBtn');
        const submitText   = document.getElementById('submitText');
        const submitIcon   = document.getElementById('submitIcon');
        const mismatchMsg  = document.getElementById('statusMismatchMsg');

        // ============================================
        // 2. BUTTON STATE MANAGER (FIXED)
        // ============================================
        // 🐛 BUG FIX: Old code used className = '...' which wiped all classes
        // and caused flickering/glitches when switching options.
        // Now we use classList to ONLY swap the color class safely.

        function setButtonState(state) {
            // state = 'locked' | 'pending' | 'approved'
            
            // Always keep these base classes: btn, cancel-btn, w-100
            // Only remove/add Bootstrap color classes
            
            if (state === 'locked') {
                submitBtn.disabled = true;
                submitText.textContent = 'Verify Email to Cancel';
                submitIcon.className = 'bi bi-lock-fill me-2';
                
                submitBtn.classList.remove('btn-danger', 'btn-warning');
                submitBtn.classList.add('btn-secondary');
                return;
            }
            
            submitBtn.disabled = false;
            submitIcon.className = 'bi bi-check-circle-fill me-2';
            
            if (state === 'pending') {
                submitText.textContent = 'Cancel My Booking';
                submitBtn.classList.remove('btn-secondary', 'btn-warning');
                submitBtn.classList.add('btn-danger');
            } else {
                submitText.textContent = 'Request Cancellation';
                submitBtn.classList.remove('btn-secondary', 'btn-danger');
                submitBtn.classList.add('btn-warning');
            }
        }

        function refreshButton() {
            const isVerified = document.getElementById('emailVerified').value === 'true';
            if (!isVerified) {
                setButtonState('locked');
            } else {
                setButtonState(statusSelect.value); // 'pending' or 'approved'
            }
        }

        function updateStatusNote(status) {
            if (status === 'pending') {
                statusNote.className  = 'status-note pending-note';
                statusNote.innerHTML  = '<strong>Instant Cancel:</strong> Your booking will be cancelled immediately and removed from our system.';
            } else {
                statusNote.className  = 'status-note approved-note';
                statusNote.innerHTML  = '<strong>Request Only:</strong> This will notify our admin team. Please wait for a confirmation email once your request is processed.';
            }
        }

        // When user changes Pending / Approved dropdown
        statusSelect.addEventListener('change', function() {
            updateStatusNote(this.value);
            refreshButton();
        });

        // ============================================
        // 3. EMAIL VERIFICATION FUNCTIONS
        // ============================================

        function resetVerification() {
            document.getElementById('emailVerified').value = 'false';
            document.getElementById('codeSection').style.display = 'none';
            document.getElementById('verifiedBanner').style.display = 'none';
            document.getElementById('emailStatus').innerHTML = '';
            document.getElementById('codeStatus').innerHTML = '';
            document.getElementById('verificationCodeInput').value = '';
            
            const sendBtn = document.getElementById('sendCodeBtn');
            sendBtn.style.display = 'block';
            sendBtn.disabled = false;
            sendBtn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
            
            document.getElementById('cancelEmail').readOnly = false;
            refreshButton();
        }

        async function sendVerificationCode() {
            const emailInput = document.getElementById('cancelEmail');
            const email = emailInput.value.trim();
            const btn = document.getElementById('sendCodeBtn');
            const status = document.getElementById('emailStatus');

            if (!email || !email.includes('@') || !email.includes('.')) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Please enter a valid email address.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...';

            try {
                // Ask server to generate code
                const res = await fetch('/api/request-verification-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const data = await res.json();

                if (!data.success) {
                    status.innerHTML = `<span class="text-danger">${data.message}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
                    return;
                }

                console.log("✅ Server generated code:", data.code);

                // 🔑 SWITCH to verification EmailJS account
                emailjs.init({ publicKey: "nerxCEIOup7atDE6q" });

                // Send code via EmailJS
                await emailjs.send('service_p0pcn2h', 'template_i8uz2wj', {
                    email: email,
                    verification_code: data.code,
                    user_name: document.getElementById('cancelName').value || 'Guest'
                });

                // Show code input
                document.getElementById('codeSection').style.display = 'block';
                status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Code sent! Check your inbox (and spam folder).</span>';

                // 60-second countdown
                let seconds = 60;
                btn.innerHTML = `Resend (${seconds}s)`;
                const timer = setInterval(() => {
                    seconds--;
                    if (seconds > 0) {
                        btn.innerHTML = `Resend (${seconds}s)`;
                    } else {
                        clearInterval(timer);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-send me-1"></i> Resend Code';
                    }
                }, 1000);

            } catch (err) {
                console.error('EmailJS Error:', err);
                status.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Failed to send email. Please try again.</span>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-1"></i> Send Code';
            }
        }

        async function verifyCode() {
            const email = document.getElementById('cancelEmail').value.trim();
            const code = document.getElementById('verificationCodeInput').value.trim();
            const btn = document.getElementById('verifyBtn');
            const status = document.getElementById('codeStatus');

            if (!code || code.length !== 6 || isNaN(code)) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Please enter the 6-digit code.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking...';

            try {
                const res = await fetch('/api/verify-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, code: code })
                });
                const data = await res.json();

                if (data.success) {
                    // ✅ VERIFIED!
                    document.getElementById('emailVerified').value = 'true';
                    document.getElementById('cancelEmail').readOnly = true;
                    document.getElementById('codeSection').style.display = 'none';
                    document.getElementById('sendCodeBtn').style.display = 'none';

                    // Show green banner
                    document.getElementById('verifiedBanner').style.display = 'block';

                    status.innerHTML = '<span class="text-success"><i class="bi bi-shield-check me-1"></i>Email verified! You can now proceed.</span>';
                    document.getElementById('cancelEmail').classList.add('is-valid');

                    // 🔓 Unlock button with correct style for current status
                    refreshButton();

                } else {
                    status.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>${data.message}</span>`;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Verify';
                }
            } catch (err) {
                console.error('❌ Verify error:', err);
                status.innerHTML = '<span class="text-danger">Server error. Please refresh and try again.</span>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Verify';
            }
        }

        // ============================================
        // 4. FORM SUBMIT HANDLER
        // ============================================
        cancelForm.addEventListener('submit', async function(e) {
            e.preventDefault();

            // 🛡️ Must be verified
            const isVerified = document.getElementById('emailVerified').value === 'true';
            if (!isVerified) {
                alert('⚠️ Please verify your email address before submitting a cancellation.');
                return;
            }

            const status      = statusSelect.value;
            const name        = document.getElementById('cancelName').value.trim();
            const email       = document.getElementById('cancelEmail').value.trim();
            const checkin     = document.getElementById('cancelCheckin').value;
            const reason      = document.getElementById('cancelReason').value.trim() || 'No reason provided';

            mismatchMsg.className = 'alert alert-warning d-none mt-2';

            const originalHTML = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitText.textContent = 'Processing...';
            submitIcon.className = 'spinner-border spinner-border-sm me-2';

            try {
                // STEP 1: Verify booking status first (no delete)
                const verifyRes = await fetch('/cancel-booking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, checkin: checkin, verifyOnly: true })
                });
                
                const verifyResult = await verifyRes.json();
                
                if (!verifyResult.success) {
                    alert('❌ ' + verifyResult.message);
                    refreshButton();
                    return;
                }
                
                const actualStatus = verifyResult.status === 'approved' ? 'approved' : 'pending';

                // CHECK: Did user pick the wrong option?
                if (status === 'pending' && actualStatus === 'approved') {
                    mismatchMsg.textContent = '⚠️ This option is for pending bookings only. Your booking is already approved. Please select "Already Approved" above.';
                    mismatchMsg.className = 'alert alert-warning mt-2';
                    refreshButton();
                    return;
                }

                if (status === 'approved' && actualStatus === 'pending') {
                    mismatchMsg.textContent = '⚠️ This option is for approved bookings only. Your booking is still pending. Please select "Not Yet Approved (Pending)" above.';
                    mismatchMsg.className = 'alert alert-warning mt-2';
                    refreshButton();
                    return;
                }

                // STEP 2: Status matches — proceed with cancellation
                const response = await fetch('/cancel-booking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, checkin: checkin })
                });
                
                const result = await response.json();
                
                if (!result.success) {
                    alert('❌ ' + result.message);
                    refreshButton();
                    return;
                }
                
                const bookingId = result.bookingId;
                const room      = result.roomType || 'Standard';

                // STEP 3: Send emails
                emailjs.init({ publicKey: "EfvIkV0UtUXjEGOgu" });

                const adminParams = {
                    to_email: ADMIN_EMAIL,
                    user_name: name,
                    booking_id: bookingId,
                    room_type: room,
                    checkin_date: checkin,
                    status_type: status === 'pending' ? 'Pending Booking' : 'Approved Booking',
                    cancel_reason: reason,
                    message: status === 'pending'
                        ? `[AUTO-CANCEL] Pending booking #${bookingId} was cancelled by ${name}. Room: ${room}, Check-in: ${checkin}, Reason: ${reason}`
                        : `[CANCEL REQUEST] ${name} wants to cancel approved booking #${bookingId}. Room: ${room}, Check-in: ${checkin}, Reason: ${reason}`
                };

                if (status === 'pending') {
                    const customerParams = {
                        to_email: email,
                        user_name: name,
                        booking_id: bookingId,
                        room_type: room,
                        checkin_date: checkin,
                        status_type: 'Pending Booking',
                        cancel_reason: reason,
                        message: 'Your booking has been successfully cancelled. We hope to welcome you again in the future!'
                    };
                    await emailjs.send('service_kmlresort', TEMPLATE_ID, customerParams);
                    console.log('✅ Customer email sent to:', email);
                }

                await emailjs.send('service_kmlresort', TEMPLATE_ID, adminParams);
                console.log('✅ Admin email sent to:', ADMIN_EMAIL);

                if (status === 'pending') {
                    alert('✅ Your booking has been cancelled successfully!\n\nA confirmation email has been sent to ' + email);
                } else {
                    alert('✅ Your cancellation request has been submitted to our admin team!\n\nYou will receive a confirmation email once your request is processed.');
                }

                cancelForm.reset();
                resetVerification();
                updateStatusNote('pending');

            } catch (err) {
                console.error('❌ Error:', err);
                alert('❌ Something went wrong. Please try again or contact us directly.');
            } finally {
                refreshButton();
            }
        });

        // Init button on page load
        refreshButton();
    </script>

</body>
</html>