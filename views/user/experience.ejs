<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guest Experience | KML Mountain Resort</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/experience.css">
    <link rel="icon" type="image/png" sizes="32x32" href="img/logo.jpg">
    
    <!-- EmailJS SDK -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar py-3 px-4">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/dashboard">KML RESORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/dashboard">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" href="/location">LOCATION</a></li>
                        <li class="nav-item"><a class="nav-link" href="/accomodation">ACCOMMODATION</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/experience">EXPERIENCE</a></li>
                        <li class="nav-item"><a class="nav-link" href="/gallery">GALLERY</a></li>
                        <li class="nav-item"><a class="nav-link" href="/amenities">AMENITIES</a></li>
                        <li class="nav-item"><a class="nav-link" href="/booking">BOOKING</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 header-actions">
                        <input type="text" class="form-control search-input invisible" placeholder="Search activities...">
                        <a href="/booking" class="btn book-btn">Book Now</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-5">
        <!-- Hero Section -->
        <section class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 fw-bold mb-4">YOUR JOURNEY TO TRANQUILITY</h1>
                <p class="lead text-muted">At KML, we've mastered the art of the 'Digital Detox'—providing a secluded sanctuary without sacrificing the modern conveniences you rely on.</p>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="text-center mb-5 section-title">A Day at KML</h2>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>08:00 AM — The Morning Ascent</h3>
                        <p>Start your day with our signature 12-minute hike from the main road. It's a brief, refreshing trek that transitions you from the noise of the world to our mountain sanctuary.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>12:00 PM — Seamless Connectivity</h3>
                        <p>Whether you're checking in or catching up on work, our digital infrastructure ensures you stay connected while surrounded by nature. Enjoy high-speed Wi-Fi even in our most secluded cabins.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>06:00 PM — Al Fresco Dining</h3>
                        <p>Savor a meal under the open sky. Our outdoor dining experiences are designed to let you breathe in the mountain air while enjoying local delicacies.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="experience-card h-100">
                        <h3>09:00 PM — Stargazing Experience</h3>
                        <p>End your night on our observation deck. With zero light pollution, the Western Visayas sky reveals the cosmos in stunning detail.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="testimonial-section mb-5">
            <h2 class="text-center mb-4 section-title">What Our Guests Say</h2>
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <blockquote class="testimonial-quote">
                        <p>"The 12-minute hike was the perfect way to start my stay. I felt like I was entering a different world, yet I could still join my Zoom calls without a hitch!"</p>
                        <cite>— Happy Traveler</cite>
                    </blockquote>
                </div>
            </div>
        </section>

        <section class="cta-section text-center">
            <h2 class="mb-3">Ready to experience KML?</h2>
            <p class="mb-4">Your sanctuary is just a click away.</p>
            <a href="/booking" class="btn btn-lg cta-btn">Reserve Your Stay</a>
        </section>

        <!-- ==================== CANCELLATION SECTION ==================== -->
        <section class="cancellation-section" id="cancelBooking">
            <div class="text-center mb-4">
                <h2 class="section-title">Cancel Your Booking</h2>
                <p class="text-muted">Need to change your plans? Handle it here.</p>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <form id="cancelForm" class="cancel-form">
                        
                        <!-- Status selector -->
                        <div class="mb-3">
                            <label class="form-label">Booking Status</label>
                            <select id="bookingStatus" class="form-select">
                                <option value="pending">⏳ Not Yet Approved (Pending)</option>
                                <option value="approved">✅ Already Approved</option>
                            </select>
                        </div>

                        <!-- Dynamic note based on status -->
                        <div id="statusNote" class="status-note pending-note">
                            <strong>Instant Cancel:</strong> Your booking will be cancelled immediately and removed from our system.
                        </div>

                        <!-- NEW: Mismatch warning message -->
                        <div id="statusMismatchMsg" class="alert alert-warning d-none mt-2"></div>

                        <!-- Check-in Date -->
                        <div class="mb-3">
                            <label class="form-label">Check-in Date</label>
                            <input type="date" id="cancelCheckin" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" id="cancelName" class="form-control" placeholder="Juan Dela Cruz" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" id="cancelEmail" class="form-control" placeholder="juan@email.com" required>
                        </div>

                        <!-- ROOM TYPE REMOVED — fetched from database -->

                        <div class="mb-4">
                            <label class="form-label">Reason (Optional)</label>
                            <textarea id="cancelReason" class="form-control" rows="3" placeholder="Change of plans, emergency, etc."></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger cancel-btn" id="cancelSubmitBtn">
                            Cancel My Booking
                        </button>
                    </form>
                </div>
            </div>
        </section>
        <!-- ==================== END CANCELLATION SECTION ==================== -->

    </main>

    <footer class="text-center py-4">
        <p class="mb-0">&copy; 2026 KML Mountain Resort. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ==================== CANCELLATION LOGIC ==================== -->
    <script>
        // Initialize EmailJS
        (function() { 
            emailjs.init({ publicKey: "EfvIkV0UtUXjEGOgu" }); 
        })();

        const TEMPLATE_ID = 'template_kule5md';
        const ADMIN_EMAIL = 'kmlresort@gmail.com';

        const cancelForm   = document.getElementById('cancelForm');
        const statusSelect = document.getElementById('bookingStatus');
        const statusNote   = document.getElementById('statusNote');
        const submitBtn    = document.getElementById('cancelSubmitBtn');
        const mismatchMsg  = document.getElementById('statusMismatchMsg');

        function updateCancelUI(status) {
            if (status === 'pending') {
                submitBtn.textContent = 'Cancel My Booking';
                submitBtn.className   = 'btn btn-danger cancel-btn';
                statusNote.className  = 'status-note pending-note';
                statusNote.innerHTML  = '<strong>Instant Cancel:</strong> Your booking will be cancelled immediately and removed from our system.';
            } else {
                submitBtn.textContent = 'Request Cancellation';
                submitBtn.className   = 'btn btn-warning cancel-btn';
                statusNote.className  = 'status-note approved-note';
                statusNote.innerHTML  = '<strong>Request Only:</strong> This will notify our admin team. Please wait for a confirmation email once your request is processed.';
            }
        }

        statusSelect.addEventListener('change', function() {
            updateCancelUI(this.value);
        });

        cancelForm.addEventListener('submit', async function(e) {
            e.preventDefault();

            const status      = statusSelect.value;
            const name        = document.getElementById('cancelName').value.trim();
            const email       = document.getElementById('cancelEmail').value.trim();
            const checkin     = document.getElementById('cancelCheckin').value;
            const reason      = document.getElementById('cancelReason').value.trim() || 'No reason provided';

            // Hide any previous mismatch message
            mismatchMsg.className = 'alert alert-warning d-none mt-2';

            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Processing...';

            try {
                // ============================================
                // STEP 1: Verify booking status first (no delete)
                // ============================================
                const verifyRes = await fetch('/cancel-booking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, checkin: checkin, verifyOnly: true })
                });
                
                const verifyResult = await verifyRes.json();
                
                if (!verifyResult.success) {
                    alert('❌ ' + verifyResult.message);
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                    return;
                }
                
                // 'approved' or anything else = pending
                const actualStatus = verifyResult.status === 'approved' ? 'approved' : 'pending';

                // ============================================
                // CHECK: Did the user pick the wrong option?
                // ============================================
                if (status === 'pending' && actualStatus === 'approved') {
                    mismatchMsg.textContent = '⚠️ This option is for pending bookings only. Your booking is already approved. Please select "Already Approved" above.';
                    mismatchMsg.className = 'alert alert-warning mt-2';
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                    return;
                }

                if (status === 'approved' && actualStatus === 'pending') {
                    mismatchMsg.textContent = '⚠️ This option is for approved bookings only. Your booking is still pending. Please select "Not Yet Approved (Pending)" above.';
                    mismatchMsg.className = 'alert alert-warning mt-2';
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                    return;
                }

                // ============================================
                // STEP 2: Status matches — proceed with cancellation
                // ============================================
                const response = await fetch('/cancel-booking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, checkin: checkin })
                });
                
                const result = await response.json();
                
                if (!result.success) {
                    alert('❌ ' + result.message);
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                    return;
                }
                
                // Get room type from DATABASE response
                const bookingId = result.bookingId;
                const room      = result.roomType || 'Standard';

                // ============================================
                // STEP 3: Send emails
                // ============================================
                
                const adminParams = {
                    to_email: ADMIN_EMAIL,
                    user_name: name,
                    booking_id: bookingId,
                    room_type: room,
                    checkin_date: checkin,
                    status_type: status === 'pending' ? 'Pending Booking' : 'Approved Booking',
                    cancel_reason: reason,
                    message: status === 'pending'
                        ? `[AUTO-CANCEL] Pending booking #${bookingId} was cancelled by ${name}. Room: ${room}, Check-in: ${checkin}, Reason: ${reason}`
                        : `[CANCEL REQUEST] ${name} wants to cancel approved booking #${bookingId}. Room: ${room}, Check-in: ${checkin}, Reason: ${reason}`
                };

                if (status === 'pending') {
                    const customerParams = {
                        to_email: email,
                        user_name: name,
                        booking_id: bookingId,
                        room_type: room,
                        checkin_date: checkin,
                        status_type: 'Pending Booking',
                        cancel_reason: reason,
                        message: 'Your booking has been successfully cancelled. We hope to welcome you again in the future!'
                    };
                    await emailjs.send('service_kmlresort', TEMPLATE_ID, customerParams);
                    console.log('✅ Customer email sent to:', email);
                }

                await emailjs.send('service_kmlresort', TEMPLATE_ID, adminParams);
                console.log('✅ Admin email sent to:', ADMIN_EMAIL);

                if (status === 'pending') {
                    alert('✅ Your booking has been cancelled successfully!\n\nA confirmation email has been sent to ' + email);
                } else {
                    alert('✅ Your cancellation request has been submitted to our admin team!\n\nYou will receive a confirmation email once your request is processed.');
                }

                cancelForm.reset();
                updateCancelUI('pending');
                mismatchMsg.className = 'alert alert-warning d-none mt-2'; // hide warning on reset

            } catch (err) {
                console.error('❌ Error:', err);
                alert('❌ Something went wrong. Please try again or contact us directly.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = statusSelect.value === 'pending' 
                    ? 'Cancel My Booking' 
                    : 'Request Cancellation';
            }
        });
    </script>

</body>
</html>