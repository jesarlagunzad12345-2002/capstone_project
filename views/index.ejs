  <section id="booking" class="full-slide">
    <div class="container">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
          <div class="col-md-4 p-5 text-white d-flex flex-column justify-content-between" style="background-color: #ff8c00 !important;">
            <div>
              <h3 class="fw-bold">Book Your Stay</h3>
              <p>Secure your sanctuary in the mountains today.</p>
            </div>
            <div class="small mt-4">
              <p class="mb-1"><i class="bi bi-telephone me-2"></i> +1 (555) 123-4567</p>
              <p class="mb-0"><i class="bi bi-envelope me-2"></i> reservations@kml.com</p>
            </div>
          </div>
          
          <div class="col-md-8 p-5 bg-white booking-right-col">
            
            <% if (message) { %>
              <div class="alert alert-success alert-dismissible fade show floating-alert" role="alert">
                <strong>Success!</strong> <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>

            <div class="booking-form-wrapper">
              <form action="/create" method="POST" class="row g-3">
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Full Name</label>
                  <input name="name" type="text" required placeholder="Guest Name" class="form-control bg-light border-0 py-2">
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Email Address</label>
                  <input name="email" type="email" required placeholder="email@example.com" class="form-control bg-light border-0 py-2">
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-bold">Check-in</label>
                  <input name="checkin" type="date" required class="form-control bg-light border-0 py-2">
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Check-out</label>
                  <input name="checkout" type="date" required class="form-control bg-light border-0 py-2">
                </div>

                <div class="col-12">
                  <label class="form-label small fw-bold">Guests</label>
                  <select name="people" class="form-select bg-light border-0 py-2">
                    <option value="1">1 Adult</option>
                    <option value="2">2 Adults</option>
                    <option value="3">3 Adults</option>
                    <option value="4">4 Adults</option>
                  </select>
                </div>

                <div class="col-12 mt-2">
                  <label class="form-label small fw-bold">Room Preference</label>
                  
                  <div class="room-card border rounded-3 p-3 mb-2 d-flex align-items-center justify-content-between">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="roomType" id="micro" value="Micro Apartment" checked>
                      <label class="form-check-label ms-2" for="micro">
                        <span class="fw-bold d-block">Micro Apartment</span>
                        <small class="text-muted">1-2 Guests • Studio Layout</small>
                      </label>
                    </div>
                    <span class="fw-bold text-warning">$240<small class="text-muted">/night</small></span>
                  </div>

                  <div class="room-card border rounded-3 p-3 d-flex align-items-center justify-content-between">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="roomType" id="luxury" value="Luxury Suite">
                      <label class="form-check-label ms-2" for="luxury">
                        <span class="fw-bold d-block">Luxury Suite</span>
                        <small class="text-muted">2-4 Guests • Mountain View</small>
                      </label>
                    </div>
                    <span class="fw-bold text-warning">$480<small class="text-muted">/night</small></span>
                  </div>
                </div>

                <div class="col-12">
                  <button type="submit" class="btn btn-dark w-100 py-3 rounded-3 fw-bold mt-2">Check Availability →</button>
                </div>
              </form>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

