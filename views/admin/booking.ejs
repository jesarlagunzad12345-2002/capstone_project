<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KML Mountain Resort | Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/booking_admin.css">
    <link rel="icon" type="image/jpeg" href="img/logo.jpg">

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
    <script type="text/javascript">
      (function() { emailjs.init({ publicKey: "EfvIkV0UtUXjEGOgu" }); })();

      function formatDate(dateString) {
          if (!dateString) return "N/A";
          const date = new Date(dateString);
          return isNaN(date) ? dateString : date.toLocaleDateString('en-US', { 
              month: 'short', 
              day: 'numeric', 
              year: 'numeric' 
          });
      }

      window.onload = function() {
        const shouldTrigger = "<%= triggerApprove %>";
        
        if (shouldTrigger === "true") {
            const toastElement = document.getElementById('approveToast');
            const toast = new bootstrap.Toast(toastElement);
            toast.show();

            const bellDot = document.getElementById('bellDot');
            if (bellDot) bellDot.style.display = 'block';

            const gEmail = "<%= guestEmail %>";
            const gName = "<%= guestName %>";

            if (gEmail && gEmail !== "null" && gEmail !== "") {
              const specialRequests = "<%= guestRequests %>" || "None";
              
              const templateParams = {
                to_email: gEmail,
                user_name: gName,
                room_type: "<%= guestRoom %>" || "Standard Apartment",
                checkin_date: formatDate("<%= guestIn %>"),
                checkout_date: formatDate("<%= guestOut %>"),
                guests_count: "<%= guestPeople %>",
                special_requests: specialRequests,
                message: "Your reservation at KML Resort is officially confirmed!"
              };

              emailjs.send('service_kmlresort', 'template_klmresort1', templateParams)
                .then(() => console.log("Confirmation email sent."))
                .catch((err) => console.error("Email Error: ", err));
            }
        }
      };

      function clearNotifications() {
          const bellDot = document.getElementById('bellDot');
          if (bellDot) bellDot.style.display = 'none';
      }

      // ============================================
      // DYNAMIC GUEST DROPDOWN: Updates based on room capacity
      // Each room has a data-occupancy attribute with max guests
      // ============================================
      function updateGuestDropdown(bookingId) {
          const roomSelect = document.getElementById('roomSelect' + bookingId);
          const guestSelect = document.getElementById('guestSelect' + bookingId);
          
          if (!roomSelect || !guestSelect) return;
          
          // Get the selected option's max occupancy
          const selectedOption = roomSelect.options[roomSelect.selectedIndex];
          const maxOccupancy = parseInt(selectedOption.getAttribute('data-occupancy')) || 1;
          const currentValue = parseInt(guestSelect.value) || 1;
          
          // Clear existing options
          guestSelect.innerHTML = '';
          
          // Build new options from 1 to max occupancy
          for (let i = 1; i <= maxOccupancy; i++) {
              const option = document.createElement('option');
              option.value = i;
              option.textContent = i === 1 ? '1 Adult' : i + ' Adults';
              
              // Keep the current selection if it's still valid
              if (i === currentValue) {
                  option.selected = true;
              }
              
              guestSelect.appendChild(option);
          }
          
          // If current value exceeds new max, select the max
          if (currentValue > maxOccupancy) {
              guestSelect.value = maxOccupancy;
          }
      }

      // Attach event listeners after DOM loads (avoids EJS in onchange attribute)
      document.addEventListener('DOMContentLoaded', function() {
          document.querySelectorAll('[data-booking-id]').forEach(function(select) {
              select.addEventListener('change', function() {
                  const bookingId = this.getAttribute('data-booking-id');
                  updateGuestDropdown(bookingId);
              });
          });
      });
    </script>
</head>
<body>

    <% 
        const shortDate = (d) => {
            const date = new Date(d);
            return isNaN(date) ? d : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        const formatPrice = (p) => {
            return p ? '₱' + parseFloat(p).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '₱0.00';
        }
    %>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <div class="d-flex justify-content-end d-lg-none p-3">
            <button class="btn text-white border-0" onclick="toggleSidebar()">
                <i class="bi bi-x-lg fs-4"></i>
            </button>
        </div>

        <div class="sidebar-brand">
            <div class="brand-logo me-2">KML</div>
            <span class="text-white fw-bold">MOUNTAIN RESORT</span>
        </div>

        <div class="nav-label">Main</div>
        <nav class="nav flex-column">
            <a href="/admin-dashboard" class="nav-link"><i class="bi bi-grid-1x2 me-2"></i> Dashboard</a>
            <a href="/bookings" class="nav-link active"><i class="bi bi-calendar-event me-2"></i> Bookings</a>
            <a href="/rooms" class="nav-link"><i class="bi bi-door-open me-2"></i> Rooms</a>
            <div class="nav-label">Operations</div>
            <a href="/food" class="nav-link"><i class="bi bi-egg-fried me-2"></i> Restaurant Menu</a>
        </nav>

        <div class="mt-auto p-4">
            <a href="/logout" class="btn btn-outline-danger w-100 rounded-4 fw-bold">Logout</a>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="d-flex align-items-center justify-content-between px-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-light d-lg-none me-3" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn border-0 position-relative text-muted" onclick="clearNotifications()">
                    <i class="bi bi-bell fs-5"></i>
                    <span id="bellDot" style="display: none;" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
            </div>
        </header>

        <div class="container-fluid p-4">
            <div class="mb-4">
                <h1 class="h3 fw-bold text-dark mb-1">Pending Reservations</h1>
                <p class="text-muted small">New requests waiting for approval.</p>
            </div>

            <div class="card-custom shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">GUEST</th>
                                <th>STAY DETAILS</th>
                                <th>ROOM or COTTAGE</th>
                                <th class="text-center">GUESTS</th>
                                <th>PRICE</th>
                                <th>SPECIAL REQUESTS</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bookings.filter(b => b.status !== 'approved').forEach(booking => { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold small text-dark"><%= booking.name %></div>
                                    <div class="text-muted" style="font-size: 0.7rem;"><%= booking.email %></div>
                                </td>
                                <td>
                                    <div class="small fw-bold">In: <%= shortDate(booking.checkin) %></div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Out: <%= shortDate(booking.checkout) %></div>
                                </td>
                                <td><span class="status-tag bg-light text-dark border"><%= booking.roomType || 'Standard' %></span></td>
                                <td class="text-center"><span class="guest-badge"><%= booking.people %></span></td>
                                <td><span class="price-tag"><%= formatPrice(booking.total_price) %></span></td>
                                <td>
                                    <% if (booking.requests) { %>
                                        <span class="special-request-text" title="<%= booking.requests %>">
                                            <%= booking.requests %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size: 0.75rem;">None</span>
                                    <% } %>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <form action="/approve/<%= booking.id %>" method="POST">
                                            <button class="btn btn-success btn-sm rounded-3 px-3 fw-bold">Approve</button>
                                        </form>
                                        <button class="btn btn-light btn-sm text-primary" data-bs-toggle="modal" data-bs-target="#editModal<%= booking.id %>">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <form action="/delete/<%= booking.id %>" method="POST" onsubmit="return confirm('Delete this request?')">
                                            <button class="btn btn-light btn-sm text-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- EDIT MODAL for each pending booking -->
                            <div class="modal fade" id="editModal<%= booking.id %>" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow" style="border-radius: 24px;">
                                        <form action="/update/<%= booking.id %>" method="POST">
                                            <div class="modal-header border-bottom-0 pt-4 px-4">
                                                <h5 class="modal-title fw-bold">Edit Booking #<%= booking.id %></h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body px-4">
                                                <div class="mb-3">
                                                    <label class="form-label text-uppercase small fw-bold text-muted">Full Name</label>
                                                    <input type="text" name="name" class="form-control py-2 bg-light border-0 rounded-3" value="<%= booking.name %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-uppercase small fw-bold text-muted">Email</label>
                                                    <input type="email" name="email" class="form-control py-2 bg-light border-0 rounded-3" value="<%= booking.email %>" required>
                                                </div>
                                                
                                                <div class="row">
                                                    <div class="col-6 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Room Type</label>
                                                        <select name="roomType" id="roomSelect<%= booking.id %>" class="form-select py-2 bg-light border-0 rounded-3" required data-booking-id="<%= booking.id %>">
                                                            <option value="">Choose room or cottage...</option>
                                                            <% if (rooms && rooms.length > 0) { %>
                                                                <% 
                                                                    const categories = {};
                                                                    rooms.forEach(room => {
                                                                        if (!categories[room.category]) categories[room.category] = [];
                                                                        categories[room.category].push(room);
                                                                    });
                                                                %>
                                                                <% for (const [category, items] of Object.entries(categories)) { %>
                                                                    <optgroup label="<%= category === 'Cottage' ? '🏡 Cottages' : '🏨 ' + category + ' Rooms' %>">
                                                                        <% items.forEach(room => { %>
                                                                            <option value="<%= room.name %>" data-occupancy="<%= room.occupancy %>" <%= booking.roomType === room.name ? 'selected' : '' %>>
                                                                                <%= room.name %> — ₱<%= room.price %>/night (Max <%= room.occupancy %> guests)
                                                                            </option>
                                                                        <% }) %>
                                                                    </optgroup>
                                                                <% } %>
                                                            <% } else { %>
                                                                <option value="" disabled>No rooms available</option>
                                                            <% } %>
                                                        </select>
                                                    </div>
                                                    <div class="col-6 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Guests</label>
                                                        <select name="people" id="guestSelect<%= booking.id %>" class="form-select py-2 bg-light border-0 rounded-3" required>
                                                            <% 
                                                                let selectedRoomMax = 10;
                                                                if (rooms && rooms.length > 0) {
                                                                    const foundRoom = rooms.find(r => r.name === booking.roomType);
                                                                    if (foundRoom) selectedRoomMax = parseInt(foundRoom.occupancy) || 10;
                                                                }
                                                                for (let i = 1; i <= selectedRoomMax; i++) {
                                                            %>
                                                                <option value="<%= i %>" <%= booking.people == i ? 'selected' : '' %>><%= i === 1 ? '1 Adult' : i + ' Adults' %></option>
                                                            <% } %>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-6 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Check-In</label>
                                                        <input type="date" name="checkin" class="form-control py-2 bg-light border-0 rounded-3" value="<%= booking.checkinFormatted %>" required>
                                                    </div>
                                                    <div class="col-6 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Check-Out</label>
                                                        <input type="date" name="checkout" class="form-control py-2 bg-light border-0 rounded-3" value="<%= booking.checkoutFormatted %>" required>
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label text-uppercase small fw-bold text-muted">Special Requests</label>
                                                    <textarea name="requests" class="form-control py-2 bg-light border-0 rounded-3" rows="3" placeholder="No special requests"><%= booking.requests || '' %></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0 pb-4 px-4">
                                                <button type="button" class="btn btn-light w-100 py-2 fw-bold" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mb-4 mt-5">
                <h2 class="h4 fw-bold text-dark mb-1">Approved History</h2>
            </div>
            <div class="card-custom border-0 shadow-sm opacity-75">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">GUEST</th>
                                <th>ROOM or COTTAGE</th>
                                <th class="text-center">GUESTS</th>
                                <th>PRICE</th>
                                <th>SPECIAL REQUESTS</th>
                                <th class="text-center">STATUS</th>
                                <th class="text-end pe-4">ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bookings.filter(b => b.status === 'approved').forEach(booking => { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold small"><%= booking.name %></div>
                                    <div class="text-muted smaller" style="font-size: 0.65rem;">
                                        <%= shortDate(booking.checkin) %> - <%= shortDate(booking.checkout) %>
                                    </div>
                                </td>
                                <td class="small"><%= booking.roomType %></td>
                                <td class="text-center"><span class="guest-badge"><%= booking.people %></span></td>
                                <td><span class="price-tag"><%= formatPrice(booking.total_price) %></span></td>
                                <td>
                                    <% if (booking.requests) { %>
                                        <span class="special-request-text" title="<%= booking.requests %>">
                                            <%= booking.requests %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size: 0.75rem;">None</span>
                                    <% } %>
                                </td>
                                <td class="text-center"><span class="status-tag bg-success bg-opacity-10 text-success">Approved</span></td>
                                <td class="text-end pe-4">
                                    <form action="/delete/<%= booking.id %>" method="POST" onsubmit="return confirm('Remove from history?')">
                                        <button class="btn btn-link text-danger p-0"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div id="approveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
          <div class="toast-body">
            <i class="bi bi-check-circle-fill me-2"></i>
            Booking for <strong><%= guestName %></strong> approved and email sent!
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }
    </script>
</body>
</html>