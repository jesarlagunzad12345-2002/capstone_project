                                                        <input id="editBookingDate<%= booking.id %>" type="date" class="form-control py-2 bg-light border-0 rounded-3" value="<%= approvedCottageDate %>">
                                                    </div>
                                                    <div class="col-12 col-lg-4 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted" for="editCheckinTime<%= booking.id %>">Check-In Time</label>
                                                        <input id="editCheckinTime<%= booking.id %>" type="time" class="form-control py-2 bg-light border-0 rounded-3" value="<%= approvedCottageCheckin %>">
                                                    </div>
                                                    <div class="col-12 col-lg-4 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted" for="editCheckoutTime<%= booking.id %>">Check-Out Time</label>
                                                        <input id="editCheckoutTime<%= booking.id %>" type="time" class="form-control py-2 bg-light border-0 rounded-3" value="<%= approvedCottageCheckout %>">
                                                    </div>
                                                </div>
                                                </section>
                                                <section class="booking-edit-section">
                                                    <div class="booking-edit-section-heading">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                                                        <div><h3>Payment details</h3></div>
                                                    </div>
                                                    <div class="row g-3">
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label text-uppercase small fw-bold text-muted" for="approvedEditPaymentMethod<%= booking.id %>">Payment Method</label>
                                                            <select id="approvedEditPaymentMethod<%= booking.id %>" name="payment_method" class="form-select">
                                                                <option value="" <%= !booking.payment_method ? 'selected' : '' %>>Choose a payment method</option>
                                                                <option value="gcash" <%= booking.payment_method === 'gcash' ? 'selected' : '' %>>GCash</option>
                                                                <option value="maya" <%= booking.payment_method === 'maya' ? 'selected' : '' %>>Maya</option>
                                                                <option value="cash" <%= booking.payment_method === 'cash' ? 'selected' : '' %>>Cash</option>
                                                                <option value="card" <%= booking.payment_method === 'card' ? 'selected' : '' %>>Card</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </section>
                                                <section class="booking-edit-section">
                                                    <div class="booking-edit-section-heading">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                                                        <div>
                                                            <h3>Extras and requests</h3>
                                                        </div>
                                                    </div>
