    <div class="main-wrapper">
        <header class="d-flex align-items-center justify-content-between px-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-light d-lg-none me-3" onclick="toggleSidebar()"><i class="bi bi-list fs-4"></i></button>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown notification-dropdown">
                    <button id="notificationBell" type="button" class="btn border-0 position-relative text-muted" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Notifications" onclick="clearNotifications()">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="bellDot" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle <%= unreadNotificationCount > 0 ? '' : 'd-none' %>"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationBell">
                        <div class="notification-menu-heading">
                            <div>
                                <h2 class="h6 fw-bold mb-0">Notifications</h2>
                                <span class="text-muted small">Recent booking activity</span>
                            </div>
                            <span class="notification-total"><%= notifications.length %></span>
                        </div>
                        <div class="notification-list">
                            <% if (notifications.length === 0) { %>
                                <div class="notification-empty">
                                    <i class="bi bi-bell-slash" aria-hidden="true"></i>
                                    <span>You're all caught up</span>
                                </div>
                            <% } else { %>
                                <% notifications.forEach(notification => { %>
                                    <% const notificationType = ['approved', 'cancelled', 'walkin', 'paid'].includes(notification.type) ? notification.type : 'default'; %>
                                    <div class="notification-item <%= notification.read ? '' : 'unread' %>" data-notification-id="<%= notification.id %>">
                                        <a class="notification-link" href="/bookings">
                                            <span class="notification-icon notification-icon-<%= notificationType %>">
                                                <i class="bi <%= notificationType === 'approved' ? 'bi-check-circle-fill' : notificationType === 'cancelled' ? 'bi-x-circle-fill' : notificationType === 'walkin' ? 'bi-person-plus-fill' : notificationType === 'paid' ? 'bi-credit-card-fill' : 'bi-bell-fill' %>" aria-hidden="true"></i>
                                            </span>
                                            <span class="notification-copy">
                                                <span class="notification-title"><%= notification.title %></span>
                                                <span class="notification-message"><%= notification.message %></span>
                                                <time class="notification-time" datetime="<%= notification.createdAt %>"><%= new Date(notification.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></time>
                                            </span>
                                            <% if (!notification.read) { %><span class="notification-unread-dot" aria-label="Unread"></span><% } %>
                                        </a>
                                        <button class="notification-delete" type="button" aria-label="Delete notification" title="Delete notification" onclick="deleteNotification(this)">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="dropdown quick-booking-dropdown">
                    <button class="btn btn-dark rounded-3 px-3 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-plus-lg me-2"></i> Quick Booking
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li><a class="dropdown-item" href="/booking"><i class="bi bi-globe2 me-2"></i>Online Booking</a></li>
                        <li><a class="dropdown-item" href="/walk-in-booking"><i class="bi bi-person-walking me-2"></i>Walk-in Booking</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="container-fluid p-4 bookings-page">
            <div class="booking-page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h1 class="h3 fw-bold text-dark mb-1">Bookings</h1>
                    <p class="text-muted small mb-0">Manage online and in-person reservations together.</p>
                </div>
            </div>
            <div class="booking-section-tabs mb-3" role="tablist" aria-label="Booking sections">
                <button type="button" class="booking-section-tab active" id="bookingsViewTab" role="tab" aria-selected="true" aria-controls="bookingRecordsView" data-booking-view="records">
                    <i class="bi bi-calendar-check me-2"></i>Bookings
                </button>
                <button type="button" class="booking-section-tab" id="specialRequestsViewTab" role="tab" aria-selected="false" aria-controls="specialRequestsView" data-booking-view="requests">
                    <i class="bi bi-chat-square-text me-2"></i>Special Requests
                </button>
                <div class="btn-group booking-source-filter-group" id="bookingSourceFilters" role="group" aria-label="Booking source">
                    <button type="button" class="btn btn-dark booking-source-filter active" data-source="all">All Bookings</button>
                    <button type="button" class="btn btn-outline-dark booking-source-filter" data-source="ONLINE">Online Bookings</button>
                    <button type="button" class="btn btn-outline-dark booking-source-filter" data-source="WALK_IN">Walk-in Bookings</button>
                </div>
            </div>
            <% if (typeof message !== 'undefined' && message) { %>
                <div class="alert alert-success alert-dismissible fade show booking-flash-alert" role="alert"><i class="bi bi-check-circle me-2"></i><%= message %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-4 booking-flash-alert" role="alert" style="border-radius: 16px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Update Blocked!</strong> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <div id="bookingRecordsView" role="tabpanel" aria-labelledby="bookingsViewTab">
            <div class="booking-section-heading" data-booking-source-section="ONLINE">
                <h2 class="h5 fw-bold text-dark mb-1">Pending Reservations</h2>
                <p class="text-muted small">New online requests waiting for approval.</p>
            </div>

            <div class="card-custom shadow-sm" data-booking-source-section="ONLINE">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0 booking-table pending-bookings-table">
                        <colgroup>
                            <col style="width: 175px"><col style="width: 195px"><col style="width: 140px"><col style="width: 65px">
                            <col style="width: 115px"><col style="width: 120px"><col style="width: 120px"><col style="width: 75px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="ps-4">GUEST</th>
                                <th>Email/Number</th>
                                <th class="text-center">ROOM or COTTAGE</th>
                                <th class="text-center">GUESTS</th>
                                <th>PRICE</th>
                                <th class="text-center">BOOKING STATUS</th>
                                <th class="text-center">PAYMENT STATUS</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                                const pendingBookings = bookings.filter(b => (b.bookingSource || 'ONLINE') !== 'WALK_IN' && b.status !== 'approved' && b.status !== 'pending_payment');
                                if (pendingBookings.length === 0) {
                            %>
                                <tr><td colspan="8" class="empty-bookings-message text-muted py-4">No pending bookings yet.</td></tr>
                            <% } %>
                            <%
                                pendingBookings.forEach(booking => { 
                                    const bRoom = rooms.find(r => r.name === booking.roomType);
                                    const isCottage = bRoom && bRoom.category === 'Cottage';
                                    const bookingAddons = getBookingAddons(booking);
                                    const pendingCheckin = booking.checkin ? new Date(booking.checkin) : null;
                                    const pendingCheckout = booking.checkout ? new Date(booking.checkout) : null;
                            %>
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold small text-dark"><%= booking.name %></div>
                                    <div class="text-muted smaller" style="font-size: 0.65rem;">
                                        <% if (isCottage) {
                                            const dateStr = pendingCheckin && !isNaN(pendingCheckin.getTime())
                                                ? pendingCheckin.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})
                                                : shortDate(booking.checkin);
                                            const checkinTime = pendingCheckin && !isNaN(pendingCheckin.getTime())
                                                ? pendingCheckin.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true})
                                                : '';
                                            const checkoutTime = pendingCheckout && !isNaN(pendingCheckout.getTime())
                                                ? pendingCheckout.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true})
                                                : '';
                                        %>
                                            <%= dateStr %> | <%= checkinTime %> - <%= checkoutTime %>
                                        <% } else { %>
                                            <%= shortDate(booking.checkin) %> - <%= shortDate(booking.checkout) %>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="email-cell">
                                    <div class="booking-email"><%= booking.email %></div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Phone: <%= booking.phone || 'Not provided' %></div>
                                </td>
                                <td class="text-center"><span class="status-tag bg-info-subtle text-info-emphasis"><%= booking.roomType || 'Standard' %></span></td>
                                <td class="text-center"><span class="guest-badge"><%= booking.people %></span></td>
                                <td><span class="price-tag"><%= formatPrice(booking.total_price) %></span></td>
                                <td class="text-center"><span class="status-tag bg-warning bg-opacity-10 text-warning-emphasis"><%= String(booking.status || 'pending').replaceAll('_', ' ').replace(/\b\w/g, letter => letter.toUpperCase()) %></span></td>
                                <td class="text-center"><span class="status-tag <%= booking.payment_status === 'verified' ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning-emphasis' %>"><%= booking.payment_status === 'verified' ? 'Verified' : 'Unverified' %></span></td>
                                <td class="text-end pe-4">
                                    <div class="dropdown booking-actions-dropdown">
                                        <button type="button" class="btn btn-light btn-sm" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Booking actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li><button type="button" class="dropdown-item booking-detail-btn" data-bs-toggle="modal" data-bs-target="#bookingDetailsModal"
                                                data-id="<%= booking.id %>" data-name="<%= booking.name || '' %>" data-email="<%= booking.email || '' %>" data-phone="<%= booking.phone || '' %>"
                                                data-room="<%= booking.roomType || '' %>" data-people="<%= booking.people ?? '' %>" data-checkin="<%= booking.checkin || '' %>" data-checkout="<%= booking.checkout || '' %>"
                                                data-status="<%= booking.status || '' %>" data-source="<%= booking.bookingSource || 'ONLINE' %>" data-total="<%= booking.total_price ?? '' %>"
                                                data-nights="<%= booking.nights ?? '' %>" data-requests="<%= stripCalculatedBookingRequests(booking.requests) || '' %>" data-payment-method="<%= booking.payment_method || '' %>"
                                                data-pool-selected="<%= getBookingAddons(booking).poolSelected %>" data-pool-adults="<%= getBookingAddons(booking).poolAdultCount %>" data-pool-children="<%= getBookingAddons(booking).poolChildCount %>"
                                                data-pool-fee="<%= booking.pool_fee || (getBookingAddons(booking).poolAdultCount * 150 + getBookingAddons(booking).poolChildCount * 100) %>" data-ktv-selected="<%= getBookingAddons(booking).ktvSelected %>" data-ktv-guests="<%= getBookingAddons(booking).ktvGuestCount %>" data-ktv-fee="<%= booking.ktv_fee || (getBookingAddons(booking).ktvSelected ? 1000 : 0) %>"
                                                data-entrance-fee="<%= booking.entrance_fee_total ?? '' %>" data-extra-guest-count="<%= booking.overnight_extra_guest_count ?? '' %>" data-extra-guest-rate="<%= booking.overnight_extra_guest_rate ?? 200 %>" data-extra-guest-fee="<%= booking.overnight_extra_guest_fee ?? '' %>"
                                                data-amount-paid="<%= booking.amount_paid ?? '' %>" data-balance="<%= booking.balance ?? '' %>"
                                                data-payment-status="<%= booking.payment_status || '' %>" data-downpayment="<%= booking.downpayment_amount ?? '' %>"
                                                data-reference="<%= booking.reference_number || '' %>" data-payment-submitted="<%= booking.payment_submitted_at || '' %>"
                                                data-created-at="<%= booking.created_at || '' %>"><i class="bi bi-card-text me-2"></i>View full info</button></li>
                                            <li>
                                                <form action="/approve/<%= booking.id %>" method="POST">
                                                    <% if (booking.payment_status === 'verified') { %>
                                                        <button type="button" class="dropdown-item text-success approve-booking-btn"><i class="bi bi-check-circle me-2"></i>Approve</button>
                                                    <% } else { %>
                                                        <button type="button" class="dropdown-item text-muted" disabled title="Verify payment before approving"><i class="bi bi-lock me-2"></i>Verify payment to approve</button>
                                                    <% } %>
                                                </form>
                                            </li>
                                            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editModal<%= booking.id %>"><i class="bi bi-pencil-square me-2"></i>Edit booking</button></li>
                                            <li>
                                                <form action="/delete/<%= booking.id %>" method="POST" data-swal-confirm="Delete this request?" data-swal-title="Delete booking request?" data-swal-confirm-button="Delete">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete booking</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>

                            <!-- EDIT MODAL -->
                            <div class="modal fade" id="editModal<%= booking.id %>" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable booking-edit-dialog">
                                    <div class="modal-content border-0 shadow booking-edit-modal">
                                        <form action="/update/<%= booking.id %>" method="POST" class="edit-booking-form" novalidate>
                                            <div class="modal-header booking-edit-modal-header">
                                                <div class="d-flex align-items-center gap-3">
                                                    <span class="booking-edit-modal-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
                                                    <div>
                                                        <p class="booking-edit-eyebrow">RESERVATION DETAILS</p>
                                                        <h5 class="modal-title fw-bold">Edit Booking #<%= booking.id %></h5>
                                                    </div>
                                                </div>
                                                <div class="booking-edit-header-actions">
                                                    <button type="button" class="booking-edit-guide" data-bs-toggle="popover" data-bs-title="Booking guide" data-bs-content="<ul><li>Overnight rooms: each guest above included occupancy is ₱200 per night, up to 20 guests total.</li><li>Cottages: entrance fee is ₱30 per guest. Overnight rooms have free entrance.</li><li>Paid pool: cottages may include any guest; rooms may include only guests above included occupancy. Rates are ₱150 per adult and ₱100 per child under 4 ft.</li><li>KTV: ₱1,000 for 3 hours, maximum 15 guests.</li></ul>" aria-label="View booking guide"><i class="bi bi-info-circle" aria-hidden="true"></i><span>View guide</span></button>
                                                </div>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body booking-edit-modal-body">

                                                <input type="hidden" name="checkin" id="editCheckinHidden<%= booking.id %>" value="<%= booking.checkinFormatted %>">
                                                <input type="hidden" name="checkout" id="editCheckoutHidden<%= booking.id %>" value="<%= booking.checkoutFormatted %>">

                                                <section class="booking-edit-section">
                                                    <div class="booking-edit-section-heading">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-person" aria-hidden="true"></i></span>
                                                        <div>
                                                            <h3>Guest information</h3>
                                                        </div>
                                                    </div>
                                                    <div class="row g-3">
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label text-uppercase small fw-bold text-muted" for="editName<%= booking.id %>">Full Name</label>
                                                            <input id="editName<%= booking.id %>" type="text" name="name" class="form-control" value="<%= booking.name %>" required>
                                                        </div>
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label text-uppercase small fw-bold text-muted" for="editEmail<%= booking.id %>">Email</label>
                                                            <input id="editEmail<%= booking.id %>" type="email" name="email" class="form-control" value="<%= booking.email %>" required>
                                                        </div>
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label text-uppercase small fw-bold text-muted" for="editPhone<%= booking.id %>">Phone Number</label>
                                                            <input id="editPhone<%= booking.id %>" type="tel" name="phone" class="form-control" value="<%= booking.phone || '' %>" maxlength="30">
                                                        </div>
                                                    </div>
                                                </section>

                                                <section class="booking-edit-section">
                                                    <div class="booking-edit-section-heading">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-house-door" aria-hidden="true"></i></span>
                                                        <div>
                                                            <h3>Stay details</h3>
                                                        </div>
                                                    </div>
                                                <div class="row">
                                                    <div class="col-12 col-lg-6 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Room Type</label>
                                                        <select name="roomType" id="roomSelect<%= booking.id %>" class="form-select py-2 bg-light border-0 rounded-3" required data-booking-id="<%= booking.id %>">
                                                            <option value="">Choose room or cottage...</option>
                                                            <% if (rooms && rooms.length > 0) { %>
                                                                <% 
                                                                    const categories = {};
                                                                    rooms.forEach(room => {
                                                                        if (!categories[room.category]) categories[room.category] = [];
                                                                        categories[room.category].push(room);
                                                                    });
                                                                %>
                                                                <% for (const [category, items] of Object.entries(categories)) { %>
                                                                    <optgroup label="<%= category === 'Cottage' ? '🏡 Cottages' : '🏨 ' + category + ' Rooms' %>">
                                                                        <% items.forEach(room => { %>
                                                                            <option value="<%= room.name %>" 
                                                                                data-category="<%= room.category %>" 
                                                                                data-occupancy="<%= room.occupancy %>" 
                                                                                data-price="<%= room.price %>"
                                                                                <%= booking.roomType === room.name ? 'selected' : '' %>>
                                                                                <%= room.name %> — ₱<%= room.price %><%= room.category === 'Cottage' ? ' (Flat, max ' + room.occupancy + ' guests)' : '/night (' + room.occupancy + ' included)' %>
                                                                            </option>
                                                                        <% }) %>
                                                                    </optgroup>
                                                                <% } %>
                                                            <% } else { %>
                                                                <option value="" disabled>No rooms available</option>
                                                            <% } %>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 col-lg-6 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Guests</label>
                                                        <% let selectedRoomMax = 20;
                                                            if (rooms && rooms.length > 0) {
                                                                const foundRoom = rooms.find(r => r.name === booking.roomType);
                                                                if (foundRoom && foundRoom.category === 'Cottage') selectedRoomMax = parseInt(foundRoom.occupancy) || 10;
                                                            }
                                                        %>
                                                        <input type="number" name="people" id="guestSelect<%= booking.id %>" class="form-control py-2 bg-light border-0 rounded-3" min="1" max="<%= selectedRoomMax %>" step="1" value="<%= booking.people || 1 %>" inputmode="numeric" required>
                                                    </div>
                                                </div>

                                                <% 
                                                    let cottageDateVal = '';
                                                    let cottageCheckinTimeVal = '';
                                                    let cottageCheckoutTimeVal = '';
                                                    if (isCottage) {
                                                        const cinDt = booking.checkin ? new Date(booking.checkin) : null;
                                                        const coutDt = booking.checkout ? new Date(booking.checkout) : null;
                                                        if (cinDt && !isNaN(cinDt.getTime())) {
                                                            const y = cinDt.getFullYear();
                                                            const m = String(cinDt.getMonth() + 1).padStart(2, '0');
                                                            const d = String(cinDt.getDate()).padStart(2, '0');
                                                            cottageDateVal = `${y}-${m}-${d}`;
                                                            cottageCheckinTimeVal = `${String(cinDt.getHours()).padStart(2,'0')}:${String(cinDt.getMinutes()).padStart(2,'0')}`;
                                                        }
                                                        if (coutDt && !isNaN(coutDt.getTime())) {
                                                            cottageCheckoutTimeVal = `${String(coutDt.getHours()).padStart(2,'0')}:${String(coutDt.getMinutes()).padStart(2,'0')}`;
                                                        }
                                                    }
                                                %>

                                                <!-- ROOM FIELDS: Check-in Date Only -->
                                                <% if (!isCottage) { %>
                                                <div class="row" id="editRoomFields<%= booking.id %>">
                                                <% } else { %>
                                                <div class="row" id="editRoomFields<%= booking.id %>" style="display:none;">
                                                <% } %>
                                                    <div class="col-12 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Check-In Date</label>
                                                        <input type="date" id="editCheckinDate<%= booking.id %>" class="form-control py-2 bg-light border-0 rounded-3" value="<%= booking.checkinFormatted %>">
                                                    </div>
                                                </div>

                                                <!-- COTTAGE FIELDS -->
                                                <% if (isCottage) { %>
                                                <div class="row" id="editCottageFields<%= booking.id %>">
                                                <% } else { %>
                                                <div class="row" id="editCottageFields<%= booking.id %>" style="display:none;">
                                                <% } %>
                                                    <div class="col-12 col-lg-4 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Booking Date</label>
                                                        <input type="date" id="editBookingDate<%= booking.id %>" class="form-control py-2 bg-light border-0 rounded-3" value="<%= cottageDateVal %>">
                                                    </div>
                                                    <div class="col-12 col-lg-4 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Check-In Time</label>
                                                        <input type="time" id="editCheckinTime<%= booking.id %>" class="form-control py-2 bg-light border-0 rounded-3" value="<%= cottageCheckinTimeVal %>">
                                                    </div>
                                                    <div class="col-12 col-lg-4 mb-3">
                                                        <label class="form-label text-uppercase small fw-bold text-muted">Check-Out Time</label>
                                                        <input type="time" id="editCheckoutTime<%= booking.id %>" class="form-control py-2 bg-light border-0 rounded-3" value="<%= cottageCheckoutTimeVal %>">
                                                    </div>
                                                </div>

                                                </section>
                                                <section class="booking-edit-section">
                                                    <div class="booking-edit-section-heading">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                                                        <div><h3>Payment verification</h3></div>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label text-uppercase small fw-bold text-muted" for="editPaymentStatus<%= booking.id %>">Payment Status</label>
                                                        <select id="editPaymentStatus<%= booking.id %>" name="payment_status" class="form-select">
                                                            <option value="pending_verification" <%= booking.payment_status !== 'verified' ? 'selected' : '' %>>Unverified</option>
                                                            <option value="verified" <%= booking.payment_status === 'verified' ? 'selected' : '' %>>Verified</option>
                                                        </select>
                                                    </div>
                                                    <div class="row g-3 mt-1">
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label text-uppercase small fw-bold text-muted" for="editPaymentMethod<%= booking.id %>">Payment Method</label>
                                                            <select id="editPaymentMethod<%= booking.id %>" name="payment_method" class="form-select">
                                                                <option value="" <%= !booking.payment_method ? 'selected' : '' %>>Choose a payment method</option>
                                                                <option value="gcash" <%= booking.payment_method === 'gcash' ? 'selected' : '' %>>GCash</option>
                                                                <option value="maya" <%= booking.payment_method === 'maya' ? 'selected' : '' %>>Maya</option>
                                                                <option value="cash" <%= booking.payment_method === 'cash' ? 'selected' : '' %>>Cash</option>
                                                                <option value="card" <%= booking.payment_method === 'card' ? 'selected' : '' %>>Card</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </section>
                                                <section class="booking-edit-section">
                                                    <div class="booking-edit-section-heading">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                                                        <div>
                                                            <h3>Extras and requests</h3>
                                                        </div>
                                                    </div>
                                                <div class="booking-edit-addon-panel mb-3">
                                                    <div class="booking-edit-addon-title">
                                                        <span class="booking-edit-section-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                                                        <div>
                                                            <h4>Entrance and optional add-ons</h4>
                                                        </div>
                                                    </div>
                                                    <div class="form-text mb-2" id="editChargeSummary<%= booking.id %>"></div>
                                                    <div class="form-check mb-2" id="editPoolOption<%= booking.id %>">
                                                        <input class="form-check-input" type="checkbox" name="addons" value="pool" id="editPoolAddon<%= booking.id %>" <%= bookingAddons.poolSelected ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-semibold" for="editPoolAddon<%= booking.id %>">Paid swimming pool</label>
                                                    </div>
                                                    <div class="row g-2 mb-2" id="editPoolCounts<%= booking.id %>" <%= bookingAddons.poolSelected ? '' : 'style="display:none"' %>>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editPoolAdultCount<%= booking.id %>">Pool adults</label>
                                                            <input class="form-control form-control-sm" type="number" min="0" name="poolAdultCount" id="editPoolAdultCount<%= booking.id %>" value="<%= bookingAddons.poolAdultCount %>">
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editPoolChildCount<%= booking.id %>">Pool children under 4 ft</label>
                                                            <input class="form-control form-control-sm" type="number" min="0" name="poolChildCount" id="editPoolChildCount<%= booking.id %>" value="<%= bookingAddons.poolChildCount %>">
                                                        </div>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="addons" value="ktv" id="editKtvAddon<%= booking.id %>" <%= bookingAddons.ktvSelected ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-semibold" for="editKtvAddon<%= booking.id %>">KTV room</label>
                                                    </div>
                                                    <div class="row g-2 mt-1" id="editKtvGuestCountFields<%= booking.id %>" <%= bookingAddons.ktvSelected ? '' : 'style="display:none"' %>>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editKtvGuestCount<%= booking.id %>">KTV guests (max 15)</label>
                                                            <input class="form-control form-control-sm" type="number" min="1" max="15" step="1" name="ktvGuestCount" id="editKtvGuestCount<%= booking.id %>" value="<%= bookingAddons.ktvGuestCount || 1 %>" <%= bookingAddons.ktvSelected ? '' : 'disabled' %>>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editKtvStartTime<%= booking.id %>">KTV time slot on booking date</label>
                                                            <select class="form-select form-select-sm" name="ktvStartTime" id="editKtvStartTime<%= booking.id %>" <%= bookingAddons.ktvSelected ? '' : 'disabled' %>>
                                                                <option value="">Loading availability...</option>
                                                                <option value="08:00:00" <%= booking.ktv_start_time && String(booking.ktv_start_time).slice(0, 8) === '08:00:00' ? 'selected' : '' %>>8:00 AM–11:00 AM</option>
                                                                <option value="11:00:00" <%= booking.ktv_start_time && String(booking.ktv_start_time).slice(0, 8) === '11:00:00' ? 'selected' : '' %>>11:00 AM–2:00 PM</option>
                                                                <option value="15:00:00" <%= booking.ktv_start_time && String(booking.ktv_start_time).slice(0, 8) === '15:00:00' ? 'selected' : '' %>>3:00 PM–6:00 PM</option>
                                                            </select>
                                                            <div class="form-text" id="editKtvAvailability<%= booking.id %>" aria-live="polite"></div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label text-uppercase small fw-bold text-muted">Special Requests</label>
                                                    <textarea name="requests" class="form-control py-2 bg-light border-0 rounded-3" rows="3" placeholder="No special requests"><%= stripCalculatedBookingRequests(booking.requests) || '' %></textarea>
                                                </div>
                                                </section>
                                            </div>
                                            <div class="modal-footer booking-edit-modal-footer">
                                                <button type="button" class="btn btn-light w-100 py-2 fw-bold" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="booking-section-heading" data-booking-source-section="WALK_IN">
                <h2 class="h5 fw-bold text-dark mb-1">Walk-in Bookings</h2>
                <p class="text-muted small">Reservations created directly by resort staff.</p>
            </div>
            <div class="card-custom shadow-sm" data-booking-source-section="WALK_IN">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 booking-table walk-in-bookings-table">
                        <colgroup>
                            <col style="width: 190px"><col style="width: 155px"><col style="width: 140px"><col style="width: 70px">
                            <col style="width: 105px"><col style="width: 100px"><col style="width: 100px"><col style="width: 130px">
                            <col style="width: 75px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="ps-4">GUEST</th>
                                <th>STAY DETAILS</th>
                                <th class="text-center">ROOM or COTTAGE</th>
                                <th class="text-center">GUESTS</th>
                                <th>TOTAL</th>
                                <th>PAID</th>
                                <th>BALANCE</th>
                                <th>PAYMENT METHOD</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const walkInBookings = bookings.filter(b => (b.bookingSource || 'ONLINE') === 'WALK_IN'); %>
                            <% if (walkInBookings.length === 0) { %>
                                <tr><td colspan="9" class="empty-bookings-message text-muted py-4">No walk-in bookings yet.</td></tr>
                            <% } %>
                            <% walkInBookings.forEach(booking => { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold small"><%= booking.name %></div>
                                        <div class="booking-email text-muted" style="font-size: 0.7rem;"><%= !booking.email || booking.email === 'walkin@kmlresort.local' ? 'No email' : booking.email %></div>
                                    </td>
                                    <td class="stay-details-cell">
                                        <div class="small fw-bold">In: <%= shortDate(booking.checkin) %></div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Out: <%= shortDate(booking.checkout) %></div>
                                    </td>
                                    <td class="text-center"><span class="status-tag bg-info-subtle text-info-emphasis"><%= booking.roomType || 'Standard' %></span></td>
                                    <td class="text-center"><span class="guest-badge"><%= booking.people %></span></td>
                                    <td><span class="price-tag"><%= formatPrice(booking.total_price) %></span></td>
                                    <td><span class="small fw-semibold"><%= formatPrice(booking.amount_paid) %></span></td>
                                    <td><span class="small fw-semibold text-danger"><%= formatPrice(booking.balance) %></span></td>
                                    <td><span class="small fw-bold text-uppercase"><%= booking.payment_method || 'cash' %></span></td>
                                    <td class="text-end pe-4">
                                        <div class="dropdown booking-actions-dropdown">
                                            <button type="button" class="btn btn-light btn-sm" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Booking actions">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                <li><button type="button" class="dropdown-item booking-detail-btn" data-bs-toggle="modal" data-bs-target="#bookingDetailsModal"
                                                    data-id="<%= booking.id %>" data-name="<%= booking.name || '' %>" data-email="<%= booking.email || '' %>" data-phone="<%= booking.phone || '' %>"
                                                    data-room="<%= booking.roomType || '' %>" data-people="<%= booking.people ?? '' %>" data-checkin="<%= booking.checkin || '' %>" data-checkout="<%= booking.checkout || '' %>"
                                                    data-status="<%= booking.status || '' %>" data-source="<%= booking.bookingSource || 'ONLINE' %>" data-total="<%= booking.total_price ?? '' %>"
                                                    data-nights="<%= booking.nights ?? '' %>" data-requests="<%= stripCalculatedBookingRequests(booking.requests) || '' %>" data-payment-method="<%= booking.payment_method || '' %>"
                                                    data-pool-selected="<%= getBookingAddons(booking).poolSelected %>" data-pool-adults="<%= getBookingAddons(booking).poolAdultCount %>" data-pool-children="<%= getBookingAddons(booking).poolChildCount %>"
                                                    data-pool-fee="<%= booking.pool_fee || (getBookingAddons(booking).poolAdultCount * 150 + getBookingAddons(booking).poolChildCount * 100) %>" data-ktv-selected="<%= getBookingAddons(booking).ktvSelected %>" data-ktv-guests="<%= getBookingAddons(booking).ktvGuestCount %>" data-ktv-fee="<%= booking.ktv_fee || (getBookingAddons(booking).ktvSelected ? 1000 : 0) %>"
                                                    data-entrance-fee="<%= booking.entrance_fee_total ?? '' %>" data-extra-guest-count="<%= booking.overnight_extra_guest_count ?? '' %>" data-extra-guest-rate="<%= booking.overnight_extra_guest_rate ?? 200 %>" data-extra-guest-fee="<%= booking.overnight_extra_guest_fee ?? '' %>"
                                                    data-amount-paid="<%= booking.amount_paid ?? '' %>" data-balance="<%= booking.balance ?? '' %>"
                                                    data-payment-status="<%= booking.payment_status || '' %>" data-downpayment="<%= booking.downpayment_amount ?? '' %>"
                                                    data-reference="<%= booking.reference_number || '' %>" data-payment-submitted="<%= booking.payment_submitted_at || '' %>"
                                                    data-created-at="<%= booking.created_at || '' %>"><i class="bi bi-card-text me-2"></i>View full info</button></li>
                                                <li><a href="/walk-in-booking/edit/<%= booking.id %>" class="dropdown-item"><i class="bi bi-pencil-square me-2"></i>Edit booking</a></li>
                                                <li>
                                                    <form action="/admin-cancel/<%= booking.id %>" method="POST" data-swal-confirm="Cancel this walk-in booking?" data-swal-title="Cancel walk-in booking?" data-swal-confirm-button="Cancel booking">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2"></i>Cancel booking</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form action="/delete/<%= booking.id %>" method="POST" data-swal-confirm="Delete this walk-in booking?" data-swal-title="Delete walk-in booking?" data-swal-confirm-button="Delete">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete booking</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="booking-section-heading" data-booking-source-section="ONLINE">
                <h2 class="h5 fw-bold text-dark mb-1">Approved History</h2>
            </div>
            <div class="card-custom border-0 shadow-sm" data-booking-source-section="ONLINE">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0 booking-table approved-bookings-table">
                        <colgroup>
                            <col style="width: 175px"><col style="width: 195px"><col style="width: 140px"><col style="width: 65px">
                            <col style="width: 115px"><col style="width: 120px"><col style="width: 120px"><col style="width: 75px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="ps-4">GUEST</th>
                                <th>Email/Number</th>
                                <th class="text-center">ROOM or COTTAGE</th>
                                <th class="text-center">GUESTS</th>
                                <th>PRICE</th>
                                <th class="text-center">BOOKING STATUS</th>
                                <th class="text-center">PAYMENT STATUS</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                                const approvedBookings = bookings.filter(b => (b.bookingSource || 'ONLINE') !== 'WALK_IN' && b.status === 'approved');
                                approvedBookings.forEach(booking => { 
                                    const bookingAddons = getBookingAddons(booking);
                                    const bRoom2 = allRooms.find(r => r.name === booking.roomType);
                                    const isCottage2 = bRoom2 && bRoom2.category === 'Cottage';
                                    const approvedEditRooms = rooms.some(r => r.name === booking.roomType)
                                        ? rooms
                                        : [...rooms, ...(bRoom2 ? [bRoom2] : [])];
                                    const approvedRoomMax = isCottage2 ? (parseInt(bRoom2 && bRoom2.occupancy) || 1) : 20;
                                    const approvedCheckin = booking.checkin ? new Date(booking.checkin) : null;
                                    const approvedCheckout = booking.checkout ? new Date(booking.checkout) : null;
                                    const approvedCottageDate = approvedCheckin && !isNaN(approvedCheckin.getTime())
                                        ? `${approvedCheckin.getFullYear()}-${String(approvedCheckin.getMonth() + 1).padStart(2, '0')}-${String(approvedCheckin.getDate()).padStart(2, '0')}`
                                        : '';
                                    const approvedCottageCheckin = approvedCheckin && !isNaN(approvedCheckin.getTime())
                                        ? `${String(approvedCheckin.getHours()).padStart(2, '0')}:${String(approvedCheckin.getMinutes()).padStart(2, '0')}`
                                        : '';
                                    const approvedCottageCheckout = approvedCheckout && !isNaN(approvedCheckout.getTime())
                                        ? `${String(approvedCheckout.getHours()).padStart(2, '0')}:${String(approvedCheckout.getMinutes()).padStart(2, '0')}`
                                        : '';
                            %>
                            <tr data-booking-source="<%= booking.bookingSource || 'ONLINE' %>">
                                <td class="ps-4">
                                    <div class="fw-bold small"><%= booking.name %></div>
                                    <div class="text-muted smaller" style="font-size: 0.65rem;">
                                        <% if (isCottage2) { 
                                            const cin2 = new Date(booking.checkin);
                                            const cout2 = new Date(booking.checkout);
                                            const dateStr2 = !isNaN(cin2) ? cin2.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : shortDate(booking.checkin);
                                            const cinTime2 = !isNaN(cin2) ? cin2.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true}) : '';
                                            const coutTime2 = !isNaN(cout2) ? cout2.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', hour12:true}) : '';
                                        %>
                                            <%= dateStr2 %> | <%= cinTime2 %> - <%= coutTime2 %>
                                        <% } else { %>
                                            <%= shortDate(booking.checkin) %> - <%= shortDate(booking.checkout) %>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="email-cell">
                                    <div><%= booking.email %></div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Phone: <%= booking.phone || 'Not provided' %></div>
                                </td>
                                <td class="small text-center"><span class="status-tag bg-info-subtle text-info-emphasis"><%= booking.roomType || 'Standard' %></span></td>
                                <td class="text-center"><span class="guest-badge"><%= booking.people %></span></td>
                                <td><span class="price-tag"><%= formatPrice(booking.total_price) %></span></td>

                                <td class="text-center"><span class="status-tag bg-success bg-opacity-10 text-success">Approved</span></td>
                                <td class="text-center"><span class="status-tag <%= Number(booking.total_price) > 0 && Number(booking.amount_paid) >= Number(booking.total_price) ? 'bg-success bg-opacity-10 text-success' : booking.payment_status === 'verified' ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning-emphasis' %>"><%= Number(booking.total_price) > 0 && Number(booking.amount_paid) >= Number(booking.total_price) ? 'Fully Paid' : booking.payment_status === 'verified' ? 'Verified' : 'Unverified' %></span></td>
                                <td class="text-end pe-4">
                                    <div class="dropdown booking-actions-dropdown">
                                        <button type="button" class="btn btn-light btn-sm" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Booking actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li><button type="button" class="dropdown-item booking-detail-btn" data-bs-toggle="modal" data-bs-target="#bookingDetailsModal"
                                                data-id="<%= booking.id %>" data-name="<%= booking.name || '' %>" data-email="<%= booking.email || '' %>" data-phone="<%= booking.phone || '' %>"
                                                data-room="<%= booking.roomType || '' %>" data-people="<%= booking.people ?? '' %>" data-checkin="<%= booking.checkin || '' %>" data-checkout="<%= booking.checkout || '' %>"
                                                data-status="<%= booking.status || '' %>" data-source="<%= booking.bookingSource || 'ONLINE' %>" data-total="<%= booking.total_price ?? '' %>"
                                                data-nights="<%= booking.nights ?? '' %>" data-requests="<%= stripCalculatedBookingRequests(booking.requests) || '' %>" data-payment-method="<%= booking.payment_method || '' %>"
                                                data-pool-selected="<%= getBookingAddons(booking).poolSelected %>" data-pool-adults="<%= getBookingAddons(booking).poolAdultCount %>" data-pool-children="<%= getBookingAddons(booking).poolChildCount %>"
                                                data-pool-fee="<%= booking.pool_fee || (getBookingAddons(booking).poolAdultCount * 150 + getBookingAddons(booking).poolChildCount * 100) %>" data-ktv-selected="<%= getBookingAddons(booking).ktvSelected %>" data-ktv-guests="<%= getBookingAddons(booking).ktvGuestCount %>" data-ktv-fee="<%= booking.ktv_fee || (getBookingAddons(booking).ktvSelected ? 1000 : 0) %>"
                                                data-entrance-fee="<%= booking.entrance_fee_total ?? '' %>" data-extra-guest-count="<%= booking.overnight_extra_guest_count ?? '' %>" data-extra-guest-rate="<%= booking.overnight_extra_guest_rate ?? 200 %>" data-extra-guest-fee="<%= booking.overnight_extra_guest_fee ?? '' %>"
                                                data-amount-paid="<%= booking.amount_paid ?? '' %>" data-balance="<%= booking.balance ?? '' %>"
                                                data-payment-status="<%= Number(booking.total_price) > 0 && Number(booking.amount_paid) >= Number(booking.total_price) ? 'Fully Paid' : booking.payment_status || '' %>" data-downpayment="<%= booking.downpayment_amount ?? '' %>"
                                                data-reference="<%= booking.reference_number || '' %>" data-payment-submitted="<%= booking.payment_submitted_at || '' %>"
                                                data-created-at="<%= booking.created_at || '' %>"><i class="bi bi-card-text me-2"></i>View full info</button></li>
                                            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#approvedEditModal<%= booking.id %>"><i class="bi bi-pencil-square me-2"></i>Edit booking</button></li>
                                            <% if (Number(booking.total_price) > 0 && Number(booking.amount_paid) < Number(booking.total_price)) { %>
                                            <li>
                                                <form action="/mark-fully-paid/<%= booking.id %>" method="POST" data-swal-icon="question" data-swal-confirm="Record the full booking total as paid on site?" data-swal-title="Mark booking fully paid?" data-swal-confirm-button="Mark fully paid">
                                                    <button type="submit" class="dropdown-item text-success"><i class="bi bi-cash-coin me-2"></i>Mark fully paid</button>
                                                </form>
                                            </li>
                                            <% } %>
                                            <li>
