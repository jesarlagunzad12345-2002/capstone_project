<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KML Mountain Resort | Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/booking_admin.css">
    <link rel="icon" type="image/jpeg" href="img/logo.jpg">

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript">
    (function() { emailjs.init({ publicKey: "nerxCEIOup7atDE6q" }); })();

      function formatDate(dateString) {
          if (!dateString) return "N/A";
          const date = new Date(dateString);
          return isNaN(date) ? dateString : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }

      function showBookingAlert(options) {
          return Swal.fire({
              showClass: { popup: 'booking-alert-show' },
              hideClass: { popup: 'booking-alert-hide' },
              buttonsStyling: false,
              customClass: {
                  confirmButton: 'btn btn-dark px-4',
                  cancelButton: 'btn btn-light px-4'
              },
              ...options
          });
      }

      function timeToMinutes(timeStr) {
          if (!timeStr) return 0;
          const [h, m] = timeStr.split(':').map(Number);
          return (h * 60) + m;
      }

      // Room stays end the next day, including when checkout falls on a closure day.
      function getAutoCheckout(checkinStr) {
          const [year, month, day] = checkinStr.split('-').map(Number);
          const date = new Date(year, month - 1, day);
          date.setDate(date.getDate() + 1);
          const y = date.getFullYear();
          const m = String(date.getMonth() + 1).padStart(2, '0');
          const d = String(date.getDate()).padStart(2, '0');
          return `${y}-${m}-${d}`;
      }

      window.onload = function() {
        const paymentPaidEmail = document.getElementById('paymentPaidEmail');
        if (paymentPaidEmail) {
          const paidAmount = '₱' + Number(paymentPaidEmail.dataset.total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          emailjs.send('service_zu9wo49', 'template_i50p7ra', {
            to_email: paymentPaidEmail.dataset.email,
            user_name: paymentPaidEmail.dataset.name,
            booking_id: paymentPaidEmail.dataset.id,
            room_type: paymentPaidEmail.dataset.room,
            checkin_date: formatDate(paymentPaidEmail.dataset.checkin),
            checkout_date: formatDate(paymentPaidEmail.dataset.checkout),
            total_price: paidAmount,
            amount_paid: '₱' + Number(paymentPaidEmail.dataset.amountPaidToday).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
            entrance_fee: '₱' + Number(paymentPaidEmail.dataset.entranceFee).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
            pool_fee: Number(paymentPaidEmail.dataset.poolFee) > 0
              ? '₱' + Number(paymentPaidEmail.dataset.poolFee).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
              : 'Not selected',
            ktv_fee: Number(paymentPaidEmail.dataset.ktvFee) > 0
              ? '₱' + Number(paymentPaidEmail.dataset.ktvFee).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
              : 'Not selected',
            balance: '₱0.00',
            remaining_balance: '₱0.00',
            payment_method: 'On-site payment',
            message: 'Your booking has been fully paid. Thank you for choosing KML Resort!'
          }, {
            publicKey: 'NMKEdAd8l04_ANBcn'
          }).then(function() {
            showBookingAlert({
              icon: 'success',
              title: 'Payment recorded and email sent',
              text: `A fully paid confirmation was sent to ${paymentPaidEmail.dataset.email}`,
              timer: 3500,
              timerProgressBar: true,
              showConfirmButton: false
            });
          }).catch(function(error) {
            console.error('Fully paid email error:', error);
            showBookingAlert({
              icon: 'warning',
              title: 'Payment recorded, email not sent',
              text: 'The booking is fully paid, but the confirmation email could not be sent. Please check the EmailJS template configuration.',
              confirmButtonText: 'OK'
            });
          });
        }

        const shouldTrigger = "<%= typeof triggerApprove !== 'undefined' ? triggerApprove : false %>";
        if (shouldTrigger === "true") {
            const toastElement = document.getElementById('approveToast');
            const toast = new bootstrap.Toast(toastElement);
            toast.show();
            const bellDot = document.getElementById('bellDot');
            if (bellDot) bellDot.classList.remove('d-none');

            const approvalEmail = document.getElementById('approvalEmail');
            if (approvalEmail && approvalEmail.dataset.email) {
                const bookingTotal = '₱' + Number(approvalEmail.dataset.total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                emailjs.send('service_kmlresort', 'template_klmresort1', {
                    to_email: approvalEmail.dataset.email,
                    user_name: approvalEmail.dataset.name,
                    room_type: approvalEmail.dataset.room || 'Standard Apartment',
                    checkin_date: formatDate(approvalEmail.dataset.checkin),
                    checkout_date: formatDate(approvalEmail.dataset.checkout),
                    guests_count: approvalEmail.dataset.guests,
                    special_requests: approvalEmail.dataset.requests || 'None',
                    total_price: bookingTotal,
                    remaining_balance: bookingTotal,
                    message: 'Your reservation at KML Resort is officially confirmed!'
                }, {
                    publicKey: 'EfvIkV0UtUXjEGOgu'
                }).then(function() {
                    showBookingAlert({
                        icon: 'success',
                        title: 'Confirmation email sent',
                        text: `Sent to ${approvalEmail.dataset.email}`,
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false
                    });
                }).catch(function(error) {
                    console.error('Booking confirmation email error:', error);
                    showBookingAlert({
                        icon: 'error',
                        title: 'Booking approved, email not sent',
                        text: 'The booking was approved, but the confirmation email failed. Check the EmailJS service, template, and recipient field configuration.',
                        confirmButtonText: 'OK'
                    });
                });
            }
        }

        const shouldTriggerCancel = "<%= typeof triggerCancel !== 'undefined' ? triggerCancel : false %>";
        if (shouldTriggerCancel === "true") {
            const cEmail = "<%= typeof cancelGuestEmail !== 'undefined' ? cancelGuestEmail : '' %>";
            const cName = "<%= typeof cancelGuestName !== 'undefined' ? cancelGuestName : '' %>";
            if (cEmail && cEmail !== "null" && cEmail !== "") {
              const cancelParams = {
                to_email: cEmail,
                user_name: cName,
                booking_id: "<%= typeof cancelGuestId !== 'undefined' ? cancelGuestId : '' %>",
                room_type: "<%= typeof cancelGuestRoom !== 'undefined' ? cancelGuestRoom : 'Standard' %>" || "Standard",
                checkin_date: "<%= typeof cancelGuestCheckin !== 'undefined' ? cancelGuestCheckin : '' %>",
                status_type: "<%= typeof cancelGuestSource !== 'undefined' && cancelGuestSource === 'WALK_IN' ? 'Walk-in Booking' : 'Approved Booking' %>",
                cancel_reason: "Cancelled by admin upon guest request",
                message: "<%= typeof cancelGuestSource !== 'undefined' && cancelGuestSource === 'WALK_IN' ? 'Your walk-in booking has been cancelled by our resort team. We hope to welcome you again in the future!' : 'Your booking has been successfully cancelled by our admin team. We hope to welcome you again in the future!' %>"
              };
                            emailjs.send('service_kmlresort', 'template_kule5md', cancelParams, {
                                publicKey: 'EfvIkV0UtUXjEGOgu'
                            })
                .then(() => {
                    console.log("Cancellation email sent to guest:", cEmail);
                    showBookingAlert({
                        icon: 'success',
                        title: 'Cancellation email sent',
                        text: `Sent to ${cEmail}`,
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false
                    });
                })
                .catch((err) => {
                    console.error("Cancel Email Error: ", err);
                    showBookingAlert({
                        icon: 'error',
                        title: 'Booking cancelled, email not sent',
                        text: 'Please check the EmailJS configuration. The booking was cancelled, but the guest was not notified by email.',
                        confirmButtonText: 'OK'
                    });
                });
            }
        }

      };

      async function clearNotifications() {
          try {
              const response = await fetch('/notifications/read', { method: 'POST' });
              if (!response.ok) return;
              const bellDot = document.getElementById('bellDot');
              if (bellDot) bellDot.classList.add('d-none');
              document.querySelectorAll('.notification-item.unread').forEach(function(item) {
                  item.classList.remove('unread');
              });
          } catch (error) {
              console.error('Could not mark notifications as read:', error);
          }
      }

      async function deleteNotification(button) {
          const item = button.closest('.notification-item');
          if (!item) return;
          button.disabled = true;
          try {
              const response = await fetch('/notifications/' + encodeURIComponent(item.dataset.notificationId) + '/delete', { method: 'POST' });
              if (!response.ok) throw new Error('Could not delete notification.');
              const result = await response.json();
              item.remove();
              const list = document.querySelector('.notification-list');
              const total = document.querySelector('.notification-total');
              const remaining = document.querySelectorAll('.notification-item').length;
              if (total) total.textContent = remaining;
              if (result.unreadCount === 0) document.getElementById('bellDot')?.classList.add('d-none');
              if (remaining === 0 && list) {
                  list.innerHTML = '<div class="notification-empty"><i class="bi bi-bell-slash" aria-hidden="true"></i><span>You\'re all caught up</span></div>';
              }
          } catch (error) {
              button.disabled = false;
              console.error('Could not delete notification:', error);
          }
      }

      const ktvAvailabilityRequests = new Map();
      async function refreshEditKtvSlots(bookingId, bookingDate, select) {
          const message = document.getElementById('editKtvAvailability' + bookingId);
          const requestId = (ktvAvailabilityRequests.get(bookingId) || 0) + 1;
          ktvAvailabilityRequests.set(bookingId, requestId);
          const currentValue = select.value;

          if (!bookingDate) {
              select.replaceChildren(new Option('Choose a booking date first', ''));
              select.disabled = true;
              message.textContent = 'Choose a booking date to view slot availability.';
              return;
          }

          select.replaceChildren(new Option('Loading availability...', ''));
          select.disabled = true;
          try {
              const params = new URLSearchParams({ date: bookingDate, excludeBookingId: bookingId });
              const response = await fetch(`/api/ktv-schedule?${params}`, { cache: 'no-store' });
              if (!response.ok) throw new Error(`KTV availability request failed with status ${response.status}.`);
              const data = await response.json();
              if (!data.success || !Array.isArray(data.slots) || !Array.isArray(data.bookings)) {
                  throw new Error(data.error || 'The KTV availability response was invalid.');
              }
              if (ktvAvailabilityRequests.get(bookingId) !== requestId) return;

              const reserved = data.bookings.filter(item => String(item.date).slice(0, 10) === bookingDate);
              const unavailableTimes = new Set(reserved.map(item => String(item.startTime || '').slice(0, 8)).filter(Boolean));
              const hasUnscheduledBooking = reserved.some(item => item.schedulePending);
              select.replaceChildren(new Option('Choose a slot', ''));
              data.slots.forEach(slot => {
                  const option = new Option(slot.label, slot.start);
                  if (hasUnscheduledBooking || unavailableTimes.has(slot.start)) {
                      option.disabled = true;
                      option.textContent = `${slot.label} — Booked`;
                  } else {
                      option.textContent = `${slot.label} — Available`;
                  }
                  select.add(option);
              });
              const normalizedCurrentValue = String(currentValue || '').slice(0, 8);
              if (normalizedCurrentValue && !hasUnscheduledBooking && !unavailableTimes.has(normalizedCurrentValue)) {
                  select.value = normalizedCurrentValue;
              }
              const availableSlots = data.slots.filter(slot => !hasUnscheduledBooking && !unavailableTimes.has(slot.start));
              select.disabled = availableSlots.length === 0;
              message.textContent = hasUnscheduledBooking
                  ? 'A KTV booking on this date has no assigned time.'
                  : availableSlots.length
                      ? `${availableSlots.length} time slot${availableSlots.length === 1 ? '' : 's'} available.`
                      : 'All KTV time slots are booked for this date.';
          } catch (error) {
              if (ktvAvailabilityRequests.get(bookingId) !== requestId) return;
              console.error('Failed to load KTV slot availability:', error);
              select.replaceChildren(new Option('Availability unavailable', ''));
              message.textContent = 'Could not load KTV availability.';
          }
      }

      function updateGuestCountLimit(bookingId) {
          const roomSelect = document.getElementById('roomSelect' + bookingId);
          const guestInput = document.getElementById('guestSelect' + bookingId);
          if (!roomSelect || !guestInput) return;
          const selectedOption = roomSelect.options[roomSelect.selectedIndex];
          const maxOccupancy = parseInt(selectedOption.getAttribute('data-occupancy')) || 1;
          const isCottage = selectedOption.getAttribute('data-category') === 'Cottage';
          const guestLimit = isCottage ? maxOccupancy : 20;
          guestInput.max = String(guestLimit);
          const currentValue = Number(guestInput.value) || 1;
          if (currentValue > guestLimit) guestInput.value = String(guestLimit);
          if (currentValue < 1) guestInput.value = '1';
      }

      function toggleEditModalFields(bookingId) {
          const roomSelect = document.getElementById('roomSelect' + bookingId);
          if (!roomSelect) return;
          const selectedOption = roomSelect.options[roomSelect.selectedIndex];
          const category = selectedOption.getAttribute('data-category') || 'Room';
          const isCottage = (category === 'Cottage');
          const roomFields = document.getElementById('editRoomFields' + bookingId);
          const cottageFields = document.getElementById('editCottageFields' + bookingId);
          if (roomFields) roomFields.style.display = isCottage ? 'none' : 'flex';
          if (cottageFields) cottageFields.style.display = isCottage ? 'flex' : 'none';
          updateGuestCountLimit(bookingId);
          updateEditAddonFields(bookingId);
      }

      function updateEditAddonFields(bookingId) {
          const roomSelect = document.getElementById('roomSelect' + bookingId);
          const guestSelect = document.getElementById('guestSelect' + bookingId);
          const poolOption = document.getElementById('editPoolOption' + bookingId);
          const poolCounts = document.getElementById('editPoolCounts' + bookingId);
          const summary = document.getElementById('editChargeSummary' + bookingId);
          if (!roomSelect || !guestSelect || !poolOption || !poolCounts || !summary) return;

          const selectedOption = roomSelect.options[roomSelect.selectedIndex];
          const isCottage = selectedOption.dataset.category === 'Cottage';
          const occupancy = Number(selectedOption.dataset.occupancy) || 1;
          const guests = Number(guestSelect.value) || 1;
          const extraGuests = isCottage ? 0 : Math.max(0, guests - occupancy);
          const poolCheckbox = document.getElementById('editPoolAddon' + bookingId);
          const adultCount = document.getElementById('editPoolAdultCount' + bookingId);
          const childCount = document.getElementById('editPoolChildCount' + bookingId);
          const ktvCheckbox = document.getElementById('editKtvAddon' + bookingId);
          const ktvGuestCount = document.getElementById('editKtvGuestCount' + bookingId);
          const ktvGuestCountFields = document.getElementById('editKtvGuestCountFields' + bookingId);
          const ktvStartTime = document.getElementById('editKtvStartTime' + bookingId);
          poolOption.style.display = isCottage || extraGuests > 0 ? '' : 'none';
          if (!isCottage && extraGuests === 0) {
              poolCheckbox.checked = false;
              adultCount.value = '0';
              childCount.value = '0';
          }
          poolCounts.style.display = poolCheckbox.checked ? 'flex' : 'none';
          const poolEligible = isCottage ? guests : extraGuests;
          adultCount.max = String(poolEligible);
          childCount.max = String(poolEligible);
          if (poolCheckbox.checked) {
              const eligibleAdults = Math.min(Number(adultCount.value) || 0, poolEligible);
              adultCount.value = String(eligibleAdults);
              childCount.value = String(Math.min(Number(childCount.value) || 0, poolEligible - eligibleAdults));
          }
          const maxKtvGuests = Math.min(15, guests);
          ktvGuestCount.max = String(maxKtvGuests);
          ktvGuestCountFields.style.display = ktvCheckbox.checked ? '' : 'none';
          ktvGuestCount.disabled = !ktvCheckbox.checked;
          ktvStartTime.disabled = !ktvCheckbox.checked;
          if (ktvCheckbox.checked) {
              if (ktvGuestCount.value && Number(ktvGuestCount.value) > maxKtvGuests) {
                  ktvGuestCount.value = String(maxKtvGuests);
              }
          } else {
              ktvGuestCount.value = '0';
          }

          const dateInput = document.getElementById((isCottage ? 'editBookingDate' : 'editCheckinDate') + bookingId);
          const date = dateInput ? dateInput.value : '';
          if (ktvCheckbox.checked) {
              refreshEditKtvSlots(bookingId, date, ktvStartTime);
          } else {
              ktvStartTime.replaceChildren(new Option('Select KTV to view availability', ''));
              ktvStartTime.disabled = true;
              document.getElementById('editKtvAvailability' + bookingId).textContent = '';
          }
          const nights = isCottage || !date ? 0 : Math.max(1, Math.ceil((new Date(getAutoCheckout(date)) - new Date(date)) / 86400000));
          const extraFee = extraGuests * 200 * nights;
          const entranceFee = isCottage ? guests * 30 : 0;
          const poolFee = poolCheckbox.checked
              ? (Number(adultCount.value) || 0) * 150 + (Number(childCount.value) || 0) * 100
              : 0;
          const ktvFee = document.getElementById('editKtvAddon' + bookingId).checked ? 1000 : 0;
          summary.textContent = `Entrance: ${isCottage ? '₱' + entranceFee.toLocaleString() : 'Free'} · Extra overnight guests: ₱${extraFee.toLocaleString()} · Pool: ₱${poolFee.toLocaleString()} · KTV: ₱${ktvFee.toLocaleString()}`;
      }

      function prepareEditSubmit(bookingId) {
          const roomSelect = document.getElementById('roomSelect' + bookingId);
          if (!roomSelect) return 'Room selection was not found. Please reload the page and try again.';
          const selectedOption = roomSelect.options[roomSelect.selectedIndex];
          const category = selectedOption.getAttribute('data-category') || 'Room';
          const isCottage = (category === 'Cottage');
          const hiddenCheckin = document.getElementById('editCheckinHidden' + bookingId);
          const hiddenCheckout = document.getElementById('editCheckoutHidden' + bookingId);
          if (!hiddenCheckin || !hiddenCheckout) return 'Date fields were not found. Please reload the page and try again.';

          if (isCottage) {
              const dateInput = document.getElementById('editBookingDate' + bookingId);
              const inTimeInput = document.getElementById('editCheckinTime' + bookingId);
              const outTimeInput = document.getElementById('editCheckoutTime' + bookingId);
              if (!dateInput || !inTimeInput || !outTimeInput) return 'Cottage booking fields were not found. Please reload the page and try again.';
              const date = dateInput.value;
              const inTime = inTimeInput.value;
              const outTime = outTimeInput.value;
              if (!date || !inTime || !outTime) return 'Please fill in the booking date, check-in time, and check-out time.';
              if (timeToMinutes(outTime) <= timeToMinutes(inTime)) return 'Check-out time must be later than check-in time.';
              hiddenCheckin.value = date + ' ' + inTime + ':00';
              hiddenCheckout.value = date + ' ' + outTime + ':00';
          } else {
              const checkinInput = document.getElementById('editCheckinDate' + bookingId);
              if (!checkinInput) return 'The check-in date field was not found. Please reload the page and try again.';
              const checkin = checkinInput.value;
              if (!checkin) return 'Please select a check-in date.';
              // Auto-calculate checkout: next day, skip Mon/Tue
              hiddenCheckin.value = checkin;
              hiddenCheckout.value = getAutoCheckout(checkin);
          }

          const guestInput = document.getElementById('guestSelect' + bookingId);
          const guestCount = Number(guestInput?.value);
          const guestLimit = isCottage
              ? Number(selectedOption.getAttribute('data-occupancy')) || 1
              : 20;
          if (!Number.isInteger(guestCount) || guestCount < 1 || guestCount > guestLimit) {
              return `Enter a whole number of guests between 1 and ${guestLimit}.`;
          }
          const includedOccupancy = Number(selectedOption.getAttribute('data-occupancy')) || 1;
          const eligiblePoolGuests = isCottage ? guestCount : Math.max(0, guestCount - includedOccupancy);
          const poolCheckbox = document.getElementById('editPoolAddon' + bookingId);
          const poolAdults = Number(document.getElementById('editPoolAdultCount' + bookingId)?.value) || 0;
          const poolChildren = Number(document.getElementById('editPoolChildCount' + bookingId)?.value) || 0;
          if (poolCheckbox?.checked && (poolAdults + poolChildren < 1 || poolAdults + poolChildren > eligiblePoolGuests)) {
              return `Enter pool counts for no more than ${eligiblePoolGuests} eligible guest${eligiblePoolGuests === 1 ? '' : 's'}.`;
          }
          const ktvCheckbox = document.getElementById('editKtvAddon' + bookingId);
          const ktvGuestCount = Number(document.getElementById('editKtvGuestCount' + bookingId)?.value) || 0;
          if (ktvCheckbox?.checked && (ktvGuestCount < 1 || ktvGuestCount > Math.min(15, guestCount))) {
              return `KTV guests must be between 1 and ${Math.min(15, guestCount)}.`;
          }
          return null;
      }

      // ============================================
      // Runs once the page has fully loaded, wiring up all the
      // interactive bits below. Grouping every "find these elements,
      // attach a listener" step in one place (instead of scattering
      // onclick="..." attributes through the HTML) makes it much
      // easier to see, at a glance, everything this page can do.
      // ============================================
      document.addEventListener('DOMContentLoaded', function() {
          document.querySelectorAll('.booking-flash-alert').forEach(function(alert) {
              window.setTimeout(function() {
                  if (alert.isConnected) bootstrap.Alert.getOrCreateInstance(alert).close();
              }, 3500);
          });

          document.querySelectorAll('.booking-actions-dropdown').forEach(function(dropdown) {
              const toggle = dropdown.querySelector('[data-bs-toggle="dropdown"]');
              const menu = dropdown.querySelector('.dropdown-menu');
              if (!toggle || !menu) return;

              dropdown.addEventListener('show.bs.dropdown', function() {
                  document.body.appendChild(menu);
              });

              dropdown.addEventListener('shown.bs.dropdown', function() {
                  const toggleRect = toggle.getBoundingClientRect();
                  const menuRect = menu.getBoundingClientRect();
                  const gap = 4;
                  const left = Math.max(gap, Math.min(toggleRect.right - menuRect.width, window.innerWidth - menuRect.width - gap));
                  const top = toggleRect.bottom + menuRect.height + gap <= window.innerHeight
                      ? toggleRect.bottom + gap
                      : Math.max(gap, toggleRect.top - menuRect.height - gap);

                  Object.assign(menu.style, {
                      position: 'fixed',
                      inset: 'auto',
                      top: top + 'px',
                      left: left + 'px',
                      right: 'auto',
                      bottom: 'auto',
                      margin: '0',
                      transform: 'none'
                  });
              });

              dropdown.addEventListener('hidden.bs.dropdown', function() {
                  dropdown.appendChild(menu);
                  menu.removeAttribute('style');
              });
          });

          document.querySelectorAll('.approve-booking-btn').forEach(function(button) {
              button.addEventListener('click', async function(event) {
                  event.preventDefault();
                  const form = button.closest('form');
                  const result = await showBookingAlert({
                      icon: 'question',
                      title: 'Approve booking?',
                      text: 'Do you want to approve this booking?',
                      showCancelButton: true,
                      confirmButtonText: 'Approve booking',
                      cancelButtonText: 'Cancel'
                  });

                  if (result.isConfirmed && form) form.submit();
              });
          });

          document.querySelectorAll('form[data-swal-confirm]').forEach(function(form) {
              form.addEventListener('submit', async function(event) {
                  event.preventDefault();
                  const result = await showBookingAlert({
                      icon: form.dataset.swalIcon || 'warning',
                      title: form.dataset.swalTitle || 'Are you sure?',
                      text: form.dataset.swalConfirm,
                      showCancelButton: true,
                      confirmButtonText: form.dataset.swalConfirmButton || 'Continue',
                      cancelButtonText: 'Cancel'
                  });
                  if (result.isConfirmed) form.submit();
              });
          });

          document.querySelectorAll('.edit-booking-form').forEach(function(form) {
              form.addEventListener('submit', async function(event) {
                  event.preventDefault();
                  if (!form.checkValidity()) {
                      await showBookingAlert({
                          icon: 'warning',
                          title: 'Check the booking details',
                          text: 'Please complete all required fields with valid values.'
                      });
                      form.querySelector(':invalid')?.focus();
                      return;
                  }

                  const match = (form.getAttribute('action') || '').match(/\/update\/(\d+)/);
                  const validationMessage = match ? prepareEditSubmit(match[1]) : 'Booking form could not be validated.';
                  if (validationMessage) {
                      await showBookingAlert({ icon: 'warning', title: 'Booking details need attention', text: validationMessage });
                      return;
                  }
                  form.submit();
              });
          });

          // Room-type dropdown inside each "Edit Booking" modal:
          // switching between a Room and a Cottage shows/hides the
          // right date fields and refreshes the guest-count options.
          // Scoped to <select> elements so only room selectors are wired here.
          document.querySelectorAll('select[data-booking-id]').forEach(function(select) {
              select.addEventListener('change', function() {
                  toggleEditModalFields(this.getAttribute('data-booking-id'));
              });
          });

          document.querySelectorAll('input[id^="guestSelect"]').forEach(function(input) {
              ['input', 'change'].forEach(function(eventName) {
                  input.addEventListener(eventName, function() {
                      updateEditAddonFields(this.id.replace('guestSelect', ''));
                  });
              });
          });
          document.querySelectorAll('input[id^="editPoolAddon"], input[id^="editKtvAddon"], input[id^="editPoolAdultCount"], input[id^="editPoolChildCount"], input[id^="editKtvGuestCount"], input[id^="editCheckinDate"], input[id^="editBookingDate"]').forEach(function(input) {
              const bookingId = input.id.match(/\d+$/)?.[0];
              if (!bookingId) return;
              function refreshAddonFields() {
                  if (input.id.startsWith('editKtvAddon') && input.checked) {
                      const guests = Number(document.getElementById('guestSelect' + bookingId)?.value) || 1;
                      const ktvGuestCount = document.getElementById('editKtvGuestCount' + bookingId);
                      if (!Number(ktvGuestCount.value)) ktvGuestCount.value = String(Math.min(15, guests));
                  }
                  updateEditAddonFields(bookingId);
              }
              input.addEventListener('input', refreshAddonFields);
              input.addEventListener('change', refreshAddonFields);
          });

          document.querySelectorAll('.approved-edit-checkin').forEach(function(input) {
              function updateCheckoutPreview() {
                  const preview = document.getElementById('editCheckoutPreview' + input.dataset.bookingId);
                  if (preview) preview.value = input.value ? getAutoCheckout(input.value) : '';
              }
              input.addEventListener('input', updateCheckoutPreview);
              input.addEventListener('change', updateCheckoutPreview);
          });

          // Make sure each edit modal shows the correct fields the
          // moment it opens (not just after the dropdown is touched).
          document.querySelectorAll('.modal').forEach(function(modal) {
              modal.addEventListener('shown.bs.modal', function() {
                  const form = modal.querySelector('form');
                  if (form) {
                      const match = (form.getAttribute('action') || '').match(/\/update\/(\d+)/);
                      if (match) toggleEditModalFields(match[1]);
                  }
              });
          });

          document.querySelectorAll('.booking-edit-guide').forEach(function(button) {
              new bootstrap.Popover(button, {
                  container: 'body',
                  html: true,
                  trigger: 'focus',
                  placement: 'auto'
              });
          });

      });
    </script>

    <style>
            .booking-alert-show { animation: bookingAlertEnter 240ms ease-out; }
            .booking-alert-hide { animation: bookingAlertExit 160ms ease-in forwards; }
            @keyframes bookingAlertEnter {
                from { opacity: 0; transform: translateY(12px) scale(0.96); }
                to { opacity: 1; transform: translateY(0) scale(1); }
            }
            @keyframes bookingAlertExit {
                to { opacity: 0; transform: translateY(8px) scale(0.98); }
            }
            @media (prefers-reduced-motion: reduce) {
                .booking-alert-show, .booking-alert-hide { animation: none; }
            }
    </style>
</head>
<body>
