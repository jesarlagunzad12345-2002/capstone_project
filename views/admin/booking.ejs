                                                    <div class="form-check mb-2" id="editPoolOption<%= booking.id %>">
                                                        <input class="form-check-input" type="checkbox" name="addons" value="pool" id="editPoolAddon<%= booking.id %>" <%= bookingAddons.poolSelected ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-semibold" for="editPoolAddon<%= booking.id %>">Paid swimming pool</label>
                                                    </div>
                                                    <div class="row g-2 mb-2" id="editPoolCounts<%= booking.id %>" <%= bookingAddons.poolSelected ? '' : 'style="display:none"' %>>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editPoolAdultCount<%= booking.id %>">Pool adults</label>
                                                            <input class="form-control form-control-sm" type="number" min="0" name="poolAdultCount" id="editPoolAdultCount<%= booking.id %>" value="<%= bookingAddons.poolAdultCount %>">
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editPoolChildCount<%= booking.id %>">Pool children under 4 ft</label>
                                                            <input class="form-control form-control-sm" type="number" min="0" name="poolChildCount" id="editPoolChildCount<%= booking.id %>" value="<%= bookingAddons.poolChildCount %>">
                                                        </div>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="addons" value="ktv" id="editKtvAddon<%= booking.id %>" <%= bookingAddons.ktvSelected ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-semibold" for="editKtvAddon<%= booking.id %>">KTV room</label>
                                                    </div>
                                                    <div class="row g-2 mt-1" id="editKtvGuestCountFields<%= booking.id %>" <%= bookingAddons.ktvSelected ? '' : 'style="display:none"' %>>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editKtvGuestCount<%= booking.id %>">KTV guests (max 15)</label>
                                                            <input class="form-control form-control-sm" type="number" min="1" max="15" step="1" name="ktvGuestCount" id="editKtvGuestCount<%= booking.id %>" value="<%= bookingAddons.ktvGuestCount || 1 %>" <%= bookingAddons.ktvSelected ? '' : 'disabled' %>>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small" for="editKtvStartTime<%= booking.id %>">KTV time slot on booking date</label>
                                                            <select class="form-select form-select-sm" name="ktvStartTime" id="editKtvStartTime<%= booking.id %>" <%= bookingAddons.ktvSelected ? '' : 'disabled' %>>
                                                                <option value="">Loading availability...</option>
                                                                <option value="08:00:00" <%= booking.ktv_start_time && String(booking.ktv_start_time).slice(0, 8) === '08:00:00' ? 'selected' : '' %>>8:00 AM–11:00 AM</option>
                                                                <option value="11:00:00" <%= booking.ktv_start_time && String(booking.ktv_start_time).slice(0, 8) === '11:00:00' ? 'selected' : '' %>>11:00 AM–2:00 PM</option>
                                                                <option value="15:00:00" <%= booking.ktv_start_time && String(booking.ktv_start_time).slice(0, 8) === '15:00:00' ? 'selected' : '' %>>3:00 PM–6:00 PM</option>
                                                            </select>
                                                            <div class="form-text" id="editKtvAvailability<%= booking.id %>" aria-live="polite"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-uppercase small fw-bold text-muted" for="approvedEditRequests<%= booking.id %>">Special Requests</label>
                                                    <textarea id="approvedEditRequests<%= booking.id %>" name="requests" class="form-control py-2 bg-light border-0 rounded-3" rows="3" placeholder="No special requests"><%= stripCalculatedBookingRequests(booking.requests) || '' %></textarea>
                                                </div>
                                                </section>
                                            </div>
                                            <div class="modal-footer booking-edit-modal-footer">
                                                <button type="button" class="btn btn-light w-100 py-2 fw-bold" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            </div>

            <div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header booking-details-header">
                            <div>
                                <p class="booking-details-eyebrow">CUSTOMER RESERVATION</p>
                                <h2 class="modal-title h5 fw-bold mb-0" id="bookingDetailsModalTitle">Booking details</h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body booking-details-body">
                            <div class="booking-details-grid">
                                <section class="booking-details-card">
                                    <h3><i class="bi bi-person-vcard" aria-hidden="true"></i> Guest information</h3>
                                    <dl class="booking-details-list">
                                        <dt>Booking ID</dt><dd id="detailId"></dd>
                                        <dt>Customer name</dt><dd id="detailName"></dd>
                                        <dt>Email</dt><dd id="detailEmail"></dd>
                                        <dt>Phone</dt><dd id="detailPhone"></dd>
                                        <dt>Booking source</dt><dd id="detailSource"></dd>
                                    </dl>
                                </section>
                                <section class="booking-details-card">
                                    <h3><i class="bi bi-calendar2-week" aria-hidden="true"></i> Stay details</h3>
                                    <dl class="booking-details-list">
                                        <dt>Room or cottage</dt><dd id="detailRoom"></dd>
                                        <dt>Guests</dt><dd id="detailPeople"></dd>
                                        <dt>Check-in</dt><dd id="detailCheckin"></dd>
                                        <dt>Check-out</dt><dd id="detailCheckout"></dd>
                                        <dt>Nights</dt><dd id="detailNights"></dd>
                                        <dt>Booking status</dt><dd id="detailStatus"></dd>
                                    </dl>
                                </section>
                                <section class="booking-details-card">
                                    <h3><i class="bi bi-stars" aria-hidden="true"></i> Extras and fees</h3>
                                    <dl class="booking-details-list">
                                        <dt>Swimming pool</dt><dd id="detailPool"></dd>
                                        <dt>KTV room</dt><dd id="detailKtv"></dd>
                                        <dt>Entrance fee</dt><dd id="detailEntranceFee"></dd>
                                        <dt>Additional overnight guests</dt><dd id="detailExtraGuests"></dd>
                                    </dl>
                                </section>
                                <section class="booking-details-card">
                                    <h3><i class="bi bi-credit-card" aria-hidden="true"></i> Payment</h3>
                                    <dl class="booking-details-list">
                                        <dt class="detail-payment-status">Payment status</dt><dd id="detailPaymentStatus" class="detail-payment-status"></dd>
                                        <dt>Payment method</dt><dd id="detailPaymentMethod"></dd>
                                        <dt>Payment reference</dt><dd id="detailReference"></dd>
                                        <dt class="detail-payment-submission">Payment submitted</dt><dd id="detailPaymentSubmitted" class="detail-payment-submission"></dd>
                                        <dt class="detail-payment-downpayment">Downpayment</dt><dd id="detailDownpayment" class="detail-payment-downpayment"></dd>
                                        <dt>Total price</dt><dd id="detailTotal" class="booking-details-total"></dd>
                                        <dt>Amount paid</dt><dd id="detailPaid"></dd>
                                        <dt>Balance</dt><dd id="detailBalance"></dd>
                                    </dl>
                                </section>
                                <section class="booking-details-card booking-details-card-wide">
                                    <h3><i class="bi bi-clock-history" aria-hidden="true"></i> Booking notes</h3>
                                    <dl class="booking-details-list booking-details-list-single">
                                        <dt>Booking created</dt><dd id="detailCreatedAt"></dd>
                                        <dt>Special requests / notes</dt><dd id="detailRequests" class="booking-details-notes"></dd>
                                    </dl>
                                </section>
                            </div>
                        </div>
                        <div class="modal-footer booking-details-footer">
                            <button type="button" class="btn btn-dark px-4" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

            <% const bookingsWithRequests = bookings.filter(booking => stripCalculatedBookingRequests(booking.requests)); %>
            <div id="specialRequestsView" class="d-none" role="tabpanel" aria-labelledby="specialRequestsViewTab">
                <div class="special-requests-heading">
                    <div>
                        <p class="special-requests-eyebrow mb-1">GUEST NOTES</p>
                        <h2 class="h5 fw-bold text-dark mb-1">Requests for upcoming stays</h2>
                        <p class="text-muted small mb-0">Personal details and stay information, together with each guest's request.</p>
                    </div>
                    <div class="special-requests-count" aria-label="<%= bookingsWithRequests.length %> requests">
                        <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                        <span><%= bookingsWithRequests.length %></span>
                        <span><%= bookingsWithRequests.length === 1 ? 'request' : 'requests' %></span>
                    </div>
                </div>

                <% if (bookingsWithRequests.length === 0) { %>
                    <div class="special-requests-empty">
                        <span class="special-requests-empty-icon"><i class="bi bi-chat-square-heart" aria-hidden="true"></i></span>
                        <h3 class="h6 fw-bold mb-1">Nothing to follow up on</h3>
                        <p class="text-muted small mb-0">Guest requests will appear here when they are added to a booking.</p>
                    </div>
                <% } else { %>
                    <div class="special-request-list">
                        <% bookingsWithRequests.forEach(booking => { %>
                            <% const isWalkInRequest = (booking.bookingSource || 'ONLINE') === 'WALK_IN'; %>
                            <% const requestStatus = String(booking.status || 'pending').replaceAll('_', ' '); %>
                            <article class="special-request-card">
                                <div class="special-request-card-header">
                                    <div class="special-request-guest">
                                        <span class="special-request-avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                                        <div class="min-w-0">
                                            <h3 class="h6 fw-bold mb-1"><%= booking.name %></h3>
                                            <p class="special-request-email mb-0"><%= booking.email %></p>
                                        </div>
                                    </div>
                                    <div class="special-request-badges">
                                        <span class="badge <%= isWalkInRequest ? 'bg-info-subtle text-info-emphasis' : 'bg-primary-subtle text-primary-emphasis' %>"><%= isWalkInRequest ? 'WALK-IN' : 'ONLINE' %></span>
                                        <span class="special-request-status special-request-status-<%= requestStatus.replaceAll(' ', '-') %>"><span class="special-request-status-dot"></span><%= requestStatus %></span>
                                    </div>
                                </div>

                                <div class="special-request-stay">
                                    <div class="special-request-detail">
                                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                                        <div>
                                            <span class="special-request-label">STAY</span>
                                            <span class="special-request-value"><%= shortDate(booking.checkin) %> – <%= shortDate(booking.checkout) %></span>
                                        </div>
                                    </div>
                                    <div class="special-request-detail">
                                        <i class="bi bi-house-door" aria-hidden="true"></i>
                                        <div>
                                            <span class="special-request-label">ROOM OR COTTAGE</span>
                                            <span class="special-request-value"><%= booking.roomType || 'Standard' %></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="special-request-note">
                                    <p class="special-request-label mb-2"><i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>GUEST REQUEST</p>
                                    <p class="mb-0"><%= stripCalculatedBookingRequests(booking.requests) %></p>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                <% } %>
            </div>

        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div id="approveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
          <div class="toast-body">
            <i class="bi bi-check-circle-fill me-2"></i>
            Booking for <strong><%= typeof guestName !== 'undefined' ? guestName : '' %></strong> approved and email sent!
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function formatBookingDetailDate(value) {
            if (!value) return 'Not provided';
            const date = new Date(value);
            return Number.isNaN(date.getTime())
                ? value
                : date.toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
        }

        function formatBookingDetailPrice(value) {
            if (value === '' || value === null || value === undefined) return 'Not provided';
            const amount = Number(value);
            return Number.isFinite(amount)
                ? '₱' + amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                : value;
        }

        function getCalculatedFeeFromNotes(requests, prefix) {
            const line = String(requests || '').split(/\r?\n/).find(function(note) {
                return note.startsWith(prefix);
            });
            const match = line && line.match(/=\s*₱([\d,]+(?:\.\d{1,2})?)/);
            return match ? Number(match[1].replace(/,/g, '')) : null;
        }

        document.querySelectorAll('.booking-detail-btn').forEach(function(button) {
            button.addEventListener('click', function() {
                const detail = (field, value, fallback = 'Not provided') => {
                    document.getElementById(field).textContent = value || fallback;
                };
                const requests = button.dataset.requests || '';
                const poolSelected = button.dataset.poolSelected === 'true';
                const poolAdults = Number(button.dataset.poolAdults) || 0;
                const poolChildren = Number(button.dataset.poolChildren) || 0;
                const poolFee = Number(button.dataset.poolFee) || 0;
                const ktvSelected = button.dataset.ktvSelected === 'true';
                const ktvGuestCount = Number(button.dataset.ktvGuests) || 0;
                const ktvFee = Number(button.dataset.ktvFee) || 0;
                const entranceNoteFee = getCalculatedFeeFromNotes(requests, 'Entrance fee:');
                const extraGuestLine = requests.split(/\r?\n/).find(function(note) {
                    return note.startsWith('Overnight extra guests:');
                });
                const extraGuestMatch = extraGuestLine && extraGuestLine.match(/Overnight extra guests:\s*(\d+)\s*×\s*₱([\d,]+)\s*×\s*(\d+)\s*night/i);
                const savedExtraGuestCount = Number(button.dataset.extraGuestCount) || 0;
                const extraGuestCount = savedExtraGuestCount > 0
                    ? savedExtraGuestCount
                    : (extraGuestMatch ? Number(extraGuestMatch[1]) : 0);
                const extraGuestRate = Number(button.dataset.extraGuestRate) || 200;
                const savedExtraGuestFee = Number(button.dataset.extraGuestFee) > 0
                    ? Number(button.dataset.extraGuestFee)
                    : (extraGuestMatch ? Number(extraGuestMatch[1]) * Number(extraGuestMatch[2].replace(/,/g, '')) * Number(extraGuestMatch[3]) : 0);
                const savedEntranceFee = Number(button.dataset.entranceFee) || 0;
                const entranceFee = savedEntranceFee > 0
                    ? savedEntranceFee
                    : (entranceNoteFee !== null ? entranceNoteFee : button.dataset.entranceFee !== '' ? 0 : null);

                detail('detailId', button.dataset.id);
                document.getElementById('bookingDetailsModalTitle').textContent = `Booking #${button.dataset.id}`;
                detail('detailName', button.dataset.name);
                detail('detailEmail', button.dataset.email);
                detail('detailPhone', button.dataset.phone);
                detail('detailRoom', button.dataset.room);
                detail('detailPeople', button.dataset.people);
                detail('detailCheckin', formatBookingDetailDate(button.dataset.checkin));
                detail('detailCheckout', formatBookingDetailDate(button.dataset.checkout));
                detail('detailNights', button.dataset.nights);
                document.getElementById('detailPool').textContent = poolSelected
                    ? `${poolAdults} adult${poolAdults === 1 ? '' : 's'}, ${poolChildren} child${poolChildren === 1 ? '' : 'ren'} under 4 ft — ${formatBookingDetailPrice(poolFee)}`
                    : 'Not selected';
                document.getElementById('detailKtv').textContent = ktvSelected
                    ? `${ktvGuestCount} guest${ktvGuestCount === 1 ? '' : 's'} (3 hours) — ${formatBookingDetailPrice(ktvFee)}`
                    : 'Not selected';
                document.getElementById('detailEntranceFee').textContent = entranceFee === null
                    ? 'Not recorded'
                    : entranceFee > 0 ? formatBookingDetailPrice(entranceFee) : 'Free — ₱0.00';
                document.getElementById('detailExtraGuests').textContent = extraGuestCount > 0
                    ? `${extraGuestCount} guest${extraGuestCount === 1 ? '' : 's'} × ${formatBookingDetailPrice(extraGuestRate)} per night — ${formatBookingDetailPrice(savedExtraGuestFee)}`
                    : 'None — ₱0.00';
                detail('detailSource', button.dataset.source);
                detail('detailStatus', button.dataset.status.replaceAll('_', ' '));
                detail('detailPaymentStatus', button.dataset.paymentStatus);
                detail('detailPaymentMethod', button.dataset.paymentMethod);
                detail('detailReference', button.dataset.reference);
                detail('detailPaymentSubmitted', formatBookingDetailDate(button.dataset.paymentSubmitted));
                detail('detailDownpayment', formatBookingDetailPrice(button.dataset.downpayment));
                document.querySelectorAll('.detail-payment-status').forEach(function(element) {
                    element.classList.toggle('d-none', button.dataset.source === 'WALK_IN');
                });
                document.querySelectorAll('.detail-payment-submission, .detail-payment-downpayment').forEach(function(element) {
                    element.classList.add('d-none');
                });
                detail('detailTotal', formatBookingDetailPrice(button.dataset.total));
                detail('detailPaid', formatBookingDetailPrice(button.dataset.amountPaid));
                detail('detailBalance', formatBookingDetailPrice(button.dataset.balance));
                detail('detailCreatedAt', formatBookingDetailDate(button.dataset.createdAt));
                detail('detailRequests', button.dataset.requests);
            });
        });

        document.querySelectorAll('.booking-section-tab').forEach(function(button) {
            button.addEventListener('click', function() {
                const showRequests = button.dataset.bookingView === 'requests';
                document.getElementById('bookingRecordsView').classList.toggle('d-none', showRequests);
                document.getElementById('specialRequestsView').classList.toggle('d-none', !showRequests);
                document.getElementById('bookingSourceFilters').classList.toggle('d-none', showRequests);
                document.querySelectorAll('.booking-section-tab').forEach(function(tab) {
                    const isActive = tab === button;
                    tab.classList.toggle('active', isActive);
                    tab.setAttribute('aria-selected', String(isActive));
                });
            });
        });

        document.querySelectorAll('.booking-source-filter').forEach(function(button) {
            button.addEventListener('click', function() {
                document.querySelectorAll('.booking-source-filter').forEach(function(item) {
                    item.classList.toggle('active', item === button);
                    item.classList.toggle('btn-dark', item === button);
                    item.classList.toggle('btn-outline-dark', item !== button);
                });
                var source = button.getAttribute('data-source');
                document.querySelectorAll('[data-booking-source-section]').forEach(function(section) {
                    var showSection = source === 'all' || section.getAttribute('data-booking-source-section') === source;
                    section.classList.toggle('d-none', !showSection);
                });
            });
        });

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }
    </script>
</body>
</html>
