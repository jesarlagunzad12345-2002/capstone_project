<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Live GPS | KML Mountain Resort</title>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/live-map.css">
    <link rel="icon" type="image/png" sizes="32x32" href="img/logo.jpg">
    <base target="_blank">
</head>
<body>

    <div id="live-map"></div>

    <div class="nav-header">
        <div class="header-content">
            <div class="header-left">
                <div class="resort-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="resort-info">
                    <h6 class="resort-name">KML Mountain Resort</h6>
                    <div class="gps-status">
                        <span class="status-dot"></span>
                        <span class="status-text" id="nav-status">GPS Active</span>
                    </div>
                </div>
            </div>

            <a href="/location" class="btn-exit" target="_self">
                <i class="bi bi-x-lg"></i>
                <span>Exit</span>
            </a>
        </div>
    </div>

    <div class="side-controls">
        <button id="recenterBtn" class="control-btn recenter-btn" title="Recenter Map">
            <i class="bi bi-crosshair"></i>
        </button>
        <div class="mode-panel">
            <div class="mode-label">Mode</div>
            <button class="mode-item active" data-mode="car" title="Driving">
                <i class="bi bi-car-front-fill"></i>
            </button>
            <button class="mode-item" data-mode="moto" title="Two-Wheeler">
                <i class="bi bi-bicycle"></i>
            </button>
            <button class="mode-item" data-mode="bike" title="Cycling">
                <i class="bi bi-bicycle"></i>
            </button>
            <button class="mode-item" data-mode="foot" title="Walking">
                <i class="bi bi-person-walking"></i>
            </button>
        </div>
    </div>

    <div class="bottom-dashboard">
        <div class="dashboard-inner">
            <div class="stat-box">
                <div class="stat-icon">
                    <i class="bi bi-signpost-split"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">DISTANCE</span>
                    <div class="stat-row">
                        <span class="stat-value" id="eta-dist">0.0</span>
                        <span class="stat-unit">km</span>
                    </div>
                </div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-box">
                <div class="stat-icon time-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">TRAVEL TIME</span>
                    <div class="stat-row">
                        <span class="stat-value" id="eta-time">--</span>
                        <span class="stat-unit">min</span>
                    </div>
                </div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-box">
                <div class="stat-icon arrival-icon">
                    <i class="bi bi-flag-fill"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">ARRIVAL</span>
                    <div class="stat-row">
                        <span class="stat-value" id="eta-clock">--:--</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="resort-popup" id="resortPopup">
        <div class="popup-header">
            <h5><i class="bi bi-geo-alt-fill"></i> KML Mountain Resort</h5>
            <button class="popup-close" onclick="closeResortPopup()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="popup-body">
            <p class="popup-address">
                <i class="bi bi-pin-map"></i>
                Brgy. Danao, Tigbauan, Iloilo, Philippines
            </p>
            <div class="popup-details">
                <span><i class="bi bi-water"></i> Pool</span>
                <span><i class="bi bi-tree-fill"></i> Nature</span>
                <span><i class="bi bi-wifi"></i> WiFi</span>
                <span><i class="bi bi-car-front-fill"></i> Parking</span>
            </div>
            <p class="popup-desc">
                A peaceful mountain getaway with fresh air, lush greenery, 
                and comfortable accommodations. Perfect for families and groups.
            </p>
            <div class="popup-contact">
                <span><i class="bi bi-telephone"></i> +63 912 345 6789</span>
                <span><i class="bi bi-envelope"></i> hello@kmlresort.com</span>
            </div>
            <a href="/booking" class="btn-book">
                <i class="bi bi-calendar-check"></i> Book Now
            </a>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script src="/js/live-map.js"></script>
</body>
</html>