<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KML Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="img/logo.jpg">
    <style>
        :root {
            --login-forest: #183c32;
            --login-gold: #eab83f;
            --login-muted: #687a73;
        }
        body {
            min-height: 100vh;
            min-height: 100svh;
            margin: 0;
            padding: 1.25rem 0;
            display: flex;
            align-items: center;
            position: relative;
            isolation: isolate;
            background: #17332e;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        body::before,
        body::after {
            content: "";
            position: fixed;
            inset: -10px;
            pointer-events: none;
        }
        body::before {
            z-index: -2;
            background: url('/img/dine.jpg') center 55% / cover no-repeat;
            filter: blur(7px);
            transform: scale(1.03);
        }
        body::after {
            z-index: -1;
            background: rgba(8, 24, 22, 0.42);
        }
        .login-card {
            width: 100%;
            max-width: 420px;
            margin-inline: auto;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.75);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.97);
            box-shadow: 0 24px 70px rgba(4, 20, 16, 0.34);
            backdrop-filter: blur(14px);
        }
        .login-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto;
            height: 5px;
            background: linear-gradient(90deg, #b8892b, #efc85e 55%, #397965);
        }
        .login-brand-mark {
            width: 50px;
            height: 50px;
            margin: 0 auto 0.9rem;
            display: grid;
            place-items: center;
            border: 1px solid #eee1bd;
            border-radius: 15px;
            background: #f8f0dc;
            color: var(--login-forest);
            font-size: 1.25rem;
        }
        .login-eyebrow {
            margin-bottom: 0.25rem;
            color: #8a6c2f;
            font-size: 0.68rem;
            font-weight: 800;
        }
        .login-title {
            margin-bottom: 0.3rem;
            color: #1d3029;
            font-size: 1.5rem;
            font-weight: 800;
        }
        .login-subtitle {
            margin: 0;
            color: var(--login-muted);
            font-size: 0.82rem;
        }
        .login-card .form-label {
            margin-bottom: 0.4rem;
            color: #43574f;
            font-size: 0.76rem;
        }
        .login-card .form-control {
            min-height: 44px;
            border: 1px solid #d9e2dd;
            border-radius: 9px;
            background: #fbfcfb;
        }
        .login-card .form-control:focus {
            border-color: #6d9a88;
            background: #fff;
            box-shadow: 0 0 0 0.22rem rgba(57, 121, 101, 0.14);
        }
        .login-card .btn-warning {
            min-height: 46px;
            border: 1px solid #e2ad2c;
            border-radius: 9px;
            background: var(--login-gold);
            color: #26372f;
            transition: background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        }
        .login-card .btn-warning:hover {
            transform: translateY(-1px);
            border-color: #d5a126;
            background: #f0c653;
            box-shadow: 0 5px 14px rgba(185, 135, 28, 0.2);
        }
        .login-card a.text-warning {
            color: #8a6c2f !important;
            font-weight: 700;
        }
        .login-card a.text-muted {
            color: #687a73 !important;
        }
        .step-section { display: none; animation: fadeIn 0.3s ease; }
        .step-section.active { display: block; }
        .code-input { letter-spacing: 8px; font-size: 1.5rem; text-align: center; font-weight: bold; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        @media (max-width: 575.98px) {
            body { padding: 1rem 0; }
            .login-card { padding: 1.25rem !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="card login-card p-4">

                    <!-- ========== LOGIN FORM ========== -->
                    <div id="loginSection" class="step-section active">
                        <div class="text-center mb-4">
                            <div class="login-brand-mark"><i class="bi bi-lock-fill" aria-hidden="true"></i></div>
                            <p class="login-eyebrow">RESORT OPERATIONS</p>
                            <h2 class="login-title">KML ADMIN</h2>
                            <p class="login-subtitle">Authorized Access Only</p>
                        </div>

                        <% if (error) { %>
                            <div class="alert alert-danger py-2 small text-center"><%= error %></div>
                        <% } %>
                        <% if (success) { %>
                            <div class="alert alert-success py-2 small text-center">Password reset successful! Please log in.</div>
                        <% } %>

                        <form action="/login" method="POST">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Username</label>
                                <input type="text" name="username" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Password</label>
                                <input type="password" name="password" class="form-control" required>
                            </div>
                            <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2">LOGIN</button>
                        </form>

                        <div class="text-center mt-3">
                            <a href="#" onclick="showSection('forgotSection'); return false;" class="text-warning small text-decoration-none">Forgot Password?</a>
                        </div>
                        <div class="text-center mt-2">
                            <a href="/" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Home</a>
                        </div>
                    </div>

                    <!-- ========== STEP 1: FORGOT PASSWORD ========== -->
                    <div id="forgotSection" class="step-section">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-dark"><i class="bi bi-envelope-fill text-warning"></i></h2>
                            <h4 class="fw-bold">Forgot Password?</h4>
                            <p class="text-muted small">Enter your username. We'll send a 6-digit code to your registered email.</p>
                        </div>

                        <div class="alert alert-danger py-2 small text-center d-none" id="forgotError"></div>

                        <form onsubmit="return handleForgot(event);">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Username</label>
                                <input type="text" id="forgotUsername" class="form-control" required placeholder="Enter your username">
                            </div>
                            <button type="submit" class="btn btn-warning w-100 fw-bold py-2" id="sendCodeBtn">
                                <span class="spinner-border spinner-border-sm d-none" id="sendSpinner"></span>
                                Send Verification Code
                            </button>
                        </form>
                        <div class="text-center mt-3">
                            <a href="#" onclick="showSection('loginSection'); return false;" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
                        </div>
                    </div>

                    <!-- ========== STEP 2: VERIFY CODE ========== -->
                    <div id="verifySection" class="step-section">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-dark"><i class="bi bi-shield-lock-fill text-warning"></i></h2>
                            <h4 class="fw-bold">Verify Code</h4>
                            <p class="text-muted small">Enter the 6-digit code from your email. Expires in 15 minutes.</p>
                        </div>

                        <div class="alert alert-danger py-2 small text-center d-none" id="verifyError"></div>

                        <form onsubmit="return handleVerify(event);">
                            <input type="hidden" id="verifyUsername">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">6-Digit Code</label>
                                <input type="text" id="verifyCode" class="form-control code-input" maxlength="6" required placeholder="000000" pattern="\d{6}">
                            </div>
                            <button type="submit" class="btn btn-warning w-100 fw-bold py-2" id="verifyBtn">
                                <span class="spinner-border spinner-border-sm d-none" id="verifySpinner"></span>
                                Verify Code
                            </button>
                        </form>
                        <div class="text-center mt-3">
                            <a href="#" onclick="showSection('forgotSection'); return false;" class="text-muted small text-decoration-none">Didn't receive it? Resend</a>
                        </div>
                    </div>

                    <!-- ========== STEP 3: RESET PASSWORD ========== -->
                    <div id="resetSection" class="step-section">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-dark"><i class="bi bi-key-fill text-warning"></i></h2>
                            <h4 class="fw-bold">Reset Password</h4>
                            <p class="text-muted small">Enter your new password below.</p>
                        </div>

                        <div class="alert alert-danger py-2 small text-center d-none" id="resetError"></div>

                        <form onsubmit="return handleReset(event);">
                            <input type="hidden" id="resetUsername">
                            <input type="hidden" id="resetCodeVal">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">New Password</label>
                                <input type="password" id="newPassword" class="form-control" required minlength="6">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Confirm Password</label>
                                <input type="password" id="confirmPassword" class="form-control" required minlength="6">
                            </div>
                            <button type="submit" class="btn btn-warning w-100 fw-bold py-2" id="resetBtn">
                                <span class="spinner-border spinner-border-sm d-none" id="resetSpinner"></span>
                                Update Password
                            </button>
                        </form>
                        <div class="text-center mt-3">
                            <a href="#" onclick="showSection('loginSection'); return false;" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        // Show/hide sections
        function showSection(id) {
            document.querySelectorAll('.step-section').forEach(el => el.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            document.querySelectorAll('.alert-danger').forEach(el => el.classList.add('d-none'));
        }

        function showError(id, msg) {
            const el = document.getElementById(id);
            el.textContent = msg;
            el.classList.remove('d-none');
        }

        // Step 1: Send verification code
        async function handleForgot(e) {
            e.preventDefault();
            const username = document.getElementById('forgotUsername').value.trim();
            const btn = document.getElementById('sendCodeBtn');
            const spinner = document.getElementById('sendSpinner');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const res = await fetch('/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username })
                });
                const data = await res.json();

                if (data.success) {
                    document.getElementById('verifyUsername').value = username;
                    showSection('verifySection');
                } else {
                    showError('forgotError', data.error);
                }
            } catch (err) {
                showError('forgotError', 'Network error. Please try again.');
            }

            btn.disabled = false;
            spinner.classList.add('d-none');
            return false;
        }

        // Step 2: Verify the code
        async function handleVerify(e) {
            e.preventDefault();
            const username = document.getElementById('verifyUsername').value;
            const code = document.getElementById('verifyCode').value.trim();
            const btn = document.getElementById('verifyBtn');
            const spinner = document.getElementById('verifySpinner');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const res = await fetch('/verify-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, code })
                });
                const data = await res.json();

                if (data.success) {
                    document.getElementById('resetUsername').value = username;
                    document.getElementById('resetCodeVal').value = code;
                    showSection('resetSection');
                } else {
                    showError('verifyError', data.error);
                }
            } catch (err) {
                showError('verifyError', 'Network error. Please try again.');
            }

            btn.disabled = false;
            spinner.classList.add('d-none');
            return false;
        }

        // Step 3: Reset password
        async function handleReset(e) {
            e.preventDefault();
            const username = document.getElementById('resetUsername').value;
            const code = document.getElementById('resetCodeVal').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const btn = document.getElementById('resetBtn');
            const spinner = document.getElementById('resetSpinner');

            if (newPassword !== confirmPassword) {
                showError('resetError', 'Passwords do not match');
                return false;
            }

            btn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const res = await fetch('/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, code, newPassword, confirmPassword })
                });
                const data = await res.json();

                if (data.success) {
                    window.location.href = '/login?reset=success';
                } else {
                    showError('resetError', data.error);
                }
            } catch (err) {
                showError('resetError', 'Network error. Please try again.');
            }

            btn.disabled = false;
            spinner.classList.add('d-none');
            return false;
        }
    </script>
</body>
</html>