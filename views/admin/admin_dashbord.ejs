<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KML Mountain Resort | Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-dark: #0f172a;
            --accent-blue: #38bdf8;
            --bg-body: #f1f5f9;
            --sidebar-width: 280px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-body);
            overflow-x: hidden;
        }

        .sidebar {
            width: var(--sidebar-width);
            background: var(--primary-dark);
            min-height: 100vh;
            position: fixed;
            transition: all 0.3s ease;
            z-index: 1100;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand { padding: 2rem 1.5rem; }
        .brand-logo {
            width: 36px; height: 36px;
            background: var(--accent-blue);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: var(--primary-dark);
        }

        .nav-link {
            color: #94a3b8;
            border-radius: 12px;
            margin: 0.2rem 1rem;
            padding: 0.8rem 1rem;
            font-weight: 500;
            transition: 0.25s;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .nav-link:hover, .nav-link.active {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
        }

        .nav-link.active {
            background: var(--accent-blue) !important;
            color: var(--primary-dark) !important;
            font-weight: 700;
        }

        .nav-label {
            color: #475569;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            padding: 1.5rem 2rem 0.5rem;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1050;
        }

        .main-wrapper {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            transition: all 0.3s ease;
        }

        header {
            height: 72px;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .search-bar {
            background: #f1f5f9;
            border-radius: 12px;
            padding: 0.5rem 1rem;
            width: 320px;
        }

        .search-bar input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 0.9rem;
            width: 100%;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
            transition: transform 0.25s;
        }

        .stat-card:hover { transform: translateY(-5px); }

        .icon-box {
            width: 48px; height: 48px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.25rem;
        }

        .card-custom {
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }

        .status-tag {
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .reset-btn {
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            background: white;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s;
        }

        .reset-btn:hover {
            background: #ef4444;
            color: white;
            border-color: #ef4444;
        }

        @media (max-width: 992px) {
            .sidebar { margin-left: -280px; }
            .sidebar.active { margin-left: 0; box-shadow: 15px 0 30px rgba(0,0,0,0.2); }
            .sidebar.active + .sidebar-overlay { display: block; }
            .main-wrapper { margin-left: 0; width: 100%; }
        }
    </style>
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <div class="d-flex justify-content-end d-lg-none p-3">
            <button class="btn text-white border-0" onclick="toggleSidebar()">
                <i class="bi bi-x-lg fs-4"></i>
            </button>
        </div>

        <div class="sidebar-brand">
            <div class="brand-logo me-2">KML</div>
            <span class="text-white fw-bold">MOUNTAIN RESORT</span>
        </div>

        <div class="nav-label">Main</div>
        <nav class="nav flex-column">
            <a href="/admin-dashboard" class="nav-link active"><i class="bi bi-grid-1x2 me-2"></i> Dashboard</a>
            <a href="/bookings" class="nav-link"><i class="bi bi-calendar-event me-2"></i> Bookings</a>
            <a href="/rooms" class="nav-link"><i class="bi bi-door-open me-2"></i> Rooms</a>

            <div class="nav-label">Operations</div>
            <a href="/food" class="nav-link"><i class="bi bi-egg-fried me-2"></i> Restaurant Menu</a>
        </nav>

        <div class="mt-auto p-4">
            <a href="/logout" class="btn btn-outline-danger w-100 rounded-4 fw-bold">Logout</a>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="d-flex align-items-center justify-content-between px-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-light d-lg-none me-3" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="search-bar d-none d-md-flex align-items-center invisible">
                    <i class="bi bi-search text-muted me-2"></i>
                    <input type="text" placeholder="Search guests, rooms...">
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button class="btn border-0 position-relative text-muted">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
                <a href="/booking" class="btn btn-dark rounded-3 px-3 d-flex align-items-center text-decoration-none">
                    <i href="" class="bi bi-plus-lg me-2"></i> Quick Booking
                </a>
            </div>
        </header>

        <div class="container-fluid p-4">
            <div class="mb-4">
                <h1 class="h3 fw-bold text-dark mb-1">Resort Overview</h1>
                <p class="text-muted small" id="currentDate">Loading...</p>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-box bg-success bg-opacity-10 text-success">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success fw-bold">Live</span>
                                <button class="reset-btn" onclick="resetRevenue()" title="Reset daily revenue">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                                </button>
                            </div>
                        </div>
                        <span class="text-muted small fw-bold text-uppercase">Daily Revenue</span>
                        <h2 class="fw-bold mb-0" id="dailyRevenue">₱0.00</h2>
                        <small class="text-muted" id="lastReset">Never reset</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-people"></i>
                            </div>
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-bold">Live</span>
                        </div>
                        <span class="text-muted small fw-bold text-uppercase">Active Guests</span>
                        <h2 class="fw-bold mb-0" id="activeGuests">0</h2>
                        <small class="text-muted">Approved reservations</small>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-xl-8">
                    <div class="card-custom">
                        <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                            <h5 class="mb-0 fw-bold">Current Bookings</h5>
                            <a href="/bookings" class="text-decoration-none small fw-bold text-info">View All Bookings</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 text-muted small py-3">GUEST</th>
                                        <th class="text-muted small py-3">ROOM</th>
                                        <th class="text-muted small py-3">PEOPLE</th>
                                        <th class="text-muted small py-3">STATUS</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="bookingsTable">
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="card-custom">
                        <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                            <h5 class="mb-0 fw-bold">Quick Actions</h5>
                        </div>
                        <div class="p-4">
                            <a href="/rooms" class="d-flex align-items-center mb-3 text-decoration-none">
                                <div class="icon-box bg-info bg-opacity-10 text-info me-3">
                                    <i class="bi bi-door-open"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold small">Manage Rooms</h6>
                                    <p class="text-muted mb-0 small">View inventory & status</p>
                                </div>
                            </a>
                            <a href="/bookings" class="d-flex align-items-center mb-3 text-decoration-none">
                                <div class="icon-box bg-warning bg-opacity-10 text-warning me-3">
                                    <i class="bi bi-calendar-check"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold small">Review Bookings</h6>
                                    <p class="text-muted mb-0 small">Approve pending requests</p>
                                </div>
                            </a>
                            <a href="/food" class="d-flex align-items-center text-decoration-none">
                                <div class="icon-box bg-success bg-opacity-10 text-success me-3">
                                    <i class="bi bi-egg-fried"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold small">Restaurant Menu</h6>
                                    <p class="text-muted mb-0 small">Update food items</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const dateOptions = { year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('currentDate').textContent = 'Real-time operations for ' + new Date().toLocaleDateString('en-US', dateOptions);

        async function loadStats() {
            try {
                const res = await fetch('/api/dashboard/stats');
                const data = await res.json();

                document.getElementById('dailyRevenue').textContent = '₱' + parseFloat(data.dailyRevenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2});

                document.getElementById('activeGuests').textContent = data.activeGuests || 0;

                const tbody = document.getElementById('bookingsTable');
                if (data.recentCheckins && data.recentCheckins.length > 0) {
                    tbody.innerHTML = data.recentCheckins.map(booking => {
                        const initials = booking.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();

                        let statusClass, statusText;
                        if (booking.status === 'approved') {
                            statusClass = 'bg-success bg-opacity-10 text-success';
                            statusText = 'Approved';
                        } else if (booking.status === 'pending') {
                            statusClass = 'bg-warning bg-opacity-10 text-warning';
                            statusText = 'Pending';
                        } else {
                            statusClass = 'bg-secondary bg-opacity-10 text-secondary';
                            statusText = booking.status;
                        }

                        return `
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-3 p-2 fw-bold me-3 text-dark small">${initials}</div>
                                        <div>
                                            <div class="fw-bold small">${booking.name}</div>
                                            <div class="text-muted" style="font-size: 0.7rem;">${booking.roomType}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small">${booking.roomType}</td>
                                <td class="small">${booking.people} guest(s)</td>
                                <td><span class="status-tag ${statusClass}">${statusText}</span></td>
                                <td class="text-end pe-4"><i class="bi bi-three-dots text-muted"></i></td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No current bookings</td></tr>';
                }
            } catch (err) {
                console.error('Failed to load dashboard stats:', err);
                document.getElementById('dailyRevenue').textContent = 'Error';
                document.getElementById('activeGuests').textContent = 'Error';
            }
        }

        async function resetRevenue() {
            if (!confirm('Reset daily revenue to ₱0.00? This cannot be undone.')) return;

            try {
                const res = await fetch('/api/dashboard/reset-revenue', { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    alert('Daily revenue has been reset!');
                    loadStats();
                    document.getElementById('lastReset').textContent = 'Reset just now';
                } else {
                    alert('Failed to reset revenue');
                }
            } catch (err) {
                console.error('Reset error:', err);
                alert('Error resetting revenue');
            }
        }

        loadStats();
        setInterval(loadStats, 30000);

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }
    </script>
</body>
</html>